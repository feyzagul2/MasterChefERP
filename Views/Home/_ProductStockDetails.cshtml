@model List<MasterChefTakip.Models.PalletItem>
@using MasterChefTakip.ViewModels
@using System.Globalization

@{
    var culture = CultureInfo.GetCultureInfo("tr-TR");
    var total = new DashboardQuantity();

    foreach (var stock in Model)
    {
        total.Add(
            stock.BoxCount,
            stock.LooseUnitCount,
            stock.UnitsPerBox,
            stock.OpenBoxUnitCount);
    }
}

@if (Model.Count == 0)
{
    <div>Aktif paletlerde stok bulunmuyor.</div>
}
else
{
    @foreach (var pallet in Model.GroupBy(i => i.PalletId))
    {
        var definition = pallet.First().Pallet;
        var quantity = new DashboardQuantity();

        foreach (var stock in pallet)
        {
            quantity.Add(
                stock.BoxCount,
                stock.LooseUnitCount,
                stock.UnitsPerBox,
                stock.OpenBoxUnitCount);
        }

        <div class="pd-stock-pallet">
            <strong>
                @(string.IsNullOrWhiteSpace(definition.Location)
                    ? "Palet" : definition.Location)
            </strong>

            <span>@definition.Barcode</span>

            <span>
                @quantity.Boxes.ToString("N0", culture) kapalı koli ·
                Açık kolilerde @quantity.OpenUnits.ToString("N0", culture) adet ·
                @quantity.LooseUnits.ToString("N0", culture) tekli adet
            </span>

            <strong>Palet toplamı: @quantity.Display</strong>
        </div>
    }
}

<div class="pd-stock-total">
    Tüm aktif paletlerde toplam: @total.Display
</div>

@if (!total.IsComplete)
{
    <div style="margin-top:5px;">
        Kapasitesi bilinmeyen koliler adet toplamına eklenmedi.
    </div>
}