
@model List<MasterChefTakip.Models.PurchaseOrder>
@{
    ViewData["Title"] = "Sat&#305;n Alma Sipari&#351;leri";
}

<style>
.mc-purchase{max-width:1150px;margin:auto}
.mc-purchase-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin:16px 0}
.mc-purchase-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.mc-purchase-btn{display:inline-block;padding:9px 14px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;color:#17365b;text-decoration:none;cursor:pointer;font-size:13px}
.mc-purchase-primary{background:#17406a;border-color:#17406a;color:white}
.mc-purchase-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
.mc-purchase-field{display:flex;flex-direction:column;gap:5px;min-width:0}
.mc-purchase-field label{font-size:12px;font-weight:650}
.mc-purchase-field input,.mc-purchase-field select,.mc-purchase-field textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:7px;padding:9px;font-size:13px;background:#fff}
.mc-purchase-table-wrap{overflow-x:auto}
.mc-purchase-table{width:100%;min-width:780px;border-collapse:collapse}
.mc-purchase-table th{text-align:left;background:#f8fafc;padding:11px;font-size:12px}
.mc-purchase-table td{padding:9px;border-bottom:1px solid #edf2f7;font-size:13px}
.mc-purchase-table input{width:100%;min-width:75px;padding:8px;border:1px solid #cbd5e1;border-radius:6px;box-sizing:border-box}
.mc-purchase-errors{color:#b91c1c;font-size:13px;margin:12px 0}
@@media(max-width:700px){.mc-purchase-grid{grid-template-columns:1fr}.mc-purchase-card{padding:13px}}
.mc-purchase-flow-nav{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 18px}.mc-purchase-flow-nav a{display:inline-flex;align-items:center;padding:9px 12px;border:1px solid #d5e0ec;border-radius:8px;background:#fff;color:#18365f!important;text-decoration:none!important;font-size:13px;font-weight:700}.mc-purchase-flow-nav a:hover,.mc-purchase-flow-nav a:focus{background:#18365f;color:#fff!important;border-color:#18365f}/* MC_PURCHASE_FLOW_NAV_V1 */</style>

<div class="mc-purchase">
    <div class="mc-purchase-head">
        <div><h1>Sat&#305;n Alma Sipari&#351;leri</h1><div class="mc-purchase-flow-nav"><a href="/Purchasing">1. Satın Alma</a><a href="/PurchaseDispatch">2. Alış İrsaliyeleri</a><a href="/PurchaseGoodsReceipt">3. Mal Kabul</a><a href="/MCPurchaseInvoiceEntry">4. Fatura Girişi</a><a href="/MCPurchaseInvoiceStatus">5. Fatura Kontrolü</a><a href="/MCPurchaseInvoiceCariPosting">6. Cari Aktarım</a><a href="/MCPurchaseInvoiceCariCheck">7. Cari Kontrol</a><a href="/MCPurchaseCariAudit">8. Mutabakat</a></div></div>
        <a class="mc-purchase-btn mc-purchase-primary"
           asp-action="Create">+ Yeni Sat&#305;n Alma Sipari&#351;i</a>
    </div>
    <div class="mc-purchase-card mc-purchase-table-wrap">
        <table class="mc-purchase-table">
            <thead><tr>
                <th>Sipari&#351; No</th><th>Tedarik&#231;i</th>
                <th>Tarih</th><th>Durum</th><th>Para Birimi</th>
                <th>&#304;&#351;lem</th>
            </tr></thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.OrderNumber</td>
                    <td>@x.Supplier.CompanyName</td>
                    <td>@x.OrderDate.ToString("dd.MM.yyyy")</td>
                    <td>@(x.Status == "Draft" ? "Taslak" : x.Status)</td>
                    <td>@x.Currency</td>
                    <td><a class="mc-purchase-btn" asp-action="Details"
                           asp-route-id="@x.Id">G&#246;r&#252;nt&#252;le</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6">Hen&#252;z sat&#305;n alma sipari&#351;i yok.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
