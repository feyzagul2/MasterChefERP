
@model MasterChefTakip.Controllers.PurchaseOrderInput
@{
    ViewData["Title"] = "Yeni Sat&#305;n Alma Sipari&#351;i";
    var suppliers = (List<MasterChefTakip.Controllers.SupplierOption>)ViewBag.Suppliers;
}

<style>
.mc-purchase{max-width:1150px;margin:auto}
.mc-purchase-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin:16px 0}
.mc-purchase-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.mc-purchase-btn{display:inline-block;padding:9px 14px;border:1px solid #cbd5e1;border-radius:8px;background:#fff;color:#17365b;text-decoration:none;cursor:pointer;font-size:13px}
.mc-purchase-primary{background:#17406a;border-color:#17406a;color:white}
.mc-purchase-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
.mc-purchase-field{display:flex;flex-direction:column;gap:5px;min-width:0}
.mc-purchase-field label{font-size:12px;font-weight:650}
.mc-purchase-field input,.mc-purchase-field select,.mc-purchase-field textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:7px;padding:9px;font-size:13px;background:#fff}
.mc-purchase-table-wrap{overflow-x:auto}
.mc-purchase-table{width:100%;min-width:780px;border-collapse:collapse}
.mc-purchase-table th{text-align:left;background:#f8fafc;padding:11px;font-size:12px}
.mc-purchase-table td{padding:9px;border-bottom:1px solid #edf2f7;font-size:13px}
.mc-purchase-table input{width:100%;min-width:75px;padding:8px;border:1px solid #cbd5e1;border-radius:6px;box-sizing:border-box}
.mc-purchase-errors{color:#b91c1c;font-size:13px;margin:12px 0}
@@media(max-width:700px){.mc-purchase-grid{grid-template-columns:1fr}.mc-purchase-card{padding:13px}}
</style>

<div class="mc-purchase">
    <div class="mc-purchase-head">
        <h1>Yeni Sat&#305;n Alma Sipari&#351;i</h1>
        <a class="mc-purchase-btn" asp-action="Index">Listeye D&#246;n</a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="mc-purchase-errors"></div>

        <div class="mc-purchase-card">
            <h2 style="font-size:17px">Sipari&#351; Bilgileri</h2>

            <div class="mc-purchase-grid">
                <div class="mc-purchase-field">
                    <label asp-for="SupplierId">Tedarik&#231;i *</label>
                    <select asp-for="SupplierId" required>
                        <option value="0">Tedarik&#231;i Se&#231;iniz</option>
                        @foreach (var x in suppliers)
                        {
                            <option value="@x.Id">@x.Name</option>
                        }
                    </select>
                </div>

                <div class="mc-purchase-field">
                    <label asp-for="OrderDate">Sipari&#351; Tarihi</label>
                    <input asp-for="OrderDate" type="date" required />
                </div>

                <div class="mc-purchase-field">
                    <label asp-for="Currency">Para Birimi</label>
                    <select asp-for="Currency">
                        <option value="TRY">TRY</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="GBP">GBP</option>
                    </select>
                </div>

                <div class="mc-purchase-field">
                    <label asp-for="Notes">A&#231;&#305;klama</label>
                    <textarea asp-for="Notes" rows="2"></textarea>
                </div>
            </div>
        </div>

        <div class="mc-purchase-card">
            <h2 style="font-size:17px">Sipari&#351; Kalemleri</h2>
            <p style="font-size:12px;color:#64748b">
                Bo&#351; sat&#305;rlar kaydedilmez. Miktar ve fiyat ayn&#305; para birimindedir.
            </p>

            <div class="mc-purchase-table-wrap">
                <table class="mc-purchase-table">
                    <thead><tr>
                        <th>#</th><th>&#220;r&#252;n / Malzeme</th>
                        <th>Birim</th><th>Miktar</th>
                        <th>Birim Fiyat</th><th>KDV %</th>
                    </tr></thead>
                    <tbody>
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td><input asp-for="Lines[i].ProductDescription"
                                       maxlength="250" /></td>
                            <td><input asp-for="Lines[i].Unit"
                                       maxlength="20" /></td>
                            <td><input asp-for="Lines[i].Quantity"
                                       type="number" step="0.0001" min="0" /></td>
                            <td><input asp-for="Lines[i].UnitPrice"
                                       type="number" step="0.0001" min="0" /></td>
                            <td><input asp-for="Lines[i].VatRate"
                                       type="number" step="0.01" min="0" max="100" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <button type="submit"
                class="mc-purchase-btn mc-purchase-primary">
            Taslak Sipari&#351;i Kaydet
        </button>
    </form>
</div>


<!-- MC_PURCHASING_MATERIAL_PICKER_2026 -->
<script src="/js/mc-material-picker.js"
        asp-append-version="true"></script>
