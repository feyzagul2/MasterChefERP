
@model MasterChefTakip.Controllers.OperationsOverviewPage

@{
    ViewData["Title"] = "Operasyon Raporlari";
}

<!-- MC_OPERATIONS_OVERVIEW_2026 -->

<style>
.mc-ops{max-width:1400px;margin:auto;color:#17365b}
.mc-ops-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}
.mc-ops h1{font-size:26px;margin:0}
.mc-ops h2{font-size:17px;margin:0 0 16px}
.mc-ops-note{font-size:12px;color:#64748b}
.mc-ops-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.mc-ops-card{background:#fff;border:1px solid #dbe4ef;border-radius:12px;padding:18px;min-width:0}
.mc-ops-value{font-size:31px;font-weight:750;margin:8px 0}
.mc-ops-label{font-size:12px;color:#64748b}
.mc-ops-section{margin-top:18px}
.mc-ops-scroll{overflow-x:auto}
.mc-ops-table{width:100%;min-width:750px;border-collapse:collapse}
.mc-ops-table th{padding:12px;background:#f8fafc;text-align:left;font-size:12px;color:#475569}
.mc-ops-table td{padding:12px;border-bottom:1px solid #edf2f7;font-size:13px}
.mc-ops-btn{display:inline-block;padding:9px 14px;background:#17406a;color:#fff;border-radius:8px;text-decoration:none;font-size:13px}
.mc-ops-warning{color:#b45309;font-weight:650}
.mc-ops-danger{color:#b91c1c;font-weight:650}
.mc-ops-good{color:#166534;font-weight:650}
.mc-ops-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}
@@media(max-width:1000px){.mc-ops-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@@media(max-width:600px){.mc-ops-grid{grid-template-columns:1fr}.mc-ops-card{padding:14px}}
</style>

<div class="mc-ops">

    <div class="mc-ops-head">
        <div>
            <h1>MASTER CHEF | Operasyon Raporlar&#305;</h1>
            <div class="mc-ops-note">
                Stok, &#252;retim, kalite ve sevkiyat genel g&#246;r&#252;n&#252;m&#252;
            </div>
        </div>

        <a class="mc-ops-btn" asp-action="Index">
            Raporlar&#305; Yenile
        </a>
    </div>

    <div class="mc-ops-grid">

        <div class="mc-ops-card">
            <div class="mc-ops-label">&#220;r&#252;n Kartlar&#305;</div>
            <div class="mc-ops-value">@Model.ProductCount</div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Palet Say&#305;s&#305;</div>
            <div class="mc-ops-value">@Model.PalletCount</div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Palet &#220;r&#252;n Kay&#305;tlar&#305;</div>
            <div class="mc-ops-value">@Model.PalletItemCount</div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Sevkiyat Kay&#305;tlar&#305;</div>
            <div class="mc-ops-value">@Model.ShipmentCount</div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Hammadde Kartlar&#305;</div>
            <div class="mc-ops-value">@Model.RawMaterialCount</div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Kritik Hammaddeler</div>
            <div class="mc-ops-value @(Model.CriticalMaterialCount > 0 ? "mc-ops-danger" : "mc-ops-good")">
                @Model.CriticalMaterialCount
            </div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">&#220;retim Emirleri</div>
            <div class="mc-ops-value">@Model.ProductionOrderCount</div>
            <div class="mc-ops-note">
                Tamamlanan: @Model.CompletedProductionCount
            </div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Lot / SKT Kay&#305;tlar&#305;</div>
            <div class="mc-ops-value">@Model.LotCount</div>
            <div class="mc-ops-note">
                Onayl&#305;: @Model.ApprovedLotCount |
                Reddedilen: @Model.RejectedLotCount
            </div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Kalite Onay&#305; Bekleyen Lot</div>
            <div class="mc-ops-value">@Model.PendingLotCount</div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">SKT Ge&#231;mi&#351; Lot</div>
            <div class="mc-ops-value @(Model.ExpiredLotCount > 0 ? "mc-ops-danger" : "")">
                @Model.ExpiredLotCount
            </div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Hammadde Say&#305;mlar&#305;</div>
            <div class="mc-ops-value">@Model.StockCountTotal</div>
        </div>

        <div class="mc-ops-card">
            <div class="mc-ops-label">Say&#305;m Onay&#305; Bekleyen</div>
            <div class="mc-ops-value @(Model.PendingStockCounts > 0 ? "mc-ops-warning" : "")">
                @Model.PendingStockCounts
            </div>
            <div class="mc-ops-note">
                Onaylanan: @Model.ApprovedStockCounts |
                Reddedilen: @Model.RejectedStockCounts
            </div>
        </div>

    </div>

    <div class="mc-ops-card mc-ops-section mc-ops-scroll">
        <h2>Hammadde Stok Raporu</h2>

        <table class="mc-ops-table">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Hammadde</th>
                    <th>Mevcut</th>
                    <th>Minimum</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var x in Model.Materials)
            {
                <tr>
                    <td>@x.Code</td>
                    <td>@x.Name</td>
                    <td>@x.Quantity.ToString("N4") @x.Unit</td>
                    <td>@x.MinimumStock.ToString("N4") @x.Unit</td>
                    <td>
                        @if (!x.IsActive)
                        {
                            <span>Pasif</span>
                        }
                        else if (x.Quantity <= x.MinimumStock)
                        {
                            <span class="mc-ops-warning">Kritik</span>
                        }
                        else
                        {
                            <span class="mc-ops-good">Normal</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Materials.Any())
            {
                <tr>
                    <td colspan="5">
                        Hen&#252;z hammadde kart&#305; bulunmuyor.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="mc-ops-card mc-ops-section mc-ops-scroll">
        <h2>Son &#220;retim Emirleri</h2>

        <table class="mc-ops-table">
            <thead>
                <tr>
                    <th>Emir No</th>
                    <th>Re&#231;ete</th>
                    <th>Miktar</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var x in Model.ProductionOrders)
            {
                <tr>
                    <td>@x.OrderNumber</td>
                    <td>@x.Recipe.Name</td>
                    <td>@x.PlannedQuantityKg.ToString("N4") Kg</td>
                    <td>@(x.Status == "Completed" ? "Tamamland&#305;" : "Planland&#305;")</td>
                    <td>@x.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
            @if (!Model.ProductionOrders.Any())
            {
                <tr><td colspan="5">&#220;retim emri bulunmuyor.</td></tr>
            }
            </tbody>
        </table>
    </div>

    <div class="mc-ops-card mc-ops-section mc-ops-scroll">
        <h2>&#214;n&#252;m&#252;zdeki 90 G&#252;nde SKT'si Dolacak Lotlar</h2>

        <table class="mc-ops-table">
            <thead>
                <tr>
                    <th>Lot</th>
                    <th>&#220;r&#252;n</th>
                    <th>SKT</th>
                    <th>Kalite</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var x in Model.ExpiringLots)
            {
                <tr>
                    <td>@x.LotNumber</td>
                    <td>@x.Product.Name</td>
                    <td class="mc-ops-warning">
                        @x.ExpiryDate.ToString("dd.MM.yyyy")
                    </td>
                    <td>@x.Status</td>
                </tr>
            }
            @if (!Model.ExpiringLots.Any())
            {
                <tr>
                    <td colspan="4">
                        90 g&#252;n i&#231;inde SKT'si dolacak lot bulunmuyor.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="mc-ops-links">
        <a class="mc-ops-btn" asp-controller="RawMaterials" asp-action="Index">
            Hammadde
        </a>
        <a class="mc-ops-btn" asp-controller="Production" asp-action="Orders">
            &#220;retim
        </a>
        <a class="mc-ops-btn" asp-controller="LotQuality" asp-action="Index">
            Lot / Kalite
        </a>
        <a class="mc-ops-btn" asp-controller="RawStockCounts" asp-action="Index">
            Stok Say&#305;m&#305;
        </a>
        <a class="mc-ops-btn" asp-controller="Reports" asp-action="Index">
            Mevcut Raporlar
        </a>
    </div>

</div>


<!-- MC_COMPACT_METRICS_FINAL -->
<style>
.mc-metrics-compact-grid {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    gap: 10px !important;
    align-items: start !important;
    grid-auto-rows: min-content !important;
}

.mc-metrics-compact-card {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    min-height: 90px !important;
    height: auto !important;
    padding: 12px 14px !important;
    margin: 0 !important;
    border-radius: 10px !important;
}

.mc-metrics-compact-card h1,
.mc-metrics-compact-card h2,
.mc-metrics-compact-card h3 {
    margin: 6px 0 2px !important;
    line-height: 1.1 !important;
}

@@media (max-width: 1450px) {
    .mc-metrics-compact-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
}

@@media (max-width: 1100px) {
    .mc-metrics-compact-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
}

@@media (max-width: 700px) {
    .mc-metrics-compact-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}
</style>

<script>
(function () {
    "use strict";

    const labels = [
        "\u00dcr\u00fcn Kartlar\u0131",
        "Palet Say\u0131s\u0131",
        "Palet \u00dcr\u00fcn Kay\u0131tlar\u0131",
        "Sevkiyat Kay\u0131tlar\u0131",
        "Hammadde Kartlar\u0131",
        "Kritik Hammaddeler",
        "\u00dcretim Emirleri",
        "Lot / SKT Kay\u0131tlar\u0131",
        "Kalite Onay\u0131 Bekleyen Lot",
        "SKT Ge\u00e7mi\u015f Lot",
        "Hammadde Say\u0131mlar\u0131",
        "Say\u0131m Onay\u0131 Bekleyen"
    ];

    function normalize(value) {
        return (value || "")
            .replace(/\s+/g, " ")
            .trim()
            .toLocaleLowerCase("tr-TR");
    }

    const names = new Set(labels.map(normalize));

    function locateCard(element) {
        let node = element.parentElement;

        for (let i = 0; i < 7 && node; i++) {
            const style = getComputedStyle(node);
            const rect = node.getBoundingClientRect();

            const rounded =
                parseFloat(style.borderTopLeftRadius) >= 6;

            const bordered =
                parseFloat(style.borderTopWidth) > 0 &&
                style.borderTopStyle !== "none";

            if (
                rounded &&
                bordered &&
                rect.width > 130 &&
                rect.height > 55 &&
                rect.height < 350 &&
                /\d/.test(node.textContent)
            ) {
                return node;
            }

            node = node.parentElement;
        }

        return null;
    }

    function compact() {
        const found = new Set();

        const walker = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT
        );

        while (walker.nextNode()) {
            const textNode = walker.currentNode;

            if (!names.has(normalize(textNode.textContent))) {
                continue;
            }

            const card = locateCard(textNode.parentElement);

            if (card) {
                found.add(card);
            }
        }

        const groups = new Map();

        for (const card of found) {
            const parent = card.parentElement;

            if (!parent) continue;

            if (!groups.has(parent)) {
                groups.set(parent, []);
            }

            groups.get(parent).push(card);
        }

        let changed = 0;

        for (const [parent, cards] of groups) {
            if (cards.length < 4) continue;

            parent.classList.add("mc-metrics-compact-grid");

            for (const card of cards) {
                card.classList.add("mc-metrics-compact-card");
                changed++;
            }
        }

        console.log(
            "MASTER CHEF - Kucultulen rapor kartlari:",
            changed
        );
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", compact);
    } else {
        compact();
    }
})();
</script>
<!-- MC_COMPACT_METRICS_FINAL_END -->


