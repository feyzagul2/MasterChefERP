<script>
/* MC_PALLET_BARCODE_SCAN_V1 */
document.addEventListener("DOMContentLoaded", function () {

    const input = document.getElementById("pgPalletBarcode");
    const button = document.getElementById("pgFindPallet");
    const feedback = document.getElementById("pgPalletFeedback");
    const rows = document.getElementById("packagingRows");

    if (!input || !button || !feedback || !rows) return;

    function normalize(value) {
        return String(value || "").trim().toLocaleLowerCase("tr-TR");
    }

    function selectPallet() {
        const barcode = normalize(input.value);

        if (!barcode) {
            feedback.textContent = "Palet barkodunu girin.";
            input.focus();
            return;
        }

        const selects = Array.from(
            rows.querySelectorAll('[data-field="PalletId"]')
        );

        if (!selects.length) return;

        let selectedOption = null;

        for (const option of selects[0].options) {
            if (
                option.value &&
                normalize(option.dataset.barcode) === barcode
            ) {
                selectedOption = option;
                break;
            }
        }

        if (!selectedOption) {
            feedback.textContent = "Bu barkoda ait aktif palet bulunamadı.";
            return;
        }

        const activeRow = document.activeElement?.closest(".pg-row");

        const targetSelect =
            activeRow?.querySelector('[data-field="PalletId"]')
            || selects.find(s => !s.value)
            || selects[selects.length - 1];

        targetSelect.value = selectedOption.value;

        targetSelect.dispatchEvent(
            new Event("change", { bubbles: true })
        );

        feedback.textContent =
            "Palet seçildi: " + selectedOption.textContent.trim();

        input.value = "";

        const boxInput = targetSelect.closest(".pg-row")
            ?.querySelector('[data-field="BoxCount"]');

        if (boxInput) boxInput.focus();
    }

    button.addEventListener("click", selectPallet);

    input.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            event.preventDefault();
            selectPallet();
        }
    });

});
</script>
