@section Scripts {

<style>
    /* MC_PRODUCT_PICKER_V1 */

    .mc-picker-trigger {
        width: 100%;
        min-height: 42px;
        padding: 9px 12px;
        border: 1px solid #d7e0ec;
        border-radius: 7px;
        background: #fff;
        color: #18365f;
        text-align: left;
        font-size: 13px;
        cursor: pointer;
    }

    .mc-picker-trigger:hover {
