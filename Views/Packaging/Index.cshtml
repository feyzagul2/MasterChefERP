<!-- MC_ZXING_CAMERA_V2 -->
<script src="/lib/zxing/zxing.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const overlay = document.getElementById("mcCameraScanner");
    const video = document.getElementById("mcCameraVideo");
    const status = document.getElementById("mcCameraStatus");
    const title = document.getElementById("mcCameraTitle");
    const closeButton = document.getElementById("mcCameraClose");

    const productInput = document.getElementById("packagingSearch");
    const palletInput = document.getElementById("pgPalletBarcode");

    const productButton = document.getElementById("pgFindProduct");
    const palletButton = document.getElementById("pgFindPallet");

    if (!overlay || !video || !productInput || !palletInput) return;

    let reader = null;
    let active = false;
    let session = 0;

    // Eski kodun ekledigi kamera butonlarini temizle.
    document.querySelectorAll(".mc-camera-button").forEach(b => b.remove());

    function stopCamera() {
        active = false;
        session++;

        if (reader) {
            try { reader.reset(); } catch (e) {}
            reader = null;
        }

        if (video.srcObject) {
            video.srcObject.getTracks().forEach(track => track.stop());
            video.srcObject = null;
        }

        overlay.style.display = "none";
    }

    async function openCamera(type) {

        if (!window.ZXing) {
            alert("Barkod okuyucu kutuphanesi yuklenemedi.");
            return;
        }

        if (!navigator.mediaDevices?.getUserMedia) {
            alert("Kamera icin HTTPS baglantisi gerekiyor.");
            return;
        }

        stopCamera();

        const currentSession = session;
        active = true;

        overlay.style.display = "flex";

        title.textContent = type === "product"
            ? "Ürün barkodunu okut"
            : "Palet barkodunu okut";

        status.textContent = "Kamera açılıyor...";

        try {

            reader = new ZXing.BrowserMultiFormatReader();

            await reader.decodeFromVideoDevice(
                null,
                video,
                function(result, error) {

                    if (!active || currentSession !== session) return;

                    if (!result) return;

                    const barcode = result.getText();

                    stopCamera();

                    if (type === "product") {

                        productInput.value = barcode;

                        productInput.dispatchEvent(
                            new Event("input", { bubbles: true })
                        );

                        productButton.click();

                    } else {

                        palletInput.value = barcode;
                        palletButton.click();

                    }
                }
            );

            if (active && currentSession === session) {
                status.textContent = "Barkodu kameraya gösterin.";
            }

        } catch (error) {

            console.error("Kamera hatasi:", error);

            stopCamera();

            alert("Kamera açılamadı. Kamera iznini ve HTTPS bağlantısını kontrol edin.");
        }
    }

    function addButton(input, type) {

        const button = document.createElement("button");

        button.type = "button";
        button.className =
            "btn btn-outline-primary mc-camera-button";

        button.textContent = "📷 Kamera ile okut";

        button.style.margin = "8px 0";

        button.addEventListener("click", function() {
            openCamera(type);
        });

        input.closest(".pg-search-inline")?.appendChild(button);
    }

    addButton(productInput, "product");
    addButton(palletInput, "pallet");

    closeButton.addEventListener("click", stopCamera);

    overlay.addEventListener("click", function(event) {
        if (event.target === overlay) stopCamera();
    });

    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") stopCamera();
    });

    window.addEventListener("pagehide", stopCamera);

});
</script>

