<!-- MC_PALLET_QUICK_SAVE_V2 -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const overlay = document.getElementById("mcQuickPalletOverlay");
    const cancel = document.getElementById("mcQuickPalletCancel");
    const save = document.getElementById("mcQuickPalletSave");
    const locationInput = document.getElementById("mcQuickPalletLocation");
    const notesInput = document.getElementById("mcQuickPalletNotes");
    const message = document.getElementById("mcQuickPalletMessage");

    if (!overlay || !save) return;

    const createLink = Array.from(document.querySelectorAll("a"))
        .find(a => a.textContent.includes("Yeni Palet Oluştur"));

    if (!createLink) return;

    function closeModal() {
        overlay.style.display = "none";
    }

    createLink.addEventListener("click", function (event) {
        event.preventDefault();
        overlay.style.display = "flex";
        message.textContent = "";
        locationInput.focus();
    });

    cancel.addEventListener("click", closeModal);

    overlay.addEventListener("click", function (event) {
        if (event.target === overlay) closeModal();
    });

    save.addEventListener("click", async function () {
        if (save.disabled) return;

        save.disabled = true;
        message.style.color = "#475569";
        message.textContent = "Palet kaydediliyor...";

        try {
            const formData = new FormData();
            formData.append("location", locationInput.value.trim());
            formData.append("notes", notesInput.value.trim());

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            if (!token) {
                throw new Error("Güvenlik doğrulama anahtarı bulunamadı.");
            }

            formData.append(
                "__RequestVerificationToken",
                token.value
            );

            const response = await fetch(
                '@Url.Action("QuickCreate", "Pallets")',
                {
                    method: "POST",
                    body: formData,
                    credentials: "same-origin"
                }
            );

            if (!response.ok) {
                throw new Error(
                    "Palet kaydedilemedi. Yetkinizi kontrol edin."
                );
            }

            const result = await response.json();

            if (!result.success) {
                throw new Error(result.message || "Kayıt başarısız.");
            }

            const selects = document.querySelectorAll(
                'select[data-field="PalletId"]'
            );

            if (!selects.length) {
                throw new Error(
                    "Palet oluşturuldu ancak seçim alanı bulunamadı. Barkod: "
                    + result.barcode
                );
            }

            selects.forEach(function (select) {
                const option = document.createElement("option");

                option.value = result.id;
                option.dataset.barcode = result.barcode;
                option.textContent =
                    "Palet #" + result.id + " — " +
                    (result.location || "Konum belirtilmedi");

                select.appendChild(option);
            });

            // Yeni eklenen ürün satırlarında da palet görünsün.
            const firstSelect = selects[0];

            const observer = new MutationObserver(function () {
                document.querySelectorAll(
                    'select[data-field="PalletId"]'
                ).forEach(function (select) {
                    if (select.querySelector(
                        'option[value="' + result.id + '"]'
                    )) return;

                    const option = firstSelect.querySelector(
                        'option[value="' + result.id + '"]'
                    );

                    if (option) {
                        select.appendChild(option.cloneNode(true));
                    }
                });
            });

            observer.observe(
                document.getElementById("packagingRows"),
                { childList: true }
            );

            const target = Array.from(selects).find(function (select) {
                return !select.value;
            }) || selects[selects.length - 1];

            target.value = String(result.id);

            target.dispatchEvent(
                new Event("change", { bubbles: true })
            );

            // Ilk palet olusturuldugunda kayit islemlerini etkinlestir.
            const packagingForm = document.getElementById("packagingForm");
            const saveButton = document.getElementById("savePackaging");

            if (packagingForm && saveButton) {
                if (typeof window.mcPackagingPalletCreated === "function") {
                    window.mcPackagingPalletCreated();
                }

                const warning = document.querySelector(
                    ".packaging-page .alert-warning"
                );

                if (warning) warning.remove();
            }

            locationInput.value = "";
            notesInput.value = "";

            closeModal();

        } catch (error) {
            message.style.color = "#dc2626";
            message.textContent = error.message;
        } finally {
            save.disabled = false;
        }
    });
});
</script>

