@model MasterChefTakip.ViewModels.PackagingIndexViewModel

@{
    ViewData["Title"] = "Paketleme";
    var canSave = Model.Products.Count > 0 && Model.Pallets.Count > 0;

    string PgValue(string key, object? fallback)
    {
        if (ViewData.ModelState.TryGetValue(key, out var entry))
            return entry.AttemptedValue ?? "";

        return Convert.ToString(
            fallback,
            System.Globalization.CultureInfo.InvariantCulture) ?? "";
    }
}

<style>
    .packaging-page {
        width: 100%;
        min-width: 0;
        color: #18365f;
    }

    .packaging-page,
    .packaging-page * {
        box-sizing: border-box;
    }

    .pg-heading,
    .pg-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pg-heading {
        margin-bottom: 16px;
    }

    .packaging-page h1 {
        margin: 0 0 5px;
        font-size: 26px;
    }

    .pg-help {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .pg-surface {
        padding: 14px;
        border: 1px solid #d3ddeb;
        border-radius: 10px;
        background: white;
    }

    .packaging-page label {
        display: block;
        margin-bottom: 4px;
        font-size: 12px;
    }

    .packaging-page .form-control,
    .packaging-page .form-select {
        width: 100%;
        min-width: 0;
        min-height: 44px;
        font-size: 16px;
    }

    .packaging-page .btn {
        min-height: 44px;
        padding: 8px 12px;
        font-size: 13px;
        border-radius: 7px;
    }

    .packaging-page .btn-primary {
        background: #18365f;
        border-color: #18365f;
    }

    .pg-row {
        display: grid;
        grid-template-columns:
            minmax(0, 1.5fr) minmax(0, 1fr) 95px 110px auto;
        gap: 8px;
        align-items: start;
        padding: 12px 0;
        border-bottom: 1px solid #e5eaf1;
    }

    .pg-row > div {
        min-width: 0;
    }

    .pg-remove {
        margin-top: 22px;
    }

    .pg-row-total {
        grid-column: 1 / -1;
        margin: 0;
        font-size: 12px;
        color: #64748b;
    }

    .pg-row-total.invalid {
        color: #b42318;
    }

    .pg-preview {
        margin: 12px 0;
        padding: 10px 12px;
        background: #f7f9fc;
        border: 1px solid #dce4ef;
        border-radius: 7px;
        font-size: 13px;
    }

    .pg-preview ul {
        margin: 8px 0 0;
        padding-left: 20px;
    }

    .pg-preview li {
        margin: 4px 0;
        overflow-wrap: anywhere;
    }

    .pg-note {
        margin: 12px 0;
        font-size: 13px;
    }

    .pg-note textarea {
        margin-top: 8px;
        resize: vertical;
    }

    .pg-actions {
        margin-top: 12px;
    }

    .pg-footer {
        margin-top: 12px;
    }

    @@media (max-width: 900px) {
        .pg-row {
            grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
        }

        .pg-product,
        .pg-pallet {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 600px) {
        .pg-surface {
            padding: 10px;
        }

        .packaging-page h1 {
            font-size: 24px;
        }

        .pg-actions .btn {
            flex: 1 1 auto;
        }
    }
</style>

<div class="packaging-page">
    <header class="pg-heading">
        <div>
            <h1>Paketleme kaydet</h1>
            <p class="pg-help">
                Yeni hazırlanan ürünleri ve yerleştirdiğiniz paleti girin.
            </p>
        </div>

        
    </header>

    @if (TempData["PackagingSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    @if (!canSave)
    {
        <div class="alert alert-warning">
            Kayıt için aktif ürün ve aktif palet bulunmalıdır.
        </div>
    }

    <form asp-controller="Packaging"
          asp-action="Save"
          method="post"
          id="packagingForm"
          class="pg-surface">

        <input asp-for="Form.RequestId" type="hidden" />

        <div asp-validation-summary="All"
             class="text-danger"
             role="alert"></div>

        <label for="packagingSearch">Ürün ara / barkod numarası gir</label>
        <div class="pg-search-inline">
<input id="packagingSearch"
               class="form-control"
               type="search"
               autocomplete="off"
               placeholder="Ürün adı, kodu veya barkod numarası" />
<button type="button"
                    id="pgFindProduct"
                    class="btn btn-outline-secondary">
                Ürünü seç / okut
            </button>
</div>
<div class="pg-search-feedback"><span id="pgSearchFeedback"
                  class="pg-help"
                  role="status"></span></div>

                @* MC_PALLET_BARCODE_SCAN_V1 *@
        <div class="pg-pallet-scan" style="margin:12px 0 16px">
            <label for="pgPalletBarcode">Palet barkodu okut / gir</label>

            <div class="pg-search-inline">
                <input id="pgPalletBarcode"
                       type="search"
                       class="form-control"
                       autocomplete="off"
                       placeholder="Palet barkodunu okutun veya yazın" />

                <button type="button"
                        id="pgFindPallet"
                        class="btn btn-outline-secondary">
                    Paleti seç
                </button>
            </div>

            <small id="pgPalletFeedback"
                   class="pg-help"
                   role="status"></small>
        </div>
<div id="packagingRows">
            @for (var index = 0; index < Model.Form.Rows.Count; index++)
            {
                var row = Model.Form.Rows[index];

                <div class="pg-row">
                    <div class="pg-product">
                        <label>Ürün</label>
                        <select name="Form.Rows[@index].ProductId"
                                data-field="ProductId"
                                class="form-select"
                                required>
                            <option value="">Ürün seçin</option>

                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id"
                                        data-code="@product.Code"
                                        data-barcode="@product.Barcode"
                                        data-search="@($"{product.Name} {product.Code} {product.Barcode}")"
                                        selected="@(row.ProductId == product.Id)">
                                    @product.Name — @product.Code
                                </option>
                            }
                        </select>
                    </div>

                    <div class="pg-pallet">
                        <label>Yerleştirilen palet / konum</label>
                        <select name="Form.Rows[@index].PalletId"
                                data-field="PalletId" data-pallet-barcode-select
                                class="form-select"
                                required>
                            <option value="">Palet seçin</option>

                            @foreach (var pallet in Model.Pallets)
                            {
                                <option data-barcode="@pallet.Barcode" value="@pallet.Id"
                                        selected="@(row.PalletId == pallet.Id)">
                                    Palet #@pallet.Id —
                                    @(string.IsNullOrWhiteSpace(pallet.Location)
                                        ? "Konum belirtilmedi" : pallet.Location)
                                </option>
                            }
                        </select>
                    </div>

                    <div>
                        <label>Koli sayısı</label>
                        <input name="Form.Rows[@index].BoxCount"
                               data-field="BoxCount"
                               value="@(PgValue($"Form.Rows[{index}].BoxCount", row.BoxCount))"
                               class="form-control"
                               type="number"
                               inputmode="numeric"
                               min="1"
                               max="2147483647"
                               step="1"
                               required />
                    </div>

                    <div>
                        <label>Her kolide adet</label>
                        <input name="Form.Rows[@index].UnitsPerBox"
                               data-field="UnitsPerBox"
                               value="@(PgValue($"Form.Rows[{index}].UnitsPerBox", row.UnitsPerBox))"
                               class="form-control"
                               type="number"
                               inputmode="numeric"
                               min="1"
                               max="2147483647"
                               step="1"
                               required />
                    </div>

                    <button type="button"
                            class="btn btn-outline-danger pg-remove"
                            data-remove>
                        Sil
                    </button>

                    <p class="pg-row-total"
                       data-row-total
                       aria-live="polite"></p>
                </div>
            }
        </div>

        <div class="pg-actions">
            <button type="button"
                    id="addPackagingRow"
                    class="btn btn-outline-secondary">
                + Ürün ekle
            </button>
        </div>

        <details class="pg-note"
                 open="@(!string.IsNullOrWhiteSpace(Model.Form.Notes))">
            <summary>Not ekle (isteğe bağlı)</summary>
            <label asp-for="Form.Notes" style="margin-top:8px">
                İşlem notu
            </label>
            <textarea asp-for="Form.Notes"
                      class="form-control"
                      rows="2"
                      maxlength="500"></textarea>
        </details>

        <div id="packagingPreview"
             class="pg-preview"
             aria-live="polite"></div>

        <button type="submit"
                id="savePackaging"
                class="btn btn-primary"
                disabled="@(!canSave)">
            Kontrol et ve stoğa ekle
        </button>

        <p class="pg-help pg-footer">
            Aynı üründe koli içi adetler farklıysa ayrı satır girin.
            Yalnızca yeni hazırlanan ürünleri kaydedin.
        </p>
    </form>
</div>

