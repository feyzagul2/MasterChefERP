    }

    @@media (max-width: 767px) {
        .mc-picker-results {
            max-height: 55vh;
        }

        .mc-picker-option {
            padding: 13px;
        }
    }
</style>

<div class="modal fade"
     id="mcProductPickerModal"
     tabindex="-1"
     aria-labelledby="mcProductPickerTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h2 class="modal-title fs-5" id="mcProductPickerTitle">
                    Ürün Seçimi
                </h2>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Kapat"></button>
            </div>

            <div class="modal-body">

                <input type="search"
                       id="mcProductPickerSearch"
                       class="mc-picker-search"
                       placeholder="Ürün adı veya stok kodu ara..."
                       autocomplete="off"
                       aria-label="Ürün ara" />

                <div class="d-flex justify-content-between align-items-center my-3">
                    <span class="small text-secondary">
                        Ürün seçmek için satıra tıklayın.
                    </span>

                    <span id="mcProductPickerCount"
                          class="small text-secondary"></span>
                </div>

                <div id="mcProductPickerResults"
                     class="mc-picker-results"></div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Kapat
                </button>
            </div>

        </div>
    </div>
</div>

<script>
(() => {
    // MC_PRODUCT_PICKER_V1
    // Gercek ProductId select elemanlari korunur.
    // Sadece kullaniciya gosterilen secim arayuzu yenilenir.

    document.addEventListener("DOMContentLoaded", () => {

        const modalElement =
            document.getElementById("mcProductPickerModal");

        const search =
            document.getElementById("mcProductPickerSearch");

        const results =
            document.getElementById("mcProductPickerResults");

        const count =
            document.getElementById("mcProductPickerCount");

        if (!modalElement ||
            !search ||
            !results ||
            !window.bootstrap) {
            return;
        }

        const modal =
            bootstrap.Modal.getOrCreateInstance(modalElement);

        let activeSelect = null;
        let allProducts = [];

        const normalize = value =>
            String(value || "")
                .toLocaleLowerCase("tr-TR")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/ı/g, "i");

        function collectProducts() {
            const map = new Map();

            document
                .querySelectorAll('.pg-row select[data-field="ProductId"]')
                .forEach(select => {

                    [...select.options].forEach(option => {

                        if (!option.value) return;

                        if (!map.has(option.value)) {
                            map.set(option.value, {
                                id: option.value,
                                name: option.textContent.trim()
                            });
                        }
                    });
                });

            for (const product of map.values()) {
                if (!allProducts.some(p => p.id === product.id)) {
                    allProducts.push(product);
                }
            }

            allProducts.sort((a, b) =>
                a.name.localeCompare(b.name, "tr-TR"));
        }

        function selectedText(select) {
            const id = select.value;

            if (!id) return "Ürün seçin";

            const found = allProducts.find(p => p.id === id);

            return found
                ? found.name
                : select.selectedOptions[0]?.textContent.trim()
                    || "Ürün seçin";
        }

        function syncButtons() {
            document.querySelectorAll(".mc-picker-trigger")
                .forEach(button => {

                    const row = button.closest(".pg-row");
                    const select =
                        row?.querySelector(
                            'select[data-field="ProductId"]'
                        );

                    if (select) {
                        button.textContent = selectedText(select);
                    }
                });
        }

        function enhanceRows() {
            collectProducts();

            document
                .querySelectorAll('.pg-row select[data-field="ProductId"]')
                .forEach(select => {

                    if (select.dataset.mcPickerEnhanced === "1")
                        return;

                    select.dataset.mcPickerEnhanced = "1";

                    const button = document.createElement("button");

                    button.type = "button";
                    button.className = "mc-picker-trigger";
                    button.textContent = selectedText(select);
                    button.setAttribute(
                        "aria-label",
                        "Ürün seçme penceresini aç"
                    );

                    select.insertAdjacentElement("afterend", button);

                    // Mevcut select, form ve JavaScript icin DOM'da kalir.
                    select.hidden = true;

                    button.addEventListener("click", () => {
                        activeSelect = select;

                        collectProducts();

                        search.value = "";
                        render();

                        modal.show();
                    });

                    select.addEventListener("change", syncButtons);
                });

            syncButtons();
        }

        function render() {
            const query = normalize(search.value.trim());

            const found = allProducts.filter(product =>
                normalize(product.name).includes(query));

            count.textContent =
                `${found.length} / ${allProducts.length} ürün`;

            results.replaceChildren();

            if (!found.length) {
                const empty = document.createElement("div");

                empty.className = "mc-picker-empty";
                empty.textContent = "Aradığınız ürün bulunamadı.";

                results.appendChild(empty);
                return;
            }

            const fragment = document.createDocumentFragment();

            found.forEach(product => {

                const button = document.createElement("button");

                button.type = "button";
                button.className = "mc-picker-option";

                const title = document.createElement("span");
                title.textContent = product.name;

                button.appendChild(title);

                button.addEventListener("click", () => {
                    if (!activeSelect) return;

                    const oldValue = activeSelect.value;

                    // Mevcut arama filtresi secilen urunu select
                    // listesinden cikarmissa tekrar eklenir.
                    if (![...activeSelect.options].some(
                        option => option.value === product.id
                    )) {
                        activeSelect.add(
                            new Option(product.name, product.id)
                        );
                    }

                    activeSelect.value = product.id;

                    activeSelect.dataset.previous = oldValue;

                    activeSelect.dispatchEvent(
                        new Event("change", { bubbles: true })
                    );

                    syncButtons();

                    modal.hide();
                });

                fragment.appendChild(button);
            });

            results.appendChild(fragment);
        }

        search.addEventListener("input", render);

        modalElement.addEventListener("shown.bs.modal", () => {
            search.focus();
        });

        // Paketleme ekraninda yeni urun satiri eklenirse
        // ayni secim butonu otomatik hazirlanir.
        const firstRow = document.querySelector(".pg-row");

        if (firstRow?.parentElement) {
            const observer = new MutationObserver(mutations => {
                if (mutations.some(mutation =>
                    [...mutation.addedNodes].some(node =>
                        node.nodeType === 1 &&
                        (node.matches?.(".pg-row") ||
                         node.querySelector?.(".pg-row"))
                    ))) {
                    enhanceRows();
                }
            });

            observer.observe(firstRow.parentElement, {
                childList: true
            });
        }

        enhanceRows();
    });
})();
</script>
<script>
(() => {
    const form = document.getElementById("packagingForm");
    const rows = document.getElementById("packagingRows");
    const add = document.getElementById("addPackagingRow");
    const save = document.getElementById("savePackaging");
    const search = document.getElementById("packagingSearch");
    const find = document.getElementById("pgFindProduct");
    const feedback = document.getElementById("pgSearchFeedback");
    const preview = document.getElementById("packagingPreview");
    const dialog = document.getElementById("pgReview");
    const confirmButton = document.getElementById("pgReviewConfirm");
    const reviewList = document.getElementById("pgReviewList");
    const reviewTotal = document.getElementById("pgReviewTotal");
    const reviewNote = document.getElementById("pgReviewNote");
    const first = rows?.firstElementChild;

    if (!form || !first || !find || !dialog) return;

    const template = first.cloneNode(true);
    const options = [...first.querySelector(
        '[data-field="ProductId"]').options]
        .map(option => option.cloneNode(true));

    // MC_PALLET_ENABLE_SAVE_V3
    // MC_PACKAGING_PALLET_FIX_V4
    let unavailable = save.disabled;

    window.mcPackagingPalletCreated = function () {
        unavailable = false;
        save.disabled = false;

        // Yeni satirlarin palet listesi guncel kalsin.
        const source = rows.querySelector(
            '[data-field="PalletId"]'
        );

        if (source) {
            const templateSelect = template.querySelector(
                '[data-field="PalletId"]'
            );

            if (templateSelect) {
                templateSelect.replaceChildren(
                    ...Array.from(source.options).map(
                        option => option.cloneNode(true)
                    )
                );
            }
        }

        update();
    };
    let active = first;
    let submitting = false;
    let approved = false;
    let valid = false;
    let lines = [];
    let totalText = "";

    const normalize = value => String(value ?? "").trim()
        .toLocaleLowerCase("tr-TR").normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "").replace(/ı/g, "i");

    const integer = value => {
        const text = String(value ?? "").trim();
        const n = Number(text);
        return text && Number.isInteger(n)
            && n > 0 && n <= 2147483647 ? n : null;
    };

    const format = value => value.toLocaleString("tr-TR");
    const field = (row, name) =>
        row.querySelector(`[data-field="${name}"]`);

    function matches() {
        const words = normalize(search.value)
            .split(/\s+/).filter(Boolean);

        return options.filter(o => o.value && words.every(word =>
            normalize(o.dataset.search ?? o.textContent)
                .includes(word)));
    }

    function filter() {
        const found = matches();
        const ids = new Set(found.map(o => o.value));

        rows.querySelectorAll('[data-field="ProductId"]')
            .forEach(select => {
                const selected = select.value;

                select.replaceChildren(...options.filter(o =>
                    !o.value || o.value === selected || ids.has(o.value))
                    .map(o => o.cloneNode(true)));

                select.value = selected;
            });

        feedback.textContent = search.value.trim()
            ? found.length
                ? `${found.length} ürün bulundu. Ürünü seçebilir veya listeden bakabilirsiniz.`
                : "Ürün bulunamadı. Ürün kodunu veya barkodu kontrol edin."
            : "Barkod okuyucu için bu kutuya tıklayıp okutun. Miktarları siz gireceksiniz.";
    }

    function update() {
        const current = [...rows.querySelectorAll(".pg-row")];
        valid = current.length > 0 && current.length <= 100;
        let boxesTotal = 0n;
        let unitsTotal = 0n;
        lines = [];

        current.forEach((row, index) => {
            row.querySelectorAll("[data-field]").forEach(input => {
                input.name =
                    `Form.Rows[${index}].${input.dataset.field}`;
                input.id =
                    `packaging-${index}-${input.dataset.field}`;
                input.setCustomValidity("");

                const label =
                    input.parentElement.querySelector("label");
                if (label) label.htmlFor = input.id;
            });

            const remove = row.querySelector("[data-remove]");
            remove.disabled = current.length <= 1 || submitting;
            remove.setAttribute("aria-label",
                `${index + 1}. ürün satırını kaldır`);

            const product = field(row, "ProductId");
            const pallet = field(row, "PalletId");
            const boxInput = field(row, "BoxCount");
            const capacityInput = field(row, "UnitsPerBox");

            if (product.dataset.previous === undefined)
                product.dataset.previous = product.value;

            const boxes = integer(boxInput.value);
            const capacity = integer(capacityInput.value);
            const message = row.querySelector("[data-row-total]");
            const errors = [];

            function error(input, text) {
                input.setCustomValidity(text);
                errors.push(text);
                valid = false;
            }

            if (!product.value)
                error(product, "Ürünü seçin.");
            if (!pallet.value)
                error(pallet, "Yerleştirilen paleti seçin.");
            if (boxes === null)
                error(boxInput, "Koli sayısı en az 1 olmalı.");
            if (capacity === null)
                error(capacityInput,
                    "Bu üründen her kolide kaç adet olduğunu girin.");

            /* MC_PACKAGING_VALIDATION_V1 */
            const showErrors = form.dataset.validationShown === "true";

            message.classList.toggle(
                "invalid",
                showErrors && errors.length > 0
            );

            if (errors.length) {
                message.textContent = showErrors
                    ? `${index + 1}. satır: ${errors.join(" ")}`
                    : "";
                return;
            }

            const units = BigInt(boxes) * BigInt(capacity);
            boxesTotal += BigInt(boxes);
            unitsTotal += units;

            lines.push(
                `${product.selectedOptions[0].textContent.trim()}: `
                + `${format(boxes)} koli × ${format(capacity)} adet`
                + ` = ${format(units)} ürün`
                + ` · ${pallet.selectedOptions[0].textContent.trim()}`
            );

            message.textContent =
                `${format(boxes)} koli × ${format(capacity)} adet`
                + ` = ${format(units)} ürün`;
        });

        if (unitsTotal > 9223372036854775807n) {
            valid = false;
            const input = field(current.at(-1), "BoxCount");
            input.setCustomValidity(
                "Toplam miktar sistem sınırını aşıyor.");
            current.at(-1).querySelector("[data-row-total]")
                .textContent = "Toplam miktar sistem sınırını aşıyor.";
        }

        totalText =
            `${format(boxesTotal)} koli · ${format(unitsTotal)} adet ürün`;

        preview.replaceChildren();
        const title = document.createElement("strong");
        title.textContent = valid
            ? `Stoğa eklenecek: ${totalText}`
            : "Kaydetmeden önce eksik alanları tamamlayın.";
        preview.append(title);

        if (lines.length) {
            const details = document.createElement("details");
            const summary = document.createElement("summary");
            summary.textContent =
                `${lines.length} tamamlanmış satırı göster`;

            const list = document.createElement("ul");

            lines.forEach(text => {
                const li = document.createElement("li");
                li.textContent = text;
                list.append(li);
            });

            details.append(summary, list);
            preview.append(details);
        }

        add.disabled =
            unavailable || current.length >= 100 || submitting;
        find.disabled = unavailable || submitting;
    }

    function addRow(focus = true) {
        if (submitting || unavailable || rows.children.length >= 100)
            return null;

        const previousPallet =
            field(rows.lastElementChild, "PalletId").value;

        const row = template.cloneNode(true);
        row.querySelectorAll("input, select").forEach(input => {
            input.value = "";
            input.setCustomValidity("");
        });

        field(row, "PalletId").value = previousPallet;
        rows.append(row);
        active = row;
        search.value = "";
        filter();
        update();

        if (focus) field(row, "ProductId").focus();
        return row;
    }

    function chooseProduct() {
        if (submitting || unavailable) return;

        const word = normalize(search.value);

        if (!word) {
            feedback.textContent =
                "Ürün adı, kodu veya barkodu girin.";
            search.focus();
            return;
        }

        const exact = options.filter(o => o.value && (
            normalize(o.dataset.code) === word
            || normalize(o.dataset.barcode) === word));

        const found = exact.length ? exact : matches();

        if (found.length !== 1) {
            filter();

            if (found.length > 1) {
                feedback.textContent =
                    "Birden fazla ürün bulundu. Doğru ürünü listeden seçin.";
                field(active, "ProductId").focus();
            }
            return;
        }

        const option = found[0];
        let row = active;
        const selected = field(row, "ProductId").value;

        if (selected && selected !== option.value) {
            row = [...rows.children].find(r =>
                !field(r, "ProductId").value)
                ?? addRow(false);
        }

        if (!row) {
            feedback.textContent =
                "En fazla 100 ürün satırı eklenebilir.";
            return;
        }

        active = row;
        search.value = "";
        filter();

        field(row, "ProductId").value = option.value;
        field(row, "ProductId").dataset.previous = option.value;
        update();

        feedback.textContent =
            `${option.textContent.trim()} seçildi. Gerçek miktarları girin.`;

        const destination = field(row, "PalletId");
        (destination.value
            ? field(row, "BoxCount")
            : destination).focus();
    }

    add.addEventListener("click", () => addRow());
    find.addEventListener("click", chooseProduct);
    search.addEventListener("input", filter);

    search.addEventListener("keydown", event => {
        if (event.key === "Enter") {
            event.preventDefault();
            chooseProduct();
        }
    });

    rows.addEventListener("focusin", event => {
        active = event.target.closest(".pg-row") ?? active;
    });

    rows.addEventListener("input", update);

    rows.addEventListener("change", event => {
        const product =
            event.target.closest('[data-field="ProductId"]');

        if (product && product.dataset.previous
            && product.dataset.previous !== product.value) {
            field(product.closest(".pg-row"), "UnitsPerBox").value = "";
        }

        if (product) product.dataset.previous = product.value;
        update();
    });

    rows.addEventListener("click", event => {
        const button = event.target.closest("[data-remove]");

        if (!button || submitting || rows.children.length <= 1)
            return;

        const row = button.closest(".pg-row");

        if ((field(row, "ProductId").value
            || field(row, "BoxCount").value)
            && !window.confirm("Bu ürün satırı formdan kaldırılsın mı?"))
            return;

        row.remove();
        active = rows.lastElementChild;
        update();
    });

    form.noValidate = true;

    form.addEventListener("submit", event => {
        if (submitting || unavailable) {
            event.preventDefault();
            return;
        }

        form.dataset.validationShown = "true";

        update();

        if (!form.reportValidity() || !valid) {
            event.preventDefault();
            approved = false;
            return;
        }

        if (!approved) {
            event.preventDefault();
            reviewTotal.textContent = totalText;
            reviewList.replaceChildren();

            lines.forEach(text => {
                const li = document.createElement("li");
                li.textContent = text;
                reviewList.append(li);
            });

            const note = document.getElementById("Form_Notes")
                ?.value.trim();
            reviewNote.textContent = note ? `Not: ${note}` : "";

            if (typeof dialog.showModal === "function") {
                dialog.showModal();
            }
            else if (window.confirm(
                `${lines.join("\n")}\n\n${totalText} stoğa eklensin mi?`
            )) {
                approved = true;
                form.requestSubmit();
            }
            return;
        }

        submitting = true;
        save.disabled = true;
        save.textContent = "Kaydediliyor...";
        confirmButton.disabled = true;
        confirmButton.textContent = "Kaydediliyor...";
        add.disabled = true;
        find.disabled = true;

        rows.querySelectorAll("[data-remove]").forEach(button => {
            button.disabled = true;
        });
    });

    dialog.querySelectorAll("[data-review-close]").forEach(button => {
        button.addEventListener("click", () => {
            approved = false;
            dialog.close();
            save.focus();
        });
    });

    confirmButton.addEventListener("click", () => {
        if (submitting) return;
        approved = true;
        form.requestSubmit();

        if (!submitting) {
            approved = false;
            dialog.close();
        }
    });

    dialog.addEventListener("cancel", () => { approved = false; });

    window.addEventListener("pageshow", event => {
        if (event.persisted) window.location.reload();
    });

    filter();
    update();
})();
</script>
}

