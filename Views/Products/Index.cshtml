@section Scripts {
    <script>
        // PRODUCT_PRICE_MODAL_V1
        document.addEventListener("click", function (event) {
            const button = event.target.closest("[data-price-details-open]");
            if (!button) return;

            const cell = button.closest("tr");
            const template = cell?.querySelector("[data-price-details-template]");

            if (!template) return;

            const title = document.getElementById("productPriceModalTitle");
            const code = document.getElementById("productPriceModalCode");
            const body = document.getElementById("productPriceModalBody");

            title.textContent = button.dataset.productName || "Ürün içeriği";
            code.textContent = button.dataset.productCode || "";

            body.replaceChildren(template.content.cloneNode(true));
            if (button.dataset.openEdit === "true") {
                body.querySelector("[data-bundle-editor]")?.setAttribute("open", "");
            }

            const modal = bootstrap.Modal.getOrCreateInstance(
                document.getElementById("productPriceModal")
            );

            modal.show();
        });
    </script>
    <script>
    (() => {
