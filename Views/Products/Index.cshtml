            </div>
            <span class="muted-label">BARKOD</span>
        </div>
        <div class="scanner-body">
            <label class="visually-hidden" for="barcodeLookup">Aranacak barkod</label>
            <div class="scanner-controls">
                <input id="barcodeLookup" type="text"
                       class="form-control" maxlength="128"
                       autocomplete="off"
                       placeholder="Barkodu yazın veya okuyucuyla okutun" />
                <button id="barcodeFind" class="btn btn-primary"
                        type="button">Ürünü bul</button>
                <button id="barcodeCamera" class="btn btn-outline-secondary"
                        type="button">Kamerayla okut</button>
                <button id="barcodePhoto" class="btn btn-outline-secondary"
                        type="button">Fotoğraftan oku</button>
            </div>
            <input id="barcodeFile" type="file" accept="image/*" hidden />
            <p class="scanner-help">
                Harici okuyucu için barkod kutusuna tıklayın ve okutun.
                Kamerada barkodun tamamını net şekilde gösterin.
            </p>
            <div id="scanResult" class="scan-result" role="status" hidden>
                <span id="scanMessage"></span>
                <a id="scanLink" hidden></a>
            </div>
        </div>
    </section>

    @if (showEditor)
    {
        <details class="surface management-form" open="@Model.ShowForm">
            <summary>@(editing ? "Ürün bilgilerini düzenle" : "Yeni ürün bilgileri")</summary>

            <form asp-controller="Products"
                  asp-action="@(editing ? "Edit" : "Create")"
