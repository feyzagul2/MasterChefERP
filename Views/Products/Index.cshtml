                        <div class="fw-semibold">@bundle.SalesName</div>
                    </div>

                    <div>
                        <div class="text-secondary small">Satış kodu</div>
                        <div>@bundle.SalesCode</div>
                    </div>

                    <div>
                        <div class="text-secondary small">Durum</div>
