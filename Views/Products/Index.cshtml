<div class="products-page">


    <div class="overview-heading">
        <div>
            <span class="eyebrow">ÜRÜN YÖNETİMİ</span>
            <h1>Ürünler</h1>
            <p>Ürün bilgileri, barkodlar ve belirlediğiniz fiyatlar.</p>
        </div>
        @if (Model.CanCreate)
        {
            <a class="btn btn-primary"
               asp-controller="Products" asp-action="Index"
               asp-route-form="new">+ Yeni ürün</a>
        }
    </div>

    @if (TempData["ProductSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["ProductError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="surface" aria-labelledby="barcode-heading">
        <div class="surface-heading">
            <div>
                <h2 id="barcode-heading">Barkod ile ürün bul</h2>
