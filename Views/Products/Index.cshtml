                        </div>
                    </div>

                    <div>
                        <div class="text-secondary small">KDV hariç fiyat</div>
                        <div>
                            @(bundle.SalesPriceVatExcluded is decimal exc
                                ? exc.ToString("N2", culture) + " " + (bundle.Currency ?? "TL")
                                : "Belirtilmedi")
                        </div>
                    </div>

