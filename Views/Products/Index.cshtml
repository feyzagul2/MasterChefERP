                    </div>

                    <div>
                        <div class="text-secondary small">KDV dahil fiyat</div>
                        <div class="fw-bold">
                            @(bundle.SalesPriceVatIncluded is decimal inc
                                ? inc.ToString("N2", culture) + " " + (bundle.Currency ?? "TL")
