                <input asp-for="Form.Id" type="hidden" />
                <input asp-for="Form.ConcurrencyStamp" type="hidden" />
                <div asp-validation-summary="ModelOnly"
                     class="text-danger" role="alert"></div>

                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label asp-for="Form.Barcode" class="form-label">Ürün barkodu</label>
                        <input asp-for="Form.Barcode" class="form-control"
                               type="text" maxlength="128" autocomplete="off" />
                        <span asp-validation-for="Form.Barcode" class="text-danger"></span>
                        <p class="form-text">Ürünün üzerindeki barkodu girin veya okuyucuyla okutun.</p>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Form.Code" class="form-label"></label>
                        <input asp-for="Form.Code" class="form-control" maxlength="50" />
                        <span asp-validation-for="Form.Code" class="text-danger"></span>
                        <p class="form-text">Yeni kayıtta boş bırakırsanız kod otomatik oluşturulur.</p>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Form.Name" class="form-label"></label>
                        <input asp-for="Form.Name" class="form-control" required maxlength="200" />
                        <span asp-validation-for="Form.Name" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
