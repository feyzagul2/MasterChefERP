                            MasterChefTakip.Models.AppPermissions.ProductsPrices))
                        {
                            productSalesPriceLookup = SalesPriceDb.ProductSalesOptions
                                .AsNoTracking()
                                .ToList()
                                .GroupBy(option => option.ProductId)
                                .ToDictionary(
                                    group => group.Key,
                                    group => group
                                        .OrderBy(option => option.UnitsPerSale)
                                        .ThenBy(option => option.SalesCode)
                                        .ToList()
                                );
                        }
