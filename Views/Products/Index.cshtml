                    {
                        <details data-bundle-editor
                                 class="border rounded p-3">
                            <summary class="fw-semibold"
                                     style="cursor:pointer">
                                Paket bilgilerini düzenle
                            </summary>

                            <form asp-controller="BundlePrices"
                                  asp-action="Update"
                                  method="post"
                                  class="mt-3">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@bundle.Id" />

                                <div class="mb-3">
                                    <label class="form-label">
                                        Paket adı
                                    </label>
                                    <input name="salesName"
                                           value="@bundle.SalesName"
                                           maxlength="200"
                                           required
                                           class="form-control" />
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">
                                            KDV dahil fiyat (TL)
                                        </label>
                                        <input name="price"
                                               type="number"
                                               min="0"
                                               max="999999999"
                                               step="0.01"
                                               required
                                               class="form-control"
                                               value="@(bundle.SalesPriceVatIncluded?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">
                                            KDV oranı (%)
                                        </label>
                                        <input name="vatRate"
                                               type="number"
                                               min="0"
                                               max="100"
                                               step="0.01"
                                               required
                                               class="form-control"
                                               value="@(bundle.VatRatePercent?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "0")" />
                                    </div>
                                </div>

                                <div class="small text-secondary mt-3">
                                    KDV hariç fiyat otomatik hesaplanır.
                                    Satış kodu değiştirilemez.
                                </div>

                                <button type="submit"
                                        class="btn btn-primary mt-3">
                                    Değişiklikleri Kaydet
                                </button>
                            </form>
                        </details>
                    }
<div class="alert alert-light border mb-0 small">
                        Bu satış paketinin fiziksel ürün dağılımı
                        henüz doğrulanmadığından otomatik stok düşümü
                        yapılmaz.
                    </div>
                </div>
            </template>
        }
        else
        {
            <span class="small text-secondary">Satış paketi</span>
        }
    </div>
</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

