                            <option value="Cam şişe"></option>
                            <option value="Kova"></option>
                            <option value="Kavanoz"></option>
                            <option value="Torba"></option>
                            <option value="Stick"></option>
                            <option value="Doypack"></option>
                            <option value="Tüp"></option>
                            <option value="Teneke"></option>
                        </datalist>
                        <span asp-validation-for="Form.PackagingType" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Form.DefaultUnitsPerBox" class="form-label"></label>
                        <input asp-for="Form.DefaultUnitsPerBox" class="form-control"
                               type="number" min="1" step="1" />
                        <span asp-validation-for="Form.DefaultUnitsPerBox" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Form.DefaultUnitNetWeightGrams" class="form-label"></label>
                        <input asp-for="Form.DefaultUnitNetWeightGrams"
                               class="form-control" inputmode="decimal" maxlength="30" />
                        <span asp-validation-for="Form.DefaultUnitNetWeightGrams" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <fieldset class="price-basis-group">
                            <legend class="form-label">Hangi fiyatı gireceksiniz?</legend>
                            <div class="price-basis-options">
                                <label class="price-basis-option">
                                    <input asp-for="Form.PriceBasis" type="radio"
                                           value="Unit" id="price-unit" required />
                                    <span>Adet fiyatı</span>
                                </label>
                                <label class="price-basis-option">
                                    <input asp-for="Form.PriceBasis" type="radio"
                                           value="Box" id="price-box" required />
                                    <span>Koli fiyatı</span>
                                </label>
                            </div>
                        </fieldset>
                        <span asp-validation-for="Form.PriceBasis" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Form.UnitPrice" class="form-label"
                               id="product-price-label">Fiyat (TL)</label>
                        <input asp-for="Form.UnitPrice" class="form-control"
                               inputmode="decimal" maxlength="30" />
                        <span asp-validation-for="Form.UnitPrice" class="text-danger"></span>
                        <p id="product-price-hint" class="form-text">
                            Seçtiğiniz türe ait fiyatı girin.
                        </p>
                    </div>
                </div>

                <p class="products-note">
                    Adet ve koli fiyatları birbirinden hesaplanmaz.
                    Ondalık değerlerde virgül veya nokta kullanabilirsiniz;
                    binlik ayırıcı kullanmayın.
                    Koli içi adet ve gramaj, stok miktarını göstermez.
                </p>

                <div class="form-actions">
                    <a class="btn btn-outline-secondary"
                       asp-controller="Products" asp-action="Index">Vazgeç</a>
                    <button class="btn btn-primary" type="submit">
                        @(editing ? "Değişiklikleri kaydet" : "Ürünü kaydet")
                    </button>
                </div>
            </form>
        </details>
    }

    <section class="surface" aria-labelledby="products-heading">
