c": "T\u00fcm \u00dcr\u00fcnler", "MC-CIGKOFTE-PAKET-4999": "T\u00fcm \u00dcr\u00fcnler", "stk-030303(Kopya-79F)": "T\u00fcm \u00dcr\u00fcnler", "UFQQ3AKPWW": "T\u00fcm \u00dcr\u00fcnler", "NKQY1NVMEB": "T\u00fcm \u00dcr\u00fcnler", "N32L5AY5UR": "T\u00fcm \u00dcr\u00fcnler", "GVRE4QJX9X": "T\u00fcm \u00dcr\u00fcnler", "N2F7V6EWW5": "T\u00fcm \u00dcr\u00fcnler", "M9VVW5H57E": "T\u00fcm \u00dcr\u00fcnler", "5MHU4NTTDW": "T\u00fcm \u00dcr\u00fcnler", "LN7Q987TTM": "T\u00fcm \u00dcr\u00fcnler", "5QCN3TUAS4": "T\u00fcm \u00dcr\u00fcnler", "6WZTWC3BXY": "T\u00fcm \u00dcr\u00fcnler", "UF2LT2ATWR": "T\u00fcm \u00dcr\u00fcnler", "T43PK9YFS4": "T\u00fcm \u00dcr\u00fcnler", "7VTV82CNZE": "T\u00fcm \u00dcr\u00fcnler", "UGRR3LG8J5": "T\u00fcm \u00dcr\u00fcnler", "1XCXS544QR": "T\u00fcm \u00dcr\u00fcnler", "UGF1D9WGX8": "T\u00fcm \u00dcr\u00fcnler"};

        if (!search || !status) return;

        const rows = [...document.querySelectorAll("[data-product-row]")];
        rows.forEach(row => {
            row.dataset.productCategory =
                excelCategoriesByCode[row.dataset.salesCode] || "";
        });

        const categories = [...new Set(
            Object.values(excelCategoriesByCode).filter(Boolean)
        )].sort((a, b) => a.localeCompare(b, "tr-TR"));

        categories.forEach(name => {
            category.add(new Option(name, name));
        });

        category.addEventListener("change", filter);
        const count = document.getElementById("product-list-count");
        const empty = document.getElementById("product-list-empty");

        const normalize = value => String(value ?? "")
            .toLocaleLowerCase("tr-TR")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/ı/g, "i");

        function filter() {
            const words = normalize(search.value)
                .trim().split(/\s+/).filter(Boolean);

            let visible = 0;

            rows.forEach(row => {
                const text = normalize(row.dataset.productSearch);

                row.hidden =
                    !words.every(word => text.includes(word))
                    || (status.value !== ""
                        && row.dataset.productStatus !== status.value)
                    || (category.value !== ""
                        && row.dataset.productCategory !== category.value);

                if (!row.hidden) visible++;
            });

            count.textContent = `${visible} / ${rows.length} ürün`;
            empty.hidden = visible !== 0;
        }

        search.addEventListener("input", filter);
        status.addEventListener("change", filter);

        search.addEventListener("keydown", event => {
            if (event.key === "Enter") event.preventDefault();
        });

        filter();
    })();
    </script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/zxing-browser.min.js" asp-append-version="true"></script>
    <script>
        (() => {
            const lookup = document.getElementById('barcodeLookup');
            const findButton = document.getElementById('barcodeFind');
            const cameraButton = document.getElementById('barcodeCamera');
            const photoButton = document.getElementById('barcodePhoto');
            const fileInput = document.getElementById('barcodeFile');
            const resultBox = document.getElementById('scanResult');
            const message = document.getElementById('scanMessage');
            const link = document.getElementById('scanLink');

            const modalElement = document.getElementById('barcodeModal');
            const video = document.getElementById('barcodeVideo');
            const cameraMessage = document.getElementById('cameraMessage');
            const modal = new bootstrap.Modal(modalElement);

            const findUrl = '@Url.Action("FindByBarcode", "Products")';
            const indexUrl = '@Url.Action("Index", "Products")';
            const canCreate = @Model.CanCreate.ToString().ToLowerInvariant();

            let busy = false;
            let controls = null;
            let generation = 0;

            function showMessage(text) {
                resultBox.hidden = false;
                message.textContent = text;
                link.hidden = true;
                link.removeAttribute('href');
            }

            function reader() {
                if (!window.ZXingBrowser) {
                    throw new Error('Barkod kütüphanesi yüklenemedi. Kurulum komutunu kontrol edin.');
                }
                return new ZXingBrowser.BrowserMultiFormatReader();
            }

            function stopCamera() {
                generation++;
                controls?.stop();
                controls = null;
                const stream = video.srcObject;
                if (stream && typeof stream.getTracks === 'function') {
                    stream.getTracks().forEach(track => track.stop());
                }
                video.srcObject = null;
            }

            async function findProduct() {
                if (busy) return;

                const barcode = lookup.value.trim();
                if (!barcode || barcode.length > 128) {
                    showMessage('Geçerli bir barkod girin.');
                    return;
                }

                busy = true;
                findButton.disabled = true;
                showMessage('Ürün aranıyor…');

                try {
                    const url = new URL(findUrl, window.location.origin);
                    url.searchParams.set('barcode', barcode);

                    const response = await fetch(url, {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });

                    if (!(response.headers.get('content-type') || '').includes('application/json')) {
                        throw new Error('Oturumunuzu kontrol edip yeniden giriş yapın.');
                    }

                    const data = await response.json();

                    if (!response.ok)
                        throw new Error(data.message || 'Barkod sorgulanamadı.');

                    if (data.found) {
                        showMessage(data.name + (data.active ? ' bulundu.' : ' bulundu; ürün pasif.'));
                        link.textContent = 'Ürünü göster';
                        link.href = data.url;
                        link.hidden = false;
                    } else if (canCreate) {
                        showMessage('Bu barkod sistemde kayıtlı değil.');
                        const newUrl = new URL(indexUrl, window.location.origin);
                        newUrl.searchParams.set('form', 'new');
                        newUrl.searchParams.set('barcode', barcode);
                        link.textContent = 'Yeni ürün olarak ekle';
                        link.href = newUrl.href;
                        link.hidden = false;
                    } else {
                        showMessage('Bu barkod sistemde kayıtlı değil. Yeni ürün oluşturma yetkiniz yok.');
                    }
                } catch (error) {
                    showMessage(error.message || 'İşlem tamamlanamadı.');
                } finally {
                    busy = false;
                    findButton.disabled = false;
                }
            }

            findButton.addEventListener('click', findProduct);
            lookup.addEventListener('keydown', event => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    findProduct();
                }
            });

            // Formdaki okuyucunun Enter tuşu formu erken göndermesin.
            document.getElementById('Form_Barcode')?.addEventListener('keydown', event => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    document.getElementById('Form_Name')?.focus();
                }
            });

            cameraButton.addEventListener('click', () => {
                if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia) {
                    showMessage('Kamera için HTTPS üzerinden açılan bir adres kullanın.');
                    return;
                }
                if (!window.ZXingBrowser) {
                    showMessage('Barkod kütüphanesi yüklenemedi. Kurulum komutunu kontrol edin.');
                    return;
                }
                modal.show();
            });

            modalElement.addEventListener('shown.bs.modal', async () => {
                stopCamera();
                const session = generation;
                cameraMessage.textContent = 'Kamera hazırlanıyor…';
                let accepted = false;

                try {
                    const scanner = reader();
                    const started = await scanner.decodeFromConstraints(
                        {
                            audio: false,
                            video: { facingMode: { ideal: 'environment' } }
                        },
                        video,
                        (result, error, scanControls) => {
                            if (!result || accepted || session !== generation) return;
                            accepted = true;
                            lookup.value = result.getText();
                            scanControls.stop();
                            modal.hide();
                            findProduct();
                        }
                    );

                    if (session !== generation || accepted) {
                        started.stop();
                        return;
                    }

                    controls = started;
                    cameraMessage.textContent = 'Barkodun tamamını çerçeve içinde net gösterin.';
                } catch (error) {
                    if (session !== generation) return;
                    stopCamera();
                    cameraMessage.textContent =
                        error.name === 'NotAllowedError'
                            ? 'Kamera izni verilmedi. Tarayıcıdan kamera iznini açın.'
                            : 'Kamera açılamadı. Başka bir uygulamanın kamerayı kullanmadığını kontrol edin.';
                }
            });

            modalElement.addEventListener('hide.bs.modal', stopCamera);
            window.addEventListener('pagehide', stopCamera);
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    stopCamera();
                    modal.hide();
                }
            });

            photoButton.addEventListener('click', () => {
                stopCamera();
                fileInput.click();
            });

            fileInput.addEventListener('change', async () => {
                const file = fileInput.files?.[0];
                if (!file) return;

                if (!file.type.startsWith('image/') || file.size > 10 * 1024 * 1024) {
                    showMessage('En fazla 10 MB büyüklüğünde bir barkod fotoğrafı seçin.');
                    fileInput.value = '';
                    return;
                }

                photoButton.disabled = true;
                showMessage('Fotoğraftaki barkod okunuyor…');
                const source = URL.createObjectURL(file);

                try {
                    const scanner = reader();
                    const result = await scanner.decodeFromImageUrl(source);
                    lookup.value = result.getText();
                    await findProduct();
                } catch (error) {
                    showMessage(
                        !window.ZXingBrowser
                            ? 'Barkod kütüphanesi yüklenemedi.'
                            : 'Barkod okunamadı. Net, yakın ve barkodun tamamını gösteren bir fotoğraf seçin.'
                    );
                } finally {
                    URL.revokeObjectURL(source);
                    photoButton.disabled = false;
                    fileInput.value = '';
                }
            });

            function updatePriceLabel() {
                const selected = document.querySelector('input[name="Form.PriceBasis"]:checked');
                const label = document.getElementById('product-price-label');
                const hint = document.getElementById('product-price-hint');
                if (!label || !hint) return;

                label.textContent = !selected
                    ? 'Fiyat (TL)'
                    : selected.value === 'Box' ? 'Koli fiyatı (TL)' : 'Adet fiyatı (TL)';

                hint.textContent = !selected
                    ? 'Adet fiyatı veya koli fiyatını seçin.'
                    : selected.value === 'Box'
                        ? 'Bir koli için belirlediğiniz fiyatı girin.'
                        : 'Bir adet için belirlediğiniz fiyatı girin.';
            }

            document.querySelectorAll('input[name="Form.PriceBasis"]').forEach(input => {
                input.addEventListener('change', updatePriceLabel);
            });
            updatePriceLabel();

            document.querySelectorAll('form[data-product-delete]').forEach(form => {
                form.addEventListener('submit', event => {
                    if (!window.confirm('“' + form.dataset.productName + '” ürününü silmek istiyor musunuz?')) {
                        event.preventDefault();
                    }
                });
            });
        })();
    </script>
