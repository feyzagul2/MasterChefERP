@{
    // BUNDLES_MAIN_LIST_FIXED_V2
    var listedSalesOptions = SalesPriceDb.ProductSalesOptions
    .AsNoTracking()
    .OrderBy(x => x.SalesName)
    .ThenBy(x => x.SalesCode)
    .ToList();
var listedBundles = SalesPriceDb.SalesBundles
        .AsNoTracking()
        .OrderBy(bundle => bundle.SalesName)
        .ToList();

    var canSeeListedBundlePrices =
        MasterChefTakip.Services.OperationAuthorization.Can(
            User,
            MasterChefTakip.Models.AppPermissions.ProductsPrices);
