<style>
.mc-ops-attention {
    background: #fffbeb;
    border: 1px solid #f5d48c;
    border-left: 4px solid #d99b27;
    border-radius: 12px;
    padding: 18px 22px;
    margin-bottom: 22px;
}
.mc-ops-attention h2 {
    margin: 0 0 12px;
    color: #854d0e;
    font-size: 18px;
    font-weight: 700;
}
.mc-ops-attention ul {
    margin: 0;
    padding-left: 20px;
    color: #713f12;
    line-height: 1.8;
    font-size: 13px;
}
</style>
@{
    ViewData["Title"] = "Operasyon Ozeti";

    var metrics =
        ViewData["Metrics"] as
        List<MasterChefTakip.Controllers.MCOperationsSummaryController.Metric>
        ?? new List<MasterChefTakip.Controllers.MCOperationsSummaryController.Metric>();

    var error = ViewData["Error"] as string;
    var updated = ViewData["UpdatedAt"] as string;
}

<style>
    .mc-ops-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 24px;
        color: #172b4d;
    }

    .mc-ops-heading {
        margin-bottom: 25px;
    }

    .mc-ops-heading h1 {
        font-size: 28px;
        font-weight: 750;
        margin: 0 0 8px;
    }

    .mc-ops-heading p {
        font-size: 14px;
        color: #64748b;
        margin: 0;
    }

    .mc-ops-grid {
        display: grid;
        grid-template-columns:
            repeat(auto-fit, minmax(235px, 1fr));
        gap: 16px;
    }

    .mc-ops-card {
        padding: 20px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow:
            0 3px 15px rgba(15,23,42,.045);
    }

    .mc-ops-card-title {
        font-size: 13px;
        font-weight: 650;
        color: #475569;
        margin-bottom: 13px;
    }

    .mc-ops-card-number {
        font-size: 34px;
        line-height: 1.2;
        font-weight: 800;
        color: #172b4d;
        margin-bottom: 10px;
        font-variant-numeric: tabular-nums;
    }

    .mc-ops-card-number.empty {
        color: #94a3b8;
    }

    .mc-ops-card-caption {
        font-size: 12px;
        line-height: 1.5;
        color: #64748b;
    }

    .mc-ops-warning {
        background: #fffbeb;
        border: 1px solid #fcd34d;
        color: #92400e;
        border-radius: 10px;
        padding: 13px 15px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .mc-ops-notice {
        margin-top: 25px;
        padding: 16px;
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 11px;
        font-size: 13px;
        line-height: 1.6;
    }

    .mc-ops-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .mc-ops-links a {
        display: inline-block;
        background: #17335b;
        color: white;
        padding: 10px 15px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
    }

    .mc-ops-links a:hover {
        background: #275080;
        color: white;
    }
</style>

<section class="mc-ops-page">

    <header class="mc-ops-heading">
        <h1>MASTER CHEF | Operasyon Ozeti</h1>

        <p>
            Gercek sistem kayitlarina dayali yonetim bilgileri.
            @if (!string.IsNullOrWhiteSpace(updated))
            {
                <span>Son kontrol: @updated</span>
            }
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="mc-ops-warning">
            @error
        </div>
    }

    @{
    long? stockMovements = metrics
        .FirstOrDefault(x => x.Table == "StockMovements")?.Count;

    long? externalLines = metrics
        .FirstOrDefault(x => x.Table == "MCExternalSyncLines")?.Count;

    long? financeMovements = metrics
        .FirstOrDefault(x => x.Table == "MCBankCashMovements")?.Count;

    long? cariMovements = metrics
        .FirstOrDefault(x => x.Table == "MCCariMovements")?.Count;

    var notices = new List<string>();

    if (!stockMovements.HasValue)
        notices.Add("Stok hareketleri tablosu bulunamadı; kaynak tablo kontrol edilmeli.");
    else if (stockMovements.Value == 0)
        notices.Add("Henüz kayıtlı stok hareketi yok. Gerçek stok işlemi testi bekliyor.");

    if (!externalLines.HasValue)
        notices.Add("Harici sipariş satırları tablosu bulunamadı.");
    else if (externalLines.Value == 0)
        notices.Add("Harici sipariş satırı yok. Gerçek sipariş aktarımı henüz doğrulanmadı.");

    if (!financeMovements.HasValue || !cariMovements.HasValue)
        notices.Add("Banka/kasa veya cari hareket tablosu bulunamadı.");
    else if (financeMovements.Value == 0 && cariMovements.Value == 0)
        notices.Add("Banka/kasa ve cari hareketler boş. Gerçek finans işlemleri henüz uçtan uca test edilmedi.");
}

@if (notices.Count > 0)
{
    <section class="mc-ops-attention" aria-label="Dikkat gerektiren durumlar">
        <h2>Kontrol Bekleyen İşlemler</h2>
        <ul>
            @foreach (var notice in notices)
            {
                <li>@notice</li>
            }
        </ul>
    </section>
}
@* MC_PHASE7_OPERATION_PANEL *@

@{
    var operationalTableNames = new[]
    {
        "ProductionRecipes",
        "ProductionRecipeLines",
        "RawMaterialWarehouses",
        "RawMaterialStockMovements",
        "MCRawStockLedger",
        "RawMaterialReceiptTransfers",
        "Pallets",
        "StockMovements",
        "RawStockCounts",
        "MCExternalSyncImports",
        "MCExternalSyncLines",
        "MCBankCashMovements",
        "MCCariMovements"
    };

    var operationalMetrics = metrics
        .Where(x => operationalTableNames.Contains(x.Table))
        .ToList();

    var operationalEmpty = operationalMetrics
        .Where(x => x.Count.HasValue && x.Count.Value == 0)
        .ToList();

    var operationalMissing = operationalMetrics
        .Where(x => !x.Count.HasValue)
        .ToList();

    var operationalWithRecords = operationalMetrics
        .Where(x => x.Count.HasValue && x.Count.Value > 0)
        .ToList();

    var operationalRecords = operationalWithRecords
        .Sum(x => x.Count ?? 0);
}

<section class="mc-phase7-panel">

    <div class="mc-phase7-heading">
        <div>
            <h2>Üretim, Depo ve Sevkiyat</h2>
            <p>
                Güncel operasyon kayıtları ve kontrol bekleyen alanlar
            </p>
        </div>
        <span class="mc-phase7-badge">
            Canlı veritabanı özeti
        </span>
    </div>

    <div class="mc-phase7-stats">

        <article class="mc-phase7-stat">
            <span>İzlenen alan</span>
            <strong>@operationalMetrics.Count</strong>
        </article>

        <article class="mc-phase7-stat">
            <span>Kayıt bulunan alan</span>
            <strong>@operationalWithRecords.Count</strong>
        </article>

        <article class="mc-phase7-stat">
            <span>Boş alan</span>
            <strong>@operationalEmpty.Count</strong>
        </article>

        <article class="mc-phase7-stat">
            <span>Tablosu bulunamayan</span>
            <strong>@operationalMissing.Count</strong>
        </article>

    </div>

    <div class="mc-phase7-columns">

        <div class="mc-phase7-box">
            <h3>Mevcut Operasyon Kayıtları</h3>

            @if (operationalWithRecords.Count > 0)
            {
                <div class="mc-phase7-records">

                    @foreach (var item in operationalWithRecords)
                    {
                        <div class="mc-phase7-record">
                            <span>@item.Title</span>
                            <strong>@item.Count.GetValueOrDefault().ToString("N0")</strong>
                        </div>
                    }

                </div>
            }
            else
            {
                <p class="mc-phase7-muted">
                    İzlenen operasyon alanlarında henüz kayıt bulunmadı.
                </p>
            }
        </div>

        <div class="mc-phase7-box">
            <h3>Kontrol Bekleyen Alanlar</h3>

            @if (operationalEmpty.Count == 0 &&
                 operationalMissing.Count == 0)
            {
                <p class="mc-phase7-muted">
                    İzlenen tablolarda kayıt mevcut.
                    İşlem doğruluğu ayrıca kontrol edilmelidir.
                </p>
            }
            else
            {
                <div class="mc-phase7-checks">

                    @foreach (var item in operationalEmpty)
                    {
                        <div class="mc-phase7-check">
                            <span class="mc-phase7-dot"></span>
                            <span>
                                <strong>@item.Title</strong>
                                <small>
                                    Kayıt yok. Gerçek işlem testi bekliyor.
                                </small>
                            </span>
                        </div>
                    }

                    @foreach (var item in operationalMissing)
                    {
                        <div class="mc-phase7-check">
                            <span class="mc-phase7-dot"></span>
                            <span>
                                <strong>@item.Title</strong>
                                <small>
                                    Kaynak tablo bulunamadı:
                                    @item.Table
                                </small>
                            </span>
                        </div>
                    }

                </div>
            }
        </div>

    </div>

    <div class="mc-phase7-actions">

        <a href="/MCExternalOrders/stockReview">
            Sipariş / Stok
        </a>

        <a href="/MCExternalOrders/productionTrace">
            Üretim İzleme
        </a>

        <a href="/MCExternalOrders/shipmentTrace">
            Sevkiyat İzleme
        </a>

        <a href="/MCExternalOrders/dispatchQueue">
            Sevkiyat Kuyruğu
        </a>

    </div>

    <div class="mc-phase7-footnote">
        Bu ekrandaki değerler kayıt sayısıdır.
        Fiziksel stok bakiyesi, üretim tonajı veya
        sevk edilmiş ürün miktarı değildir.
        Kayıt bulunması tek başına işlem testinin
        tamamlandığını göstermez.
    </div>

</section>

<style>
.mc-phase7-panel {
    margin: 22px 0 28px;
    padding: 22px;
    border: 1px solid #dce5ef;
    border-radius: 15px;
    background: #f8fafc;
}

.mc-phase7-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 18px;
}

.mc-phase7-heading h2 {
    margin: 0 0 5px;
    font-size: 21px;
    font-weight: 750;
    color: #17335b;
}

.mc-phase7-heading p {
    margin: 0;
    font-size: 13px;
    color: #64748b;
}

.mc-phase7-badge {
    padding: 7px 11px;
    border-radius: 20px;
    background: #e8f1fb;
    color: #245686;
    font-size: 11px;
    font-weight: 650;
    white-space: nowrap;
}

.mc-phase7-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 18px;
}

.mc-phase7-stat {
    padding: 17px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
}

.mc-phase7-stat span {
    display: block;
    color: #64748b;
    font-size: 12px;
    margin-bottom: 7px;
}

.mc-phase7-stat strong {
    font-size: 29px;
    color: #17335b;
    font-weight: 800;
}

.mc-phase7-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.mc-phase7-box {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
    padding: 18px;
    min-width: 0;
}

.mc-phase7-box h3 {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 700;
    color: #17335b;
}

.mc-phase7-record {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #eef2f7;
    font-size: 13px;
    color: #475569;
}

.mc-phase7-record strong {
    font-size: 15px;
    color: #17335b;
}

.mc-phase7-check {
    display: flex;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid #f1f5f9;
}

.mc-phase7-check strong {
    display: block;
    font-size: 12px;
    color: #334155;
}

.mc-phase7-check small {
    display: block;
    margin-top: 3px;
    font-size: 11px;
    color: #9a6700;
}

.mc-phase7-dot {
    width: 8px;
    height: 8px;
    min-width: 8px;
    border-radius: 50%;
    background: #e3a036;
    margin-top: 5px;
}

.mc-phase7-muted {
    color: #64748b;
    font-size: 13px;
}

.mc-phase7-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 17px;
}

.mc-phase7-actions a {
    display: inline-flex;
    align-items: center;
    padding: 10px 14px;
    background: #17335b;
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-size: 12px;
}

.mc-phase7-actions a:hover {
    background: #285181;
    color: white;
}

.mc-phase7-footnote {
    margin-top: 15px;
    font-size: 11px;
    line-height: 1.6;
    color: #64748b;
}

/* Razor icinde responsive CSS icin @@media kullanilir. */
@@media (max-width: 900px) {
    .mc-phase7-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mc-phase7-columns {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 550px) {
    .mc-phase7-panel {
        padding: 15px;
    }

    .mc-phase7-stats {
        grid-template-columns: 1fr 1fr;
    }

    .mc-phase7-heading {
        flex-direction: column;
        align-items: flex-start;
    }

    .mc-phase7-badge {
        white-space: normal;
    }
}
</style>

@* MC_PHASE7_INTEGRITY_PANEL *@
@{
    var flowChecks =
        ViewData["FlowIntegrity"] as
        List<MasterChefTakip.Controllers.MCOperationsSummaryController.FlowIntegrityResult>
        ?? new List<MasterChefTakip.Controllers.MCOperationsSummaryController.FlowIntegrityResult>();
}

<section class="mc-flow-integrity">
    <h2>Operasyon Bağlantı Kontrolleri</h2>

    <p>
        Gerçek üretim, hammadde ve finans kayıtları
        arasındaki bağlantıların kontrolü.
    </p>

    <div class="mc-flow-integrity-grid">
        @foreach (var check in flowChecks)
        {
            <article class="mc-flow-integrity-card">
                <h3>@check.Title</h3>

                <div class="mc-flow-integrity-details">
                    <span>
                        İncelenen kayıt:
                        <strong>
                            @(check.Records.HasValue
                                ? check.Records.Value.ToString("N0")
                                : "—")
                        </strong>
                    </span>

                    <span>
                        Sorunlu bağlantı:
                        <strong>
                            @(check.Problems.HasValue
                                ? check.Problems.Value.ToString("N0")
                                : "Test edilmedi")
                        </strong>
                    </span>
                </div>

                <div class="mc-flow-integrity-status">
                    @check.Status
                </div>
            </article>
        }
    </div>

    <p class="mc-flow-integrity-note">
        Bu kontroller kayıt bağlantılarını inceler.
        Üretim miktarı, fiziksel stok, fatura tutarı
        veya finans işlemlerinin tamamının doğru
        olduğunu tek başına kanıtlamaz.
    </p>
</section>

<style>
.mc-flow-integrity {
    margin: 24px 0;
    padding: 22px;
    border: 1px solid #dbe4ee;
    border-radius: 14px;
    background: #f8fafc;
}

.mc-flow-integrity h2 {
    margin: 0 0 7px;
    font-size: 21px;
    font-weight: 750;
    color: #17335b;
}

.mc-flow-integrity > p {
    font-size: 13px;
    color: #64748b;
}

.mc-flow-integrity-grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 18px;
}

.mc-flow-integrity-card {
    padding: 18px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
}

.mc-flow-integrity-card h3 {
    font-size: 14px;
    font-weight: 700;
    color: #17335b;
    margin: 0 0 15px;
}

.mc-flow-integrity-details {
    display: flex;
    flex-direction: column;
    gap: 9px;
    color: #475569;
    font-size: 12px;
}

.mc-flow-integrity-details strong {
    color: #17335b;
}

.mc-flow-integrity-status {
    margin-top: 16px;
    padding: 9px 11px;
    background: #eef4fa;
    color: #285181;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 650;
}

.mc-flow-integrity-note {
    margin-top: 16px;
    line-height: 1.6;
    font-size: 12px;
}
</style>

<div class="mc-ops-grid">
        @foreach (var item in metrics)
        {
            <article class="mc-ops-card">

                <div class="mc-ops-card-title">
                    @item.Title
                </div>

                @if (item.Count.HasValue)
                {
                    <div class="mc-ops-card-number">
                        @item.Count.GetValueOrDefault().ToString("N0")
                    </div>
                }
                else
                {
                    <div class="mc-ops-card-number empty">
                        —
                    </div>
                }

                <div class="mc-ops-card-caption">
                    @if (item.Count.HasValue)
                    {
                        @item.Description
                    }
                    else
                    {
                        <span>Tablo bulunamadi: @item.Table</span>
                    }
                </div>

            </article>
        }
    </div>

    <div class="mc-ops-notice">
        <strong>Veri dogrulama:</strong>
        Buradaki sayilar mevcut veritabani
        tablolarindan okunur. Kayit bulunmamasi,
        ilgili islemin test edildigi anlamina gelmez.
        Excel'deki e-ticaret stok rakamlari
        fabrika stok miktari olarak kullanilmaz.
    </div>

    <nav class="mc-ops-links" aria-label="Operasyon baglantilari">
        <a href="/MCExternalOrders/dispatchQueue">
            Sevkiyat Kuyruğu
        </a>
        <a href="/MCExternalOrders/stockReview">
            Sipariş Stok Kontrolü
        </a>
        <a href="/MCExternalOrders/productionTrace">
            Uretim Takibi
        </a>
    </nav>

</section>