@{
    ViewData["Title"] = "Hammadde Y\u00f6netimi";
}

<!-- MC_RAW_CLEAN_LAYOUT_2026 -->

<style>
#mc-raw-clean,
#mc-raw-clean * {
    box-sizing: border-box;
}

#mc-raw-clean {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0 auto;
    font-family: "Segoe UI", Arial, sans-serif;
    color: #183b60;
}

#mc-raw-clean h1 {
    font-size: 27px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
}

#mc-raw-clean .mc-subtitle {
    margin: 0 0 18px;
    font-size: 14px;
    color: #64748b;
}

#mc-raw-clean .mc-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px;
    margin-bottom: 14px;
    background: #edf2f8;
    border: 1px solid #dbe3ec;
    border-radius: 12px;
}

#mc-raw-clean .mc-tabs button {
    min-height: 46px;
    padding: 11px 18px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: #24486d;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
}

#mc-raw-clean .mc-tabs button.active {
    background: #183f69;
    color: white;
}

#mc-raw-clean .mc-tabs button:focus-visible {
    outline: 3px solid #60a5fa;
    outline-offset: 2px;
}

#mc-raw-clean .mc-panel {
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    background: white;
    border: 1px solid #dbe3ec;
    border-radius: 12px;
    overflow: hidden;
}

#mc-raw-clean .mc-loading {
    padding: 18px;
    text-align: center;
    color: #64748b;
}

#mc-raw-clean [hidden] {
    display: none !important;
}

#mc-raw-clean iframe {
    display: block;
    width: 100%;
    height: 820px;
    min-width: 0;
    max-width: 100%;
    border: 0;
    margin: 0;
    padding: 0;
    background: white;
}

@@media (max-width: 768px) {
    #mc-raw-clean h1 {
        font-size: 23px;
    }

    #mc-raw-clean .mc-tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 7px;
    }

    #mc-raw-clean .mc-tabs button {
        width: 100%;
        min-width: 0;
        font-size: 12px;
        padding: 12px 7px;
        overflow-wrap: anywhere;
    }

    #mc-raw-clean iframe {
        height: 700px;
    }
}

@@media (max-width: 380px) {
    #mc-raw-clean .mc-tabs {
        grid-template-columns: 1fr;
    }
}
</style>


<section id="mc-raw-clean">

    <h1>Hammadde Y&#246;netimi</h1>

    <p class="mc-subtitle">
        &#304;&#351;lem yapmak istedi&#287;iniz b&#246;l&#252;m&#252; se&#231;in.
    </p>

    <nav class="mc-tabs" aria-label="Hammadde Y&#246;netimi">

        <button type="button" class="active"
                aria-pressed="true"
                data-page="/MaterialCatalog">
            Malzeme Katalo&#287;u
        </button>

        <button type="button"
                aria-pressed="false"
                data-page="/RawMaterials">
            Hammadde Stok Kartlar&#305;
        </button>

        <button type="button"
                aria-pressed="false"
                data-page="/MaterialStockMapping">
            Stok Kart&#305; E&#351;le&#351;tirme
        </button>

        <button type="button"
                aria-pressed="false"
                data-page="/MCRawWarehouses">
            Hammadde Depolar&#305;
        </button>

    </nav>

    <div class="mc-panel">

        <div id="mc-clean-loading"
             class="mc-loading" hidden>
            B&#246;l&#252;m y&#252;kleniyor...
        </div>

        <iframe id="mc-clean-frame"
                title="Malzeme Katalo&#287;u"
                src="/MaterialCatalog?mcEmbed=1">
        </iframe>

    </div>
</section>

<script>
(function () {
    "use strict";

    const root = document.getElementById("mc-raw-clean");
    if (!root || root.dataset.ready === "1") return;

    root.dataset.ready = "1";

    const frame = document.getElementById("mc-clean-frame");
    const loading = document.getElementById("mc-clean-loading");
    const buttons = Array.from(
        root.querySelectorAll("button[data-page]")
    );





    function formatInnerPage() {
        // Icerik artik sunucuda sade layout ile hazirlaniyor.
        // CSS enjeksiyonu ve DOM tasima yapilmiyor.
    }

    frame.addEventListener("load", function () {
        formatInnerPage();
        frame.hidden = false;
        loading.hidden = true;
    });

    buttons.forEach(function (button) {
        button.addEventListener("click", function () {
            const page = button.dataset.page;

            if (!page) return;

            buttons.forEach(function (item) {
                const selected = item === button;

                item.classList.toggle("active", selected);
                item.setAttribute(
                    "aria-pressed",
                    selected ? "true" : "false"
                );
            });

            loading.hidden = false;
            frame.hidden = true;
            if (new URL(frame.src, location.href).pathname !== page) { frame.src = page + "?mcEmbed=1"; } else { frame.hidden = false; loading.hidden = true; }
        });
    });
})();
</script>
