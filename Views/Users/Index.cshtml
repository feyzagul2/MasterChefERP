@section Scripts {
    <script>
    (() => {
        const search = document.getElementById("um-search");
        const status = document.getElementById("um-status");
        if (!search || !status) return;

        const rows = [...document.querySelectorAll("[data-um-row]")];
        const count = document.getElementById("um-count");
        const empty = document.getElementById("um-empty");

        const normalize = value => String(value ?? "")
            .toLocaleLowerCase("tr-TR")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/ı/g, "i");

        function filter() {
            const words = normalize(search.value)
                .trim().split(/\s+/).filter(Boolean);

            let visible = 0;

            rows.forEach(row => {
                const text = normalize(row.dataset.umSearch);
                row.hidden =
                    !words.every(word => text.includes(word))
                    || (status.value !== ""
                        && row.dataset.umStatus !== status.value);

                if (!row.hidden) visible++;
            });

            count.textContent = `${visible} / ${rows.length} kullanıcı`;
            empty.hidden = visible !== 0;
        }

        search.addEventListener("input", filter);
        status.addEventListener("change", filter);
        filter();
    })();
    </script>
    <script>
        document.querySelectorAll("form[data-status-confirm]").forEach(form => {
            form.addEventListener("submit", event => {
                if (!window.confirm(form.dataset.statusConfirm)) {
                    event.preventDefault();
                }
            });
        });
    </script>
}