
@model MasterChefTakip.Models.PurchaseGoodsReceipt
@{
    ViewData["Title"] = "Mal Kabul Detay";
}

<style>
.mc-gr{max-width:1160px;margin:auto}
.mc-gr-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.mc-gr-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px;margin:15px 0}
.mc-gr-btn{display:inline-block;border:1px solid #cbd5e1;border-radius:8px;padding:9px 13px;background:#fff;color:#17406a;text-decoration:none;font-size:13px;cursor:pointer}
.mc-gr-primary{background:#17406a;color:#fff;border-color:#17406a}
.mc-gr-scroll{overflow-x:auto}
.mc-gr-table{width:100%;min-width:800px;border-collapse:collapse}
.mc-gr-table th{text-align:left;background:#f8fafc;color:#475569;font-size:12px;padding:11px}
.mc-gr-table td{padding:10px;border-bottom:1px solid #edf2f7;font-size:13px}
.mc-gr-table input{max-width:125px;width:100%;padding:8px;border:1px solid #cbd5e1;border-radius:7px}
.mc-gr-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.mc-gr-field{display:flex;flex-direction:column;gap:5px}
.mc-gr-field label{font-size:12px;font-weight:650}
.mc-gr-field input,.mc-gr-field textarea{width:100%;max-width:none;box-sizing:border-box;padding:9px;border:1px solid #cbd5e1;border-radius:7px}
.mc-gr-hint{font-size:12px;color:#64748b}
@@media(max-width:700px){.mc-gr-grid{grid-template-columns:1fr}.mc-gr-card{padding:12px}}
</style>

<div class="mc-gr">
    <div class="mc-gr-head">
        <div>
            <h1>@Model.ReceiptNumber</h1>

<!-- MC_RECEIPT_CATALOG_BUTTON_2026 -->
<div style="margin:14px 0;display:flex;gap:10px;flex-wrap:wrap">
    <a asp-controller="ReceiptCatalog"
       asp-action="Index"
       asp-route-id="@Model.Id"
       style="display:inline-flex;align-items:center;
              padding:10px 16px;border-radius:8px;
              background:#17406a;color:white;
              text-decoration:none;font-weight:600;font-size:13px">
        Malzeme Eşleştir
    </a>
</div>

            <div>@Model.PurchaseDispatchNote.Supplier.CompanyName</div>
        </div>
        <a class="mc-gr-btn" asp-action="Index">Listeye D&#246;n</a>
    </div>

    <div class="mc-gr-card">
        <div>
            <strong>&#304;rsaliye:</strong>
            @Model.PurchaseDispatchNote.DocumentNumber
        </div>
        <div>
            <strong>Tarih:</strong>
            @Model.ReceiptDate.ToString("dd.MM.yyyy")
        </div>
        <div><strong>Durum:</strong> Kaydedildi</div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p>@Model.Notes</p>
        }
    </div>

    <div class="mc-gr-card mc-gr-scroll">
        <table class="mc-gr-table">
            <thead><tr>
                <th>&#220;r&#252;n</th><th>Birim</th>
                <th>Gelen</th><th>Kabul</th><th>Ret</th>
            </tr></thead>
            <tbody>
            @foreach (var x in Model.Lines.OrderBy(x => x.LineNumber))
            {
                <tr>
                    <td>@x.ProductDescription</td>
                    <td>@x.Unit</td>
                    <td>@x.ReceivedQuantity.ToString("N4")</td>
                    <td>@x.AcceptedQuantity.ToString("N4")</td>
                    <td>@x.RejectedQuantity.ToString("N4")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="mc-gr-card">
        <strong>Toplam Gelen:</strong>
        @Model.Lines.Sum(x => x.ReceivedQuantity).ToString("N4")
        <br />
        <strong>Toplam Kabul:</strong>
        @Model.Lines.Sum(x => x.AcceptedQuantity).ToString("N4")
        <br />
        <strong>Toplam Ret:</strong>
        @Model.Lines.Sum(x => x.RejectedQuantity).ToString("N4")
    </div>

    <p class="mc-gr-hint">
        Mal kabul kaydedildi. Stok hen&#252;z g&#252;ncellenmedi.
    </p>
</div>


<!-- MC_GOODS_STOCK_PREPARATION_LINK_2026 -->
<div style="margin:16px 0">
    <a asp-controller="PurchaseGoodsReceipt"
       asp-action="StockPreparation"
       asp-route-id="@Model.Id"
       style="display:inline-block;background:#17406a;
              color:#fff;padding:10px 15px;border-radius:8px;
              text-decoration:none;font-size:13px">
        Stok E&#351;le&#351;tirmeyi Kontrol Et
    </a>
</div>


<!-- MC_GOODS_STOCK_TRANSFER_LINK_2026 -->
<div style="margin:16px 0">
    <a asp-controller="GoodsReceiptStockTransfers"
       asp-action="Transfer"
       asp-route-id="@Model.Id"
       style="display:inline-block;background:#17406a;color:#fff;
              padding:10px 15px;border-radius:8px;
              font-size:13px;text-decoration:none">
        Mal Kabul&#252; Palet Sto&#287;una Aktar
    </a>
</div>

@if (TempData["GoodsStockSuccess"] is string stockSuccess)
{
    <div style="margin:12px 0;padding:12px;background:#dcfce7;
                color:#166534;border-radius:8px">
        @stockSuccess
    </div>
}


<!-- MC_RAW_RECEIPT_TRANSFER_LINK_2026 -->
<div style="margin:16px 0">
    <a asp-controller="RawMaterialReceipts"
       asp-action="Transfer"
       asp-route-id="@Model.Id"
       style="display:inline-block;background:#17406a;color:#fff;
              padding:10px 15px;border-radius:8px;
              font-size:13px;text-decoration:none">
        Mal Kabul&#252; Hammadde Sto&#287;una Aktar
    </a>
</div>
