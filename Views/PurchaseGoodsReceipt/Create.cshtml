
@model MasterChefTakip.Controllers.GoodsReceiptInput
@{
    ViewData["Title"] = "Yeni Mal Kabul";
    var note = (MasterChefTakip.Models.PurchaseDispatchNote)ViewBag.Note;
}

<style>
.mc-gr{max-width:1160px;margin:auto}
.mc-gr-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.mc-gr-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:18px;margin:15px 0}
.mc-gr-btn{display:inline-block;border:1px solid #cbd5e1;border-radius:8px;padding:9px 13px;background:#fff;color:#17406a;text-decoration:none;font-size:13px;cursor:pointer}
.mc-gr-primary{background:#17406a;color:#fff;border-color:#17406a}
.mc-gr-scroll{overflow-x:auto}
.mc-gr-table{width:100%;min-width:800px;border-collapse:collapse}
.mc-gr-table th{text-align:left;background:#f8fafc;color:#475569;font-size:12px;padding:11px}
.mc-gr-table td{padding:10px;border-bottom:1px solid #edf2f7;font-size:13px}
.mc-gr-table input{max-width:125px;width:100%;padding:8px;border:1px solid #cbd5e1;border-radius:7px}
.mc-gr-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.mc-gr-field{display:flex;flex-direction:column;gap:5px}
.mc-gr-field label{font-size:12px;font-weight:650}
.mc-gr-field input,.mc-gr-field textarea{width:100%;max-width:none;box-sizing:border-box;padding:9px;border:1px solid #cbd5e1;border-radius:7px}
.mc-gr-hint{font-size:12px;color:#64748b}
@@media(max-width:700px){.mc-gr-grid{grid-template-columns:1fr}.mc-gr-card{padding:12px}}
</style>

<div class="mc-gr">
    <div class="mc-gr-head">
        <div>
            <h1>Yeni Mal Kabul</h1>
            <div class="mc-gr-hint">
                @note.DocumentNumber - @note.Supplier.CompanyName
            </div>
        </div>
        <a class="mc-gr-btn" asp-controller="PurchaseDispatch"
           asp-action="Details" asp-route-id="@note.Id">
            &#304;rsaliyeye D&#246;n
        </a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="PurchaseDispatchNoteId" type="hidden" />

        <div asp-validation-summary="All"
             style="color:#b91c1c;font-size:13px"></div>

        <div class="mc-gr-card">
            <div class="mc-gr-grid">
                <div class="mc-gr-field">
                    <label asp-for="ReceiptDate">Mal Kabul Tarihi</label>
                    <input asp-for="ReceiptDate" type="date" required />
                </div>
                <div class="mc-gr-field">
                    <label asp-for="Notes">A&#231;&#305;klama</label>
                    <textarea asp-for="Notes" rows="2"></textarea>
                </div>
            </div>
        </div>

        <div class="mc-gr-card mc-gr-scroll">
            <h2 style="font-size:17px">Gelen &#220;r&#252;nler</h2>
            <table class="mc-gr-table">
                <thead><tr>
                    <th>&#220;r&#252;n / Malzeme</th>
                    <th>Birim</th>
                    <th>Kalan</th>
                    <th>Gelen</th>
                    <th>Kabul</th>
                    <th>Ret / Hasar</th>
                </tr></thead>
                <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Lines[i].ProductDescription
                            <input asp-for="Lines[i].PurchaseDispatchLineId"
                                   type="hidden" />
                        </td>
                        <td>@Model.Lines[i].Unit</td>
                        <td>
                            @Model.Lines[i].RemainingQuantity.ToString("N4")
                        </td>
                        <td>
                            <input asp-for="Lines[i].ReceivedQuantity"
                                   type="number" min="0" step="0.0001"
                                   max="@Model.Lines[i].RemainingQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        </td>
                        <td>
                            <input asp-for="Lines[i].AcceptedQuantity"
                                   type="number" min="0" step="0.0001" />
                        </td>
                        <td>
                            <input asp-for="Lines[i].RejectedQuantity"
                                   type="number" min="0" step="0.0001" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="mc-gr-card">
            <p class="mc-gr-hint">
                Kabul + Ret = Gelen olmal&#305;d&#305;r.
                Hen&#252;z stok hareketi olu&#351;turulmaz.
            </p>
            <button type="submit" class="mc-gr-btn mc-gr-primary">
                Mal Kabul Kayd&#305;n&#305; Olu&#351;tur
            </button>
        </div>
    </form>
</div>
