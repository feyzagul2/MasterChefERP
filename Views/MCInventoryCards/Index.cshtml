}

<section style="padding:20px">
    <h2>Genel Malzeme Stok Kartlar?</h2>

    <p>
        Bu listede genel malzeme kartlar? gösterilir.
        Stok miktarlar? de?i?tirilmez.
    </p>

    <div style="overflow-x:auto">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Malzeme</th>
                    <th>T?r</th>
                    <th>Birim</th>
                    <th>??lem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
