
@model MasterChefTakip.Models.PurchaseDispatchNote
@{
    ViewData["Title"] = "Al&#305;&#351; &#304;rsaliyesi";
}

<style>
.mc-pd{max-width:1120px;margin:auto}
.mc-pd-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin:16px 0}
.mc-pd-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.mc-pd-btn{display:inline-block;padding:9px 14px;background:#fff;border:1px solid #cbd5e1;border-radius:7px;color:#17406a;text-decoration:none;font-size:13px;cursor:pointer}
.mc-pd-primary{background:#17406a;border-color:#17406a;color:white}
.mc-pd-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
.mc-pd-field{display:flex;flex-direction:column;gap:5px}
.mc-pd-field label{font-size:12px;font-weight:650}
.mc-pd-field input,.mc-pd-field select,.mc-pd-field textarea{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:7px;padding:9px;font-size:13px}
.mc-pd-scroll{overflow-x:auto}
.mc-pd-table{width:100%;min-width:760px;border-collapse:collapse}
.mc-pd-table th{text-align:left;background:#f8fafc;padding:11px;font-size:12px}
.mc-pd-table td{padding:11px;border-bottom:1px solid #edf2f7;font-size:13px}
.mc-pd-note{font-size:12px;color:#64748b}
@@media(max-width:700px){.mc-pd-grid{grid-template-columns:1fr}.mc-pd-card{padding:13px}}
</style>

<div class="mc-pd">
    <div class="mc-pd-head">
        <div>
            <h1>@Model.DocumentNumber</h1>
            <div>@Model.Supplier.CompanyName</div>
        </div>
        <a class="mc-pd-btn" asp-action="Index">Listeye D&#246;n</a>
    </div>

    <div class="mc-pd-card">
        <div><strong>Durum:</strong> Taslak</div>
        <div><strong>Sipari&#351;:</strong>
            @(Model.PurchaseOrder?.OrderNumber ?? "Siparişsiz")</div>
        <div><strong>Tarih:</strong>
            @Model.DocumentDate.ToString("dd.MM.yyyy")</div>

        @if (!string.IsNullOrWhiteSpace(Model.SupplierDocumentNumber))
        {
            <div><strong>Tedarik&#231;i &#304;rsaliye No:</strong>
                @Model.SupplierDocumentNumber</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p>@Model.Notes</p>
        }
    </div>

    <div class="mc-pd-card mc-pd-scroll">
        <table class="mc-pd-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>&#220;r&#252;n / Malzeme</th>
                    <th>Birim</th>
                    <th>Miktar</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Lines.OrderBy(x => x.LineNumber))
            {
                <tr>
                    <td>@line.LineNumber</td>
                    <td>@line.ProductDescription</td>
                    <td>@line.Unit</td>
                    <td>@line.Quantity.ToString("N4")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="mc-pd-note">
        Bu irsaliye tasla&#287;&#305; stok hareketi olu&#351;turmaz.
        Stok giri&#351;i mal kabul onay&#305;nda yap&#305;lacakt&#305;r.
    </div>
</div>


<!-- MC_GOODS_RECEIPT_LINK_2026 -->
<div style="margin:16px 0">
    <a asp-controller="PurchaseGoodsReceipt"
       asp-action="Create"
       asp-route-dispatchId="@Model.Id"
       style="display:inline-block;background:#17406a;color:white;
              padding:10px 15px;border-radius:8px;text-decoration:none;
              font-size:13px">
        + Bu &#304;rsaliyeden Mal Kabul
    </a>
</div>
