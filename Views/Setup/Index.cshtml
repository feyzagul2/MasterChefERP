@model MasterChefTakip.ViewModels.SetupViewModel

@{
    ViewData["Title"] = "Yönetici Kurulumu";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-7">
        <section class="page-heading">
            <span class="eyebrow">HESAP KURULUMU</span>
            <h1>İlk yönetici hesabı</h1>
            <p>
                Sistemin ilk yönetici hesabını
                kendi bilgilerinizle oluşturun.
            </p>
        </section>

        <section class="welcome-card">
            <span class="section-label">YÖNETİCİ</span>

            <form asp-controller="Setup"
                  asp-action="Index"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert"></div>

                <div class="mb-4">
                    <label asp-for="FullName"
                           class="form-label fw-semibold"></label>
                    <input asp-for="FullName"
                           class="form-control form-control-lg"
                           autocomplete="name"
                           maxlength="100" />
                    <span asp-validation-for="FullName"
                          class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email"
                           class="form-label fw-semibold"></label>
                    <input asp-for="Email"
                           class="form-control form-control-lg"
                           type="email"
                           autocomplete="username"
                           maxlength="254"
                           aria-describedby="email-help" />
                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                    <div id="email-help" class="form-text">
                        Giriş yaparken bu adresi kullanacaksınız.
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Password"
                               class="form-label fw-semibold"></label>
                        <input asp-for="Password"
                               class="form-control form-control-lg"
                               type="password"
                               value=""
                               autocomplete="new-password"
                               maxlength="128"
                               aria-describedby="password-help" />
                        <span asp-validation-for="Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword"
                               class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword"
                               class="form-control form-control-lg"
                               type="password"
                               value=""
                               autocomplete="new-password"
                               maxlength="128" />
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>
                </div>

                <p id="password-help" class="form-text mt-3 mb-4">
                    Şifre en az 10 karakter olmalı;
                    büyük harf, küçük harf, rakam ve
                    özel karakter içermeli.
                </p>

                <button class="btn btn-primary btn-lg w-100"
                        type="submit">
                    Yönetici Hesabını Oluştur
                </button>

                <p class="page-note text-center">
                    Hesap oluşturulduğunda bu kurulum ekranı kapanır.
                </p>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}