<!-- MC_VIRMAN_ISSUE_BREAKDOWN_V1 -->

@{
    var mcIssueBreakdown = Model.SearchedItems
        .Where(x => !x.IsMatched)
        .GroupBy(x => x.Issue)
        .Select(g => new
        {
            Reason = g.Key,
            Count = g.Count(),
            TotalIn = g.Sum(x => x.TotalIn),
            TotalOut = g.Sum(x => x.TotalOut),
            Difference = g.Sum(x =>
                System.Math.Abs(x.TotalIn - x.TotalOut))
        })
        .OrderByDescending(x => x.Count)
        .ThenBy(x => x.Reason)
        .ToList();
}

