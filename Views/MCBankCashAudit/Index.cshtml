<!-- MC_VIRMAN_PRIORITY_REVIEW_V1 -->

@{
    var mcPriorityAll = Model.SearchedItems
        .Where(x => !x.IsMatched)
        .Select(x => new
        {
            Item = x,

            Priority =
                x.InCount != 1 ||
                x.OutCount != 1 ||
                x.Issue.Contains(
                    "Kaynak ve hedef",
                    System.StringComparison.OrdinalIgnoreCase) ||
                x.Issue.Contains(
                    "yönü",
                    System.StringComparison.OrdinalIgnoreCase)
                    ? 1
                    : x.TotalIn != x.TotalOut
                        ? 2
                        : 3,

            Difference = System.Math.Abs(
                x.TotalIn - x.TotalOut)
        })
        .OrderBy(x => x.Priority)
        .ThenByDescending(x => x.Difference)
        .ThenByDescending(x => x.Item.Date)
        .ToList();

    var mcPriorityRows = mcPriorityAll.Take(20).ToList();

    var mcPriorityOne = mcPriorityAll.Count(x => x.Priority == 1);
    var mcPriorityTwo = mcPriorityAll.Count(x => x.Priority == 2);
    var mcPriorityThree = mcPriorityAll.Count(x => x.Priority == 3);
}

