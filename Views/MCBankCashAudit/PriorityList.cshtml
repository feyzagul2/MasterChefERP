@model MasterChefTakip.Controllers.MCVirmanPriorityListPage
@using System.Globalization

@{
    ViewData["Title"] = "Tüm Sorunlu Virmanlar";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

<style>
.mc-priority-page {
    max-width: 1500px;
    margin: 0 auto;
    padding: 24px;
    color: #193047;
}

.mc-priority-page * {
    box-sizing: border-box;
}

.mc-priority-page h1 {
    font-size: 27px;
    font-weight: 800;
    margin-bottom: 10px;
}

.mc-priority-page .muted {
    color: #708398;
    font-size: 13px;
}

.mc-priority-page .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0;
}

.mc-priority-page .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 750;
    font-size: 13px;
    border: none;
    cursor: pointer;
}

.mc-priority-page .btn-blue {
    background: #235f98;
    color: white;
}

.mc-priority-page .btn-green {
    background: #16865d;
    color: white;
}

.mc-priority-page .btn-light {
    background: #edf3f9;
    color: #235f98;
}

.mc-priority-page .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 20px 0;
}

.mc-priority-page .stat {
    border: 1px solid #e0e7ef;
    border-radius: 12px;
    padding: 18px;
    background: white;
}

.mc-priority-page .stat .value {
    font-size: 25px;
    font-weight: 800;
    margin-top: 9px;
}

.mc-priority-page .red {
    color: #bd4545;
}

.mc-priority-page .orange {
    color: #9a5c0a;
}

.mc-priority-page .blue {
    color: #235f98;
}

.mc-priority-page .panel {
    background: white;
    border: 1px solid #e0e7ef;
    border-radius: 14px;
    padding: 20px;
    margin: 20px 0;
}

.mc-priority-page .table-wrap {
    overflow-x: auto;
}

.mc-priority-page table {
    width: 100%;
    border-collapse: collapse;
}

.mc-priority-page th,
.mc-priority-page td {
    padding: 12px;
    border-bottom: 1px solid #e6edf3;
    text-align: left;
    font-size: 13px;
    vertical-align: middle;
}

.mc-priority-page th {
    background: #f7f9fc;
    color: #60758a;
}

.mc-priority-page .badge {
    display: inline-block;
    padding: 7px 11px;
    border-radius: 8px;
    font-weight: 750;
    font-size: 12px;
    white-space: nowrap;
}

.mc-priority-page .p1 {
    background: #fde8e8;
    color: #a32929;
}

.mc-priority-page .p2 {
    background: #fff2de;
    color: #9a5c0a;
}

.mc-priority-page .p3 {
    background: #edf3f9;
    color: #235f98;
}

.mc-priority-page .detail {
    color: #235f98;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
}

.mc-priority-page .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
}

.mc-priority-page .pager-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.mc-priority-page .pager input {
    width: 75px;
    padding: 10px;
    border: 1px solid #dce7f2;
    border-radius: 8px;
}

.mc-priority-page .empty {
    background: #e2f6ec;
    color: #16865d;
    border-radius: 9px;
    padding: 20px;
    font-weight: 700;
}

@@media(max-width:900px) {
    .mc-priority-page .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media(max-width:600px) {
    .mc-priority-page {
        padding: 12px;
    }

    .mc-priority-page .stats {
        grid-template-columns: 1fr;
    }

    .mc-priority-page th,
    .mc-priority-page td {
        padding: 8px;
        font-size: 11px;
    }
}

@@media print {
    @@page {
        size: A4 landscape;
        margin: 12mm;
    }

    .mc-priority-page .toolbar,
    .mc-priority-page .pager,
    .mc-priority-page .detail {
        display: none !important;
    }

    .mc-priority-page {
        max-width: none;
        padding: 0;
    }

    .mc-priority-page th,
    .mc-priority-page td {
        padding: 5px;
        font-size: 9px;
    }

    .mc-priority-page thead {
        display: table-header-group;
    }

    .mc-priority-page tr {
        break-inside: avoid;
    }
}
.mc-priority-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0;
}

.mc-priority-filters .mc-pf {
    display: inline-block;
    padding: 12px 17px;
    border-radius: 9px;
    background: #edf3f9;
    color: #235f98;
    text-decoration: none;
    font-size: 13px;
    font-weight: 750;
}

.mc-priority-filters .mc-pf.active {
    background: #235f98;
    color: white;
}

.mc-priority-filters .mc-pf:hover {
    opacity: .85;
}

@@media print {
    .mc-priority-filters {
        display: none !important;
    }
}

</style>

<div class="mc-priority-page">

    <h1>Tüm Sorunlu Virmanlar</h1>
<!-- MC_PRIORITY_FILTER_V1 -->

<!-- MC_PRIORITY_ADVANCED_SEARCH_V1 -->

<style>
.mc-priority-search {
    background: #ffffff;
    border: 1px solid #e0e7ef;
    border-radius: 14px;
    padding: 22px;
    margin: 20px 0;
}

.mc-priority-search h3 {
    font-size: 19px;
    font-weight: 800;
    margin-bottom: 8px;
    color: #193047;
}

.mc-priority-search p {
    color: #708398;
    font-size: 13px;
    margin-bottom: 18px;
}

.mc-priority-search .search-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr 1fr;
    gap: 14px;
}

.mc-priority-search .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.mc-priority-search label {
    font-size: 12px;
    font-weight: 750;
    color: #60758a;
}

.mc-priority-search input,
.mc-priority-search select {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid #dce7f2;
    border-radius: 9px;
    background: #fff;
    color: #193047;
    font-size: 13px;
}

.mc-priority-search input:focus,
.mc-priority-search select:focus {
    outline: 2px solid #a9c8e8;
    border-color: #235f98;
}

.mc-priority-search .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
}

.mc-priority-search .submit-btn {
    padding: 12px 23px;
    min-height: 44px;
    background: #235f98;
    border: none;
    border-radius: 9px;
    color: white;
    font-weight: 750;
    cursor: pointer;
}

.mc-priority-search .reset-btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    min-height: 44px;
    background: #edf3f9;
    color: #235f98;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 750;
    font-size: 13px;
}

.mc-priority-search .hint {
    color: #708398;
    font-size: 12px;
}

@@media(max-width:950px) {
    .mc-priority-search .search-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media(max-width:600px) {
    .mc-priority-search {
        padding: 14px;
    }

    .mc-priority-search .search-grid {
        grid-template-columns: 1fr;
    }

    .mc-priority-search .actions {
        flex-direction: column;
        align-items: stretch;
    }

    .mc-priority-search .submit-btn,
    .mc-priority-search .reset-btn {
        justify-content: center;
        text-align: center;
    }
}

@@media print {
    .mc-priority-search {
        display: none !important;
    }
}
</style>

<div class="mc-priority-search">

    <h3>Gelişmiş Virman Arama</h3>

    <p>
        Tarih aralığı, virman kodu, hesap adı ve
        öncelik seviyesine göre sorunlu işlemleri filtreleyin.
    </p>

    <form method="get"
          action="/MCBankCashAudit/PriorityList">

        <input type="hidden"
               name="status"
               value="@Model.Status" />

        <div class="search-grid">

            <div class="field">
                <label for="mc-priority-start">
                    Başlangıç Tarihi
                </label>

                <input id="mc-priority-start"
                       type="date"
                       name="start"
                       value="@Model.Start" />
            </div>

            <div class="field">
                <label for="mc-priority-end">
                    Bitiş Tarihi
                </label>

                <input id="mc-priority-end"
                       type="date"
                       name="end"
                       value="@Model.End" />
            </div>

            <div class="field">
                <label for="mc-priority-query">
                    Virman Kodu / Hesap Ara
                </label>

                <input id="mc-priority-query"
                       type="search"
                       name="q"
                       value="@Model.Search"
                       maxlength="200"
                       placeholder="Virman kodu veya banka / kasa adı" />
            </div>

            <div class="field">
                <label for="mc-priority-level">
                    Kontrol Önceliği
                </label>

                <select id="mc-priority-level"
                        name="priority">

                    <option value="0"
                            selected="@(Model.SelectedPriority == 0)">
                        Tüm Öncelikler
                    </option>

                    <option value="1"
                            selected="@(Model.SelectedPriority == 1)">
                        Öncelik 1 — Kayıt Sorunu
                    </option>

                    <option value="2"
                            selected="@(Model.SelectedPriority == 2)">
                        Öncelik 2 — Tutar Farkı
                    </option>

                    <option value="3"
                            selected="@(Model.SelectedPriority == 3)">
                        Öncelik 3 — Diğer Kontroller
                    </option>

                </select>
            </div>

        </div>

        <div class="actions">

            <button type="submit"
                    class="submit-btn">
                Filtrele ve Ara
            </button>

            <a class="reset-btn"
               href="/MCBankCashAudit/PriorityList">
                Filtreleri Temizle
            </a>

            <span class="hint">
                Yeni aramada liste ilk sayfadan başlar.
                Excel aktarımı seçilen filtreleri kullanır.
            </span>

        </div>

    </form>

</div>
<!-- MC_PRIORITY_ACTIVE_SUMMARY_V1 -->
<div class="mc-active-filter-summary"
     role="status"
     style="display:flex;flex-wrap:wrap;gap:10px;
            padding:14px;margin:15px 0;
            background:#eef5fc;border:1px solid #d7e4f2;
            border-radius:10px;font-size:13px;color:#23415e">

    <span>
        <strong>Toplam Sorunlu Virman:</strong>
        @Model.TotalCount
    </span>

    <span>
        <strong>Başlangıç:</strong>
        @(string.IsNullOrWhiteSpace(Model.Start) ? "Tümü" : Model.Start)
    </span>

    <span>
        <strong>Bitiş:</strong>
        @(string.IsNullOrWhiteSpace(Model.End) ? "Tümü" : Model.End)
    </span>

    <span>
        <strong>Öncelik:</strong>
        @(Model.SelectedPriority == 0
            ? "Tümü"
            : "Öncelik " + Model.SelectedPriority)
    </span>

    <!-- MC_FILTER_SUMMARY_STATUS_V2 -->
    <span>
        <strong>Durum:</strong>
        @(string.IsNullOrWhiteSpace(Model.Status) ||
          string.Equals(
              Model.Status,
              "all",
              System.StringComparison.OrdinalIgnoreCase)
            ? "Tümü"
            : Model.Status)
    </span>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <span>
            <strong>Arama:</strong>
            @Model.Search
        </span>
    }
</div>
<div class="mc-priority-filters">

    <a class="mc-pf @(Model.SelectedPriority == 0 ? "active" : "")"
       href="/MCBankCashAudit/PriorityListüstart=@Uri.EscapeDataString(Model.Start ?? string.Empty)&amp;end=@Uri.EscapeDataString(Model.End ?? string.Empty)&amp;status=@Uri.EscapeDataString(Model.Status ?? string.Empty)&amp;q=@Uri.EscapeDataString(Model.Search ?? string.Empty)&amp;priority=0">
        Tümü (@(Model.PriorityOne + Model.PriorityTwo + Model.PriorityThree))
    </a>

    <a class="mc-pf @(Model.SelectedPriority == 1 ? "active" : "")"
       href="/MCBankCashAudit/PriorityListüstart=@Uri.EscapeDataString(Model.Start ?? string.Empty)&amp;end=@Uri.EscapeDataString(Model.End ?? string.Empty)&amp;status=@Uri.EscapeDataString(Model.Status ?? string.Empty)&amp;q=@Uri.EscapeDataString(Model.Search ?? string.Empty)&amp;priority=1">
        Öncelik 1 (@Model.PriorityOne)
    </a>

    <a class="mc-pf @(Model.SelectedPriority == 2 ? "active" : "")"
       href="/MCBankCashAudit/PriorityListüstart=@Uri.EscapeDataString(Model.Start ?? string.Empty)&amp;end=@Uri.EscapeDataString(Model.End ?? string.Empty)&amp;status=@Uri.EscapeDataString(Model.Status ?? string.Empty)&amp;q=@Uri.EscapeDataString(Model.Search ?? string.Empty)&amp;priority=2">
        Öncelik 2 (@Model.PriorityTwo)
    </a>

    <a class="mc-pf @(Model.SelectedPriority == 3 ? "active" : "")"
       href="/MCBankCashAudit/PriorityListüstart=@Uri.EscapeDataString(Model.Start ?? string.Empty)&amp;end=@Uri.EscapeDataString(Model.End ?? string.Empty)&amp;status=@Uri.EscapeDataString(Model.Status ?? string.Empty)&amp;q=@Uri.EscapeDataString(Model.Search ?? string.Empty)&amp;priority=3">
        Öncelik 3 (@Model.PriorityThree)
    </a>

</div>


    <p class="muted">
        Dönem: @Model.Start - @Model.End |
        Toplam @Model.TotalCount sorunlu virman
    </p>

    <div class="toolbar">

        <a class="btn btn-blue"
           href="/MCBankCashAuditüstart=@Uri.EscapeDataString(Model.Start ?? string.Empty)&amp;end=@Uri.EscapeDataString(Model.End ?? string.Empty)&amp;status=@Uri.EscapeDataString(Model.Status ?? string.Empty)&amp;q=@Uri.EscapeDataString(Model.Search ?? string.Empty)">
            ← Virman Mutabakatına Dön
        </a>

        <a class="btn btn-green"
           href="/MCBankCashAudit/PriorityExport?priority=@Model.SelectedPriority&amp;start=@Uri.EscapeDataString(Model.Start ?? string.Empty)&amp;end=@Uri.EscapeDataString(Model.End ?? string.Empty)&amp;status=@Uri.EscapeDataString(Model.Status ?? string.Empty)&amp;q=@Uri.EscapeDataString(Model.Search ?? string.Empty)">
            Tüm Sorunlu Virmanları Excel'e Aktar
        </a>

        <button type="button"
                class="btn btn-light"
                onclick="window.print()">
            Yazdır / PDF
        </button>

    </div>

<!-- MC_VIRMAN_AGING_V1 -->

<style>
.mc-aging-panel {
    background: #fff;
    border: 1px solid #e0e7ef;
    border-radius: 14px;
    padding: 22px;
    margin: 22px 0;
}

.mc-aging-panel h2 {
    font-size: 21px;
    font-weight: 800;
    color: #193047;
    margin-bottom: 8px;
}

.mc-aging-panel .description {
    color: #708398;
    font-size: 13px;
    margin-bottom: 18px;
}

.mc-aging-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
}

.mc-aging-card {
    padding: 18px;
    border-radius: 11px;
    border: 1px solid #e0e7ef;
    background: #f8fafc;
}

.mc-aging-card .label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 10px;
}

.mc-aging-card strong {
    display: block;
    font-size: 28px;
    font-weight: 800;
}

.mc-aging-card.a1 {
    background: #e9f7ef;
    color: #16865d;
}

.mc-aging-card.a2 {
    background: #edf3f9;
    color: #235f98;
}

.mc-aging-card.a3 {
    background: #fff2de;
    color: #9a5c0a;
}

.mc-aging-card.a4 {
    background: #fde8e8;
    color: #a32929;
}

.mc-aging-footer {
    margin-top: 17px;
    padding: 13px 15px;
    background: #f7f9fc;
    border-radius: 9px;
    color: #60758a;
    font-size: 13px;
}

.mc-aging-days {
    display: block;
    font-size: 11px;
    margin-top: 5px;
    color: #708398;
}

.mc-aging-days.old {
    color: #bd4545;
    font-weight: 800;
}

@@media(max-width:900px) {
    .mc-aging-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media(max-width:500px) {
    .mc-aging-panel {
        padding: 13px;
    }

    .mc-aging-grid {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .mc-aging-card {
        padding: 12px;
    }

    .mc-aging-card strong {
        font-size: 23px;
    }
}

@@media print {
    .mc-aging-panel {
        break-inside: avoid;
    }
}
</style>

<!-- MC_AGING_PROGRESS_BARS_V1 -->
<style>
.mc-aging-progress {
    width: 100%;
    height: 9px;
    margin-top: 12px;
    margin-bottom: 10px;
    border-radius: 20px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.10);
}

.mc-aging-progress-fill {
    height: 100%;
    min-width: 0;
    border-radius: 20px;
    transition: width .35s ease;
}

.mc-aging-progress-fill.green {
    background: #16865d;
}

.mc-aging-progress-fill.blue {
    background: #235f98;
}

.mc-aging-progress-fill.orange {
    background: #dc8e22;
}

.mc-aging-progress-fill.red {
    background: #bc3434;
}
</style>
<!-- MC_AGING_PERCENT_V1 -->
<!-- MC_VIRMAN_RESULT_WARNINGS_V1 -->
<style>
.mc-result-alert {
    margin: 16px 0;
    padding: 17px 20px;
    border-radius: 12px;
    border: 1px solid;
    font-size: 14px;
    line-height: 1.6;
}

.mc-result-alert.empty {
    background: #eef5fc;
    border-color: #bed8ef;
    color: #24476b;
}

.mc-result-alert.warning {
    background: #fff3de;
    border-color: #efcf8f;
    color: #805016;
}

.mc-result-alert strong {
    display: block;
    font-size: 16px;
    margin-bottom: 5px;
}

.mc-result-alert a {
    display: inline-block;
    margin-top: 10px;
    padding: 9px 14px;
    border-radius: 8px;
    background: #234f78;
    color: white;
    font-weight: 700;
    text-decoration: none;
}

.mc-result-alert a:hover {
    background: #183b5e;
    color: white;
}
</style>

@if (Model.TotalCount == 0)
{
    <div class="mc-result-alert empty" role="status">
        <strong>Seçilen filtrelerde sorunlu virman bulunamadı.</strong>

        Tarih aralığını, öncelik seçimini veya arama kelimesini
        değiştirerek tekrar arama yapabilirsiniz.

        <div>
            <a href="/MCBankCashAudit/PriorityList">
                Tüm Filtreleri Temizle
            </a>
        </div>
    </div>
}

@if (Model.AgeUnknown > 0)
{
    <div class="mc-result-alert warning" role="alert">
        <strong>Hareket Tarihi Kontrolü Gerekiyor</strong>

        Seçilen filtrelerdeki
        <strong style="display:inline">@Model.AgeUnknown</strong>
        sorunlu virmanın hareket tarihi yaşlandırma hesabına
        dahil edilemedi.

        Bu kayıtların tarih bilgilerini kontrol ediniz.
        Yaşlandırma yüzdeleri toplam sorunlu virman sayısı
        üzerinden hesaplanmaktadır.
    </div>
}
<!-- MC_AUDIT_CRITICAL_TRIAGE_V1 -->
@{
    var mcUrgentP1 = Model.FilteredRows.Count(x =>
        x.Priority == 1 &&
        x.DaysSinceLastMovement.HasValue &&
        x.DaysSinceLastMovement.Value >= 8);

    var mcOldP1 = Model.FilteredRows.Count(x =>
        x.Priority == 1 &&
        x.DaysSinceLastMovement.HasValue &&
        x.DaysSinceLastMovement.Value >= 31);
}

<style>
.mc-critical-triage {
    background: #fff7ed;
    border: 1px solid #f1c58d;
    border-left: 5px solid #df8423;
    border-radius: 12px;
    padding: 19px;
    margin: 20px 0;
    color: #754615;
}

.mc-critical-triage h3 {
    font-size: 19px;
    font-weight: 800;
    margin: 0 0 12px;
}

.mc-critical-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

.mc-critical-box {
    background: #fff;
    border: 1px solid #f2ddc1;
    border-radius: 10px;
    padding: 15px;
}

.mc-critical-box strong {
    display: block;
    font-size: 28px;
    font-weight: 800;
    color: #a84626;
}

.mc-critical-box span {
    display: block;
    font-size: 12px;
    font-weight: 700;
    margin-top: 5px;
}

.mc-critical-note {
    font-size: 12px;
    line-height: 1.6;
    margin-top: 14px;
}

.mc-critical-link {
    display: inline-block;
    margin-top: 15px;
    background: #9b412b;
    color: #fff !important;
    border-radius: 8px;
    padding: 10px 15px;
    font-weight: 700;
    text-decoration: none;
}

.mc-critical-link:hover {
    background: #762b1c;
}

@@media(max-width:650px) {
    .mc-critical-grid {
        grid-template-columns: 1fr;
    }
}

@@media print {
    .mc-critical-triage {
        break-inside: avoid;
    }

    .mc-critical-link {
        display: none;
    }
}
</style>

@if (mcUrgentP1 > 0 || Model.Age31Plus > 0)
{
    <section class="mc-critical-triage" aria-label="Kritik virman inceleme özeti">

        <h3>⚠ Kritik Virman İnceleme Listesi</h3>

        <div class="mc-critical-grid">

            <div class="mc-critical-box">
                <strong>@mcUrgentP1</strong>
                <span>Öncelik 1 — 8 Gün ve Üzeri</span>
            </div>

            <div class="mc-critical-box">
                <strong>@mcOldP1</strong>
                <span>Öncelik 1 — 31 Gün ve Üzeri</span>
