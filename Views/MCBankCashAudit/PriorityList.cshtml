<!-- MC_PRIORITY_QUICK_DATES_V1 -->

<style>
.mc-quick-dates {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 15px 0;
    padding: 13px;
    background: #f4f7fb;
    border: 1px solid #e1e8f0;
    border-radius: 10px;
}

.mc-quick-dates-label {
    width: 100%;
    font-size: 13px;
    font-weight: 700;
    color: #33465c;
}

.mc-quick-date-btn {
    appearance: none;
    background: #fff;
    border: 1px solid #ccd7e3;
    border-radius: 8px;
    color: #25476b;
    padding: 9px 13px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s, border-color .15s;
}

.mc-quick-date-btn:hover {
    background: #e8f2ff;
    border-color: #6e9dd0;
}

.mc-quick-date-btn:focus-visible {
    outline: 3px solid #7db5ef;
    outline-offset: 2px;
}

.mc-quick-date-btn.mc-clear-date {
    background: #fff5f5;
    border-color: #f1cdcd;
    color: #a33b3b;
}
</style>

<script>
(function () {
    "use strict";

    function setupQuickDates() {
        var forms = Array.from(document.querySelectorAll("form"));

        var form = forms.find(function (element) {
            var action = element.getAttribute("action") || "";

            return action.indexOf("/MCBankCashAudit/PriorityList") >= 0 &&
                   element.querySelector('input[name="start"]') &&
                   element.querySelector('input[name="end"]');
        });

        if (!form || form.querySelector(".mc-quick-dates")) {
            return;
        }

        var startInput = form.querySelector('input[name="start"]');
        var endInput = form.querySelector('input[name="end"]');

        var container = document.createElement("div");
        container.className = "mc-quick-dates";

        var label = document.createElement("div");
        label.className = "mc-quick-dates-label";
        label.textContent = "Hızlı Tarih Seçimi";

        container.appendChild(label);

        function formatDate(date) {
            var year = date.getFullYear();
            var month = String(date.getMonth() + 1).padStart(2, "0");
            var day = String(date.getDate()).padStart(2, "0");

            return year + "-" + month + "-" + day;
        }

        function submitDates(days, monthMode, clearMode) {
            if (clearMode) {
                startInput.value = "";
                endInput.value = "";
            } else {
                var today = new Date();
                var beginning = new Date(today);

                if (monthMode) {
                    beginning.setDate(1);
                } else {
                    beginning.setDate(
                        today.getDate() - (days - 1)
                    );
                }

                startInput.value = formatDate(beginning);
                endInput.value = formatDate(today);
            }

            // Arama, durum ve oncelik alanlari degistirilmez.
            // Yalnizca tarih araligi guncellenir.
            form.requestSubmit();
        }

        var options = [
            { text: "Bugün", days: 1 },
            { text: "Son 7 Gün", days: 7 },
            { text: "Son 30 Gün", days: 30 },
            { text: "Bu Ay", month: true },
            { text: "Tarihleri Temizle", clear: true }
        ];

        options.forEach(function (option) {
            var button = document.createElement("button");

            button.type = "button";
            button.className = "mc-quick-date-btn";

            if (option.clear) {
                button.className += " mc-clear-date";
            }

            button.textContent = option.text;

            button.addEventListener("click", function () {
                submitDates(
                    option.days || 0,
                    option.month === true,
                    option.clear === true
                );
            });

            container.appendChild(button);
        });

        form.appendChild(container);
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            setupQuickDates
        );
    } else {
        setupQuickDates();
    }
})();
</script>


<!-- MC_DATE_RANGE_VALIDATION_V1 -->
<script>
(function () {
    "use strict";

    function initializeDateValidation() {

        var forms = Array.from(document.querySelectorAll("form"));

        var form = forms.find(function (element) {
            var action = element.getAttribute("action") || "";

            return action.indexOf("/MCBankCashAudit/PriorityList") >= 0 &&
                   element.querySelector('input[name="start"]') &&
                   element.querySelector('input[name="end"]');
        });

        if (!form) {
            return;
        }

        var startInput = form.querySelector('input[name="start"]');
        var endInput = form.querySelector('input[name="end"]');

        if (!startInput || !endInput) {
            return;
        }

        function clearErrors() {
            startInput.setCustomValidity("");
            endInput.setCustomValidity("");
        }

        function validateDates() {

            clearErrors();

            var start = startInput.value;
            var end = endInput.value;

            if (!start || !end) {
                return true;
            }

            if (start > end) {

                endInput.setCustomValidity(
                    "Bitiş tarihi başlangıç tarihinden önce olamaz."
                );

                endInput.reportValidity();

                endInput.focus();

                return false;
            }

            return true;
        }

        startInput.addEventListener("input", clearErrors);
        startInput.addEventListener("change", clearErrors);

        endInput.addEventListener("input", clearErrors);
        endInput.addEventListener("change", clearErrors);

        form.addEventListener("submit", function (event) {

            if (!validateDates()) {
                event.preventDefault();
                event.stopPropagation();
            }

        });

        // Klavyeyle Enter kullanildiginda da form kontrol edilir.
        // Hizli tarih butonlarinin requestSubmit() cagrisi
        // ayni dogrulama mekanizmasindan gecer.
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initializeDateValidation
        );
    } else {
        initializeDateValidation();
    }

})();
</script>
