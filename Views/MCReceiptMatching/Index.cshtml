@model MasterChefTakip.Controllers.MCReceiptMatchingPage

@{
    ViewData["Title"] = "Mal Kabul Aktarım Ön Kontrolü";
}

<div style="max-width:1350px;margin:24px auto;padding:20px">

    <h2>MASTER CHEF ? Mal Kabul Aktarım Ön Kontrolü</h2>

    <p>
        Mal kabul, miktar, birim ve hammadde eşleştirmelerinin
        aktarım öncesi durumu gösterilir.
    </p>

    <section style="display:grid;
                    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
                    gap:12px;margin:20px 0">

        <div style="padding:18px;background:#eff6ff;border-radius:9px">
            <div>Görüntülenen Satır</div>
            <strong style="font-size:28px">@Model.Lines.Count</strong>
        </div>

        <div style="padding:18px;background:#f0fdf4;border-radius:9px">
            <div>?n Kontrolleri Uygun</div>
            <strong style="font-size:28px">
                @Model.Lines.Count(x => x.PrecheckReady)
            </strong>
        </div>

        <div style="padding:18px;background:#fff7ed;border-radius:9px">
            <div>Kontrol Gerektiren</div>
            <strong style="font-size:28px">
                @Model.Lines.Count(x => !x.PrecheckReady)
            </strong>
        </div>
    </section>

    <h3>Stoğa Aktar?lmam?? Mal Kabul Satırları</h3>

    @if (Model.Lines.Count == 0)
    {
        <p style="padding:18px;background:#f8fafc">
            Hen?z aktarılmamış mal kabul satırı bulunmuyor.
        </p>
    }
    else
    {
        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse">
                <thead style="background:#f1f5f9">
                    <tr>
                        <th style="padding:12px">Mal Kabul</th>
                        <th style="padding:12px">Satır</th>
                        <th style="padding:12px">Ürün</th>
                        <th style="padding:12px">Miktar</th>
                        <th style="padding:12px">Birim</th>
                        <th style="padding:12px">Durum</th>
                        <th style="padding:12px">Kontrol Sonucu</th>
                        <th style="padding:12px">??lem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Lines)
                    {
                        <tr style="border-bottom:1px solid #e2e8f0">
                            <td style="padding:10px">@row.ReceiptId</td>
                            <td style="padding:10px">@row.Id</td>
                            <td style="padding:10px">@row.Description</td>
                            <td style="padding:10px">@row.Quantity</td>
                            <td style="padding:10px">@row.Unit</td>
                            <td style="padding:10px">@row.ReceiptStatus</td>
                            <td style="padding:10px">
                                <strong style="color:@(row.PrecheckReady ? "#166534" : "#b45309")">
                                    @row.Reasons
                                </strong>
                            </td>
                            <td style="padding:10px">
                                <a asp-controller="RawMaterialReceipts"
                                   asp-action="Transfer"
                                   asp-route-id="@row.ReceiptId">
                                    Aktarım Ekranı
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h3 style="margin-top:28px">Aktif Hammadde Kartları</h3>

    @if (Model.Materials.Count == 0)
    {
        <p>Hen?z aktif hammadde kartı bulunmuyor.</p>
    }
    else
    {
        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse">
                <thead style="background:#f1f5f9">
                    <tr>
                        <th style="padding:12px">Kod</th>
                        <th style="padding:12px">Hammadde</th>
                        <th style="padding:12px">Birim</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Materials)
                    {
                        <tr>
                            <td style="padding:10px">@item.Code</td>
                            <td style="padding:10px">@item.Name</td>
                            <td style="padding:10px">@item.Unit</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p style="margin-top:22px">
        <a href="/MCRawMaterialCards">Hammadde Kartları</a>
        |
        <a href="/MCReceiptTransferHistory">Stok Aktarım Geçmişi</a>
    </p>

    <p style="color:#64748b;font-size:13px">
        Ön kontrolün uygun olmas? stok aktarım izni de?ildir.
        Depo, yetki, güncel e?le?tirmeler ve mükerrer aktarım
        kontrolü işlem sırasında ayrıca doğrulanır.
        Bu ekran stok kaydı olu?turmaz.
    </p>
</div>
