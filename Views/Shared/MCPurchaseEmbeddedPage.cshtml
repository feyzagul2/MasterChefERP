        startLabel.textContent = "Başlangıç Tarihi";

        const start = document.createElement("input");
        start.type = "date";
        start.name = "startDate";
        startLabel.appendChild(start);

        const endLabel = document.createElement("label");
        endLabel.textContent = "Bitiş Tarihi";

        const end = document.createElement("input");
        end.type = "date";
        end.name = "endDate";
        endLabel.appendChild(end);

        const button = document.createElement("button");
        button.type = "submit";
        button.textContent = "Excel Raporu Al";

        form.append(startLabel, endLabel, button);

        form.addEventListener("submit", function(event) {
            if (start.value && end.value && start.value > end.value) {
                event.preventDefault();
                end.setCustomValidity(
                    "Bitiş tarihi başlangıç tarihinden önce olamaz."
                );
                end.reportValidity();
            } else {
                end.setCustomValidity("");
            }
        });

        end.addEventListener("input", function() {
            end.setCustomValidity("");
        });

        link.closest("nav").insertAdjacentElement("afterend", form);
    }

    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", init);
    else
        init();
})();
</script>
<!-- MC_CARI_EXPORT_QUICK_DATES_V1 -->
<style>
.mc-cari-quick-dates {
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:7px;
}
.mc-cari-quick-dates button {
    height:34px;
    padding:0 12px;
    background:#fff;
    border:1px solid #cbd5e1;
    border-radius:7px;
    color:#244567;
    font-size:12px;
    font-weight:600;
    cursor:pointer;
}
.mc-cari-quick-dates button:hover {
    background:#e1eaf4;
}
</style>

<script>
(function () {
    "use strict";

    function init() {
        if (location.pathname.toLowerCase() !==
            "/mcpurchaseinvoicecariposting") return;

        const form = document.getElementById("mcCariExportFilter");

        if (!form || form.querySelector(".mc-cari-quick-dates"))
            return;

        const start = form.querySelector('[name="startDate"]');
        const end = form.querySelector('[name="endDate"]');

        if (!start || !end) return;

        const group = document.createElement("div");
        group.className = "mc-cari-quick-dates";

        function format(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, "0");
            const day = String(date.getDate()).padStart(2, "0");
            return year + "-" + month + "-" + day;
        }

        function addButton(title, action) {
            const button = document.createElement("button");
            button.type = "button";
            button.textContent = title;
            button.addEventListener("click", action);
            group.appendChild(button);
        }

        addButton("Bu Ay", function () {
            const today = new Date();
            start.value = format(new Date(
                today.getFullYear(), today.getMonth(), 1
            ));
            end.value = format(new Date(
                today.getFullYear(), today.getMonth() + 1, 0
            ));
            end.setCustomValidity("");
        });

        addButton("Geçen Ay", function () {
            const today = new Date();
            start.value = format(new Date(
                today.getFullYear(), today.getMonth() - 1, 1
            ));
            end.value = format(new Date(
                today.getFullYear(), today.getMonth(), 0
            ));
            end.setCustomValidity("");
        });

        addButton("Tüm Kayıtlar", function () {
            start.value = "";
            end.value = "";
            end.setCustomValidity("");
        });

        // MC_CARI_RECENT_DATES_V1
        function recentDays(days) {
            const today = new Date();
            const first = new Date(
                today.getFullYear(),
                today.getMonth(),
                today.getDate() - days + 1
            );

            start.value = format(first);
            end.value = format(today);
            end.setCustomValidity("");
        }

        addButton("Son 7 Gün", function () {
            recentDays(7);
        });

        addButton("Son 30 Gün", function () {
            recentDays(30);
        });

        addButton("Son 90 Gün", function () {
            recentDays(90);
        });

        form.appendChild(group);
    }

    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", init);
    else
        init();
})();
</script>
<!-- MC_CARI_DATE_PERSIST_V1 -->
<script>
(function () {
    "use strict";

    if (location.pathname.toLowerCase() !==
        "/mcpurchaseinvoicecariposting") return;

    function init() {
        const form = document.getElementById("mcCariExportFilter");
        if (!form || form.dataset.mcDatePersist === "1") return;

        const start = form.querySelector('[name="startDate"]');
        const end = form.querySelector('[name="endDate"]');
        if (!start || !end) return;

        form.dataset.mcDatePersist = "1";

        const key = "mcCariExportDateRangeV1";

        try {
            const saved = JSON.parse(sessionStorage.getItem(key) || "{}");

            if (/^\d{4}-\d{2}-\d{2}$/.test(saved.start || ""))
                start.value = saved.start;

            if (/^\d{4}-\d{2}-\d{2}$/.test(saved.end || ""))
                end.value = saved.end;
        } catch (_) {}

        function save() {
            try {
                sessionStorage.setItem(key, JSON.stringify({
                    start: start.value,
                    end: end.value
                }));
            } catch (_) {}
        }

        start.addEventListener("change", save);
        end.addEventListener("change", save);

        form.addEventListener("submit", save);

        form.querySelectorAll(".mc-cari-quick-dates button")
            .forEach(function(button) {
                button.addEventListener("click", save);
            });
    }

    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", init);
    else
        init();
})();
</script>
<!-- MC_CARI_EXPORT_VERIFY_V1 -->
<script>
(function () {
    "use strict";

    function init() {
        if (location.pathname.toLowerCase() !==
            "/mcpurchaseinvoicecariposting") return;

        const form = document.getElementById("mcCariExportFilter");

        if (!form || document.getElementById("mcCariVerifyButton"))
            return;

        const button = document.createElement("button");
        button.id = "mcCariVerifyButton";
        button.type = "button";
        button.textContent = "Raporu Kontrol Et";

        button.addEventListener("click", function () {
            const start = form.querySelector('[name="startDate"]');
            const end = form.querySelector('[name="endDate"]');

            const params = new URLSearchParams();

            if (start && start.value)
                params.set("startDate", start.value);

            if (end && end.value)
                params.set("endDate", end.value);

            const url = "/MCPurchaseCariExport" +
                (params.toString() ? "?" + params.toString() : "");

            window.location.href = url;
        });

        form.appendChild(button);
    }

    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", init);
    else
        init();
})();
</script>

