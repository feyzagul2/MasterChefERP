<!-- MC_INVOICE_NUMBER_DATE_VALIDATION_V1 -->
<script>
(function () {
    "use strict";

    const root = document.querySelector(".mc-purchase-shell");
    if (!root) return;

    root.addEventListener("submit", function (event) {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.method.toLowerCase() !== "post") return;

        const invoiceFields = Array.from(
            form.querySelectorAll("input[name]")
        ).filter(function (input) {
            return /invoice(number|no)|fatura(no|numara)/i.test(
                input.name.replace(/[_\s.-]/g, "")
            );
        });

        invoiceFields.forEach(function (input) {
            input.value = input.value.trim().replace(/\s+/g, " ");
        });

        const dateFields = Array.from(
            form.querySelectorAll('input[type="date"]')
        ).filter(function (input) {
            return /invoice|fatura/i.test(input.name);
        });

        dateFields.forEach(function (input) {
            if (!input.value) return;

            const parts = input.value.split("-");
            if (parts.length !== 3) {
                event.preventDefault();
                input.focus();
                return;
            }

            const year = Number(parts[0]);
            const month = Number(parts[1]);
            const day = Number(parts[2]);

            const date = new Date(Date.UTC(year, month - 1, day));

            if (
                date.getUTCFullYear() !== year ||
                date.getUTCMonth() !== month - 1 ||
                date.getUTCDate() !== day
            ) {
                event.preventDefault();
                input.focus();
            }
        });
    }, true);
})();
</script>
