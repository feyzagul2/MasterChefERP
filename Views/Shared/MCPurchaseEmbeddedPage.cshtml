<script>
(function(){
    function init(){
        if(location.pathname.toLowerCase() !==
           "/mcpurchaseinvoiceentry") return;

        const root=document.querySelector(".mc-purchase-content");
        if(!root)return;

        const headings=Array.from(
            root.querySelectorAll("h2")
        );

        const receipt= headings.find(h=>
            h.textContent.trim()==="Mal Kabul İrsaliyeleri"
        );

        const invoices= headings.find(h=>
            h.textContent.trim()==="Kaydedilmiş Faturalar"
        );

        if(!receipt || !invoices)return;

        function makeSection(heading){
            const table=heading.nextElementSibling;
            if(!table || table.tagName!=="TABLE")return null;

            const section=document.createElement("section");
            section.className="mc-compact-section";

            heading.parentNode.insertBefore(section,heading);
            section.appendChild(heading);
            section.appendChild(table);

            const tbody=table.querySelector("tbody");

            if(tbody && !tbody.querySelector("tr")){
                const tr=document.createElement("tr");
                const td=document.createElement("td");

                td.colSpan=table.querySelectorAll("thead th").length || 5;
                td.className="mc-compact-empty";
                td.textContent="Henüz kayıt bulunmuyor.";

                tr.appendChild(td);
                tbody.appendChild(tr);
            }

            return section;
        }

        const receiptSection=makeSection(receipt);
        const invoiceSection=makeSection(invoices);

        if(!receiptSection || !invoiceSection)return;

        const grid=document.createElement("div");
        grid.className="mc-compact-sections";

        receiptSection.parentNode.insertBefore(
            grid,receiptSection
        );

        grid.appendChild(receiptSection);
        grid.appendChild(invoiceSection);

        const mainTitle=Array.from(root.querySelectorAll("h1"))
            .find(h=>h.textContent.includes("Satın Alma Faturaları"));

        if(mainTitle){
            const previous=mainTitle.previousElementSibling;

            if(previous && previous.tagName==="A" &&
                previous.textContent.includes("Fatura Listesi")){
                previous.style.display="none";
            }
        }
    }

    if(document.readyState==="loading")
        document.addEventListener("DOMContentLoaded",init);
    else init();
})();
</script>
