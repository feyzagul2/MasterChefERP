@model MasterChefTakip.Models.MCPurchaseEmbeddedPageModel

@{
    ViewData["Title"] = "Satın Alma Faturaları";

    var source = Model.Html ?? "";

    var styleMatches = System.Text.RegularExpressions.Regex.Matches(
        source,
        @"(?is)<style[^>]*>.*?</style>"
    );

    var styles = new System.Text.StringBuilder();

    foreach (System.Text.RegularExpressions.Match match in styleMatches)
    {
        styles.AppendLine(match.Value);
    }

    var body = System.Text.RegularExpressions.Regex.Match(
        source,
        @"(?is)<body[^>]*>(.*?)</body>"
    );

    var inner = body.Success
        ? body.Groups[1].Value
        : source;

    inner = System.Text.RegularExpressions.Regex.Replace(
        inner,
        @"(?is)<!doctype[^>]*>|<html[^>]*>|</html>|<head[^>]*>.*?</head>|</?body[^>]*>",
        ""
    );
}

@Html.Raw(styles)

