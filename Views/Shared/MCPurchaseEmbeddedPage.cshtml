<script>
(function () {
    "use strict";

    if (location.pathname.toLowerCase() !== "/mcpurchaseinvoiceentry")
        return;

    async function loadInvoiceSummary() {
        const panel = document.querySelector(".mc-invoice-summary");
        if (!panel) return;

        const cards = Array.from(
            panel.querySelectorAll(".mc-invoice-summary-card")
        );

        if (cards.length < 4) return;

        const values = cards.map(card => card.querySelector("strong"));

        try {
            const response = await fetch("/MCPurchaseInvoiceSummary", {
                credentials: "same-origin",
                cache: "no-store",
                headers: { "Accept": "application/json" }
            });

            if (!response.ok)
                throw new Error("HTTP " + response.status);

            const data = await response.json();

            const number = new Intl.NumberFormat("tr-TR");

            values[0].textContent = number.format(data.total || 0);
            values[1].textContent = number.format(data.draft || 0);
            values[2].textContent = number.format(data.finalized || 0);

            const totals = Object.entries(data.totals || {});

            values[3].textContent = totals.length
                ? totals.map(function(entry) {
                    return new Intl.NumberFormat("tr-TR", {
                        maximumFractionDigits: 2,
                        minimumFractionDigits: 2
                    }).format(entry[1]) + " " + entry[0];
                }).join(" / ")
                : "0,00";

            values[3].style.fontSize = "17px";

            if (data.other > 0) {
                values[2].title =
                    number.format(data.other) +
                    " fatura farkli bir durum koduyla kayitli.";
            }

        } catch (error) {
            values.forEach(function(value) {
                if (value) value.textContent = "—";
            });

            console.error("Fatura ozeti yuklenemedi:", error);
        }
    }

    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", loadInvoiceSummary);
    else
        loadInvoiceSummary();
})();
</script>
