@model MasterChefTakip.ViewComponents.MCFinanceCariSummaryModel
@{
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var valid = Model.Positions.Where(x => x.Valid).ToList();
    var groups = valid.GroupBy(x => x.Currency).OrderBy(x => x.Key);
}

<section style="background:white;border:1px solid #dbe5ef;
                border-radius:14px;padding:22px;margin:20px 0">

    <h2 style="color:#183b59;margin-top:0">
        Müşteri Alacakları ve Tedarikçi Borçları
    </h2>

    <p style="color:#64748b">
        Yalnızca kaydedilmiş cari hareketlere göre hesaplanır.
        Kaydedilmemiş borçlar ve alacaklar dahil değildir.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Warning))
    {
        <p style="background:#fff7ed;padding:14px;color:#9a3412">
            @Model.Warning
        </p>
    }
    else if (Model.Positions.Count == 0)
    {
        <p style="background:#f1f5f9;padding:14px;border-radius:8px">
            Henüz cari hareket bulunmuyor.
            Gerçek borç ve alacak bakiyeleri bilinmiyor.
        </p>
    }
    else
    {
        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse">
                <thead>
                    <tr style="background:#eef3f8">
                        <th style="padding:12px;text-align:left">Para Birimi</th>
                        <th style="padding:12px;text-align:right">Müşteri Alacağı</th>
                        <th style="padding:12px;text-align:right">Tedarikçi Borcu</th>
                        <th style="padding:12px;text-align:right">Avans / Fazla Ödeme</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in groups)
                    {
                        var receivable = group.Where(x => x.IsCustomer)
                            .Sum(x => x.Outstanding);

                        var payable = group.Where(x => x.IsSupplier)
                            .Sum(x => x.Outstanding);

                        var advance = group.Sum(x => x.Advance);

                        <tr style="border-bottom:1px solid #e5e7eb">
                            <td style="padding:12px">
                                <strong>@group.Key</strong>
                            </td>
                            <td style="padding:12px;text-align:right">
                                @receivable.ToString("N2", tr)
                            </td>
                            <td style="padding:12px;text-align:right">
                                @payable.ToString("N2", tr)
                            </td>
                            <td style="padding:12px;text-align:right">
                                @advance.ToString("N2", tr)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Positions.Any(x => !x.Valid))
        {
            <p style="color:#b45309;margin-top:14px">
                Bazı cari hesaplarda kayıt veya para birimi uyuşmazlığı
                bulundu. Bu hesaplar toplamlara dahil edilmedi.
            </p>
        }
    }

    <a href="@Url.Action("Index","MCCariLedger")"
       style="display:inline-block;margin-top:16px;background:#183b59;
              color:white;padding:11px 18px;border-radius:8px;
              text-decoration:none">
        Cari Hareketleri Yönet
    </a>
</section>