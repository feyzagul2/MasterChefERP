@model MasterChefTakip.ViewComponents.MCFinanceAuditModel

<section style="background:white;border:1px solid #dbe5ef;
                border-radius:14px;padding:22px;margin:20px 0">

    <h2 style="color:#183b59;margin-top:0">
        Finans Kayıt Kontrolü
    </h2>

    <p style="color:#64748b">
        Cari tahsilat ve ödemelerin banka hareketleriyle bağlantısı,
        tutarı ve para birimi kontrol edilir.
        Bu kontrol banka ekstresi mutabakatı değildir.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Warning))
    {
        <div style="background:#fff7ed;padding:14px;
                    border-radius:8px;color:#9a3412">
            @Model.Warning
        </div>
    }
    else
    {
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin:16px 0">

            <div style="background:#eff6ff;padding:16px;border-radius:10px;
                        min-width:160px">
                <strong>Kontrol Edilen</strong><br />
                <span style="font-size:26px">@Model.CheckedCount</span>
            </div>

            <div style="background:#ecfdf5;padding:16px;border-radius:10px;
                        min-width:160px">
                <strong>Tutarlı Kayıt</strong><br />
                <span style="font-size:26px">@Model.ValidCount</span>
            </div>

            <div style="background:#fff7ed;padding:16px;border-radius:10px;
                        min-width:160px">
                <strong>Kontrol Gereken</strong><br />
                <span style="font-size:26px">@Model.IssueCount</span>
            </div>

        </div>

        @if (Model.CheckedCount == 0)
        {
            <p style="color:#64748b">
                Henüz denetlenecek tahsilat veya ödeme kaydı yok.
            </p>
        }
        else if (Model.IssueCount == 0)
        {
            <p style="background:#ecfdf5;padding:14px;border-radius:8px">
                Kayıtlı cari tahsilat ve ödemelerde kontrol edilen
                alanlar arasında uyuşmazlık bulunmadı.
            </p>
        }
        else
        {
            <p style="color:#92400e">
                Uyuşmazlık bulunan kayıtlar aşağıdadır.
                İlk 30 kayıt gösterilir.
            </p>

            <div style="overflow-x:auto">
                <table style="width:100%;border-collapse:collapse">
                    <thead>
                        <tr style="background:#f1f5f9">
                            <th style="padding:10px;text-align:left">Kayıt</th>
                            <th style="padding:10px;text-align:left">Cari Hesap</th>
                            <th style="padding:10px;text-align:left">İşlem</th>
                            <th style="padding:10px;text-align:left">Kontrol Sonucu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in Model.Issues)
                        {
                            <tr style="border-bottom:1px solid #e5e7eb">
                                <td style="padding:10px">@issue.Id</td>
                                <td style="padding:10px">@issue.Company</td>
                                <td style="padding:10px">
                                    @(issue.Type == "Collection"
                                        ? "Tahsilat"
                                        : "Ödeme")
                                </td>
                                <td style="padding:10px;color:#92400e">
                                    @issue.Message
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <a href="@Url.Action("Index","MCCariLedger")"
       style="display:inline-block;margin-top:16px;
              background:#183b59;color:white;padding:11px 18px;
              border-radius:8px;text-decoration:none">
        Cari Hareketleri Aç
    </a>
</section>