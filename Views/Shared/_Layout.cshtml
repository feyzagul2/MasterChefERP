<script>
(function () {
    "use strict";

    const titles = [
        "Ürün Kartları",
        "Palet Sayısı",
        "Palet Ürün Kayıtları",
        "Sevkiyat Kayıtları",
        "Hammadde Kartlar?",
        "Kritik Hammaddeler",
        "?retim Emirleri",
        "Lot / SKT Kayıtları",
        "Kalite Onay? Bekleyen Lot",
        "SKT Geçmiş Lot",
        "Hammadde Sayımları",
        "Sayım Onayı Bekleyen"
    ];

    function normalize(text) {
        return (text || "")
            .replace(/\s+/g, " ")
            .trim()
            .toLocaleLowerCase("tr-TR");
    }

    const titleSet = new Set(titles.map(normalize));

    function addIcon() {
        const links = document.querySelectorAll(
            "aside a[href], .sidebar a[href]"
        );

        for (const link of links) {
            const url = new URL(link.href, location.origin);

            const isReport =
                url.pathname.toLowerCase() ===
                "/operationsoverview" ||
                normalize(link.textContent) ===
                normalize("Operasyon Raporlar?");

            if (!isReport) continue;

            if (link.querySelector(".mc-ops-menu-icon")) continue;

            const slot = link.querySelector(
                ":scope > .menu-icon"
            );

            const wrapper = slot ||
                document.createElement("span");

            wrapper.classList.add("mc-ops-menu-icon");

            const svg = document.createElementNS(
                "http://www.w3.org/2000/svg",
                "svg"
            );

            svg.setAttribute("viewBox", "0 0 24 24");
            svg.setAttribute("aria-hidden", "true");

            svg.innerHTML =
                '<path d="M4 21V4M4 21h17"/>' +
                '<path d="M8 17v-5m5 5V7m5 10V4"/>';

            wrapper.replaceChildren(svg);

            if (!slot) link.prepend(wrapper);

            link.classList.add("mc-ops-menu-link");
        }
    }

    function findCard(labelElement) {
        let element = labelElement.parentElement;

        for (let depth = 0; depth < 6 && element; depth++) {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            const hasBorder =
                parseFloat(style.borderTopWidth) > 0 &&
                style.borderTopStyle !== "none";

            const hasShape =
                parseFloat(style.borderTopLeftRadius) > 4;

            const hasValue = /\d/.test(element.textContent);

            if (
                rect.width > 110 &&
                rect.height > 55 &&
                hasBorder &&
                hasShape &&
                hasValue
            ) {
                return element;
            }

            element = element.parentElement;
        }

        return null;
    }

    function compactReports() {
        if (
            !location.pathname.toLowerCase()
                .startsWith("/operationsoverview")
        ) return;

        document.body.classList.add("mc-ops-page");

        const cards = new Set();

        for (const element of document.querySelectorAll(
            "main *, .main-content *, .content *, .content-wrapper *"
        )) {
            if (element.children.length !== 0) continue;

            if (!titleSet.has(normalize(element.textContent))) {
                continue;
            }

            const card = findCard(element);

            if (card) cards.add(card);
        }

        const parents = new Map();

        for (const card of cards) {
            const parent = card.parentElement;

            if (!parent) continue;

            if (!parents.has(parent)) {
                parents.set(parent, []);
            }

            parents.get(parent).push(card);
        }

        let total = 0;

        for (const [parent, siblings] of parents) {
            if (siblings.length < 3) continue;

            parent.classList.add("mc-ops-real-grid");

            for (const card of siblings) {
                card.classList.add("mc-ops-real-card");
                total++;
            }
        }

        console.log(
            "MASTER CHEF - Kucultulen rapor kartlari:",
            total
        );
    }

    function run() {
        addIcon();
        compactReports();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", run);
    } else {
        run();
    }

    /* Menu entries may be reorganized after DOMContentLoaded. */
    const observer = new MutationObserver(function () {
        addIcon();
    });

    window.addEventListener("load", function () {
        const sidebar = document.querySelector(
            "aside.sidebar, .sidebar, aside"
        );

        if (sidebar) {
            observer.observe(sidebar, {
                childList: true,
                subtree: true
            });
        }

        run();
    }, { once: true });
})();
</script>
