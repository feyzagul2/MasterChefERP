<!-- MC_PROCUREMENT_MENU_STYLE_V2 -->
<style>
.mc-procurement-menu {
    margin: 4px 0 10px;
    padding: 0;
    width: 100%;
}

.mc-procurement-menu a {
    text-decoration: none !important;
    color: #e5e7eb !important;
    font-size: 14px;
    line-height: 1.45;
    box-sizing: border-box;
}

.mc-procurement-main {
    display: block;
    padding: 12px 14px;
    border-radius: 9px;
    font-weight: 600;
    background: transparent;
}

.mc-procurement-main:hover,
.mc-procurement-main.active {
    background: #24496c;
    color: #fff !important;
}

.mc-procurement-submenu {
    padding: 4px 0 4px 18px;
}

.mc-procurement-submenu a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    font-weight: 400;
}

.mc-procurement-submenu a:hover {
    background: #1f2937;
    color: #fff !important;
}
</style>
<!-- MC_PROCUREMENT_COLLAPSIBLE_STYLE_V1 -->
<style>
.mc-procurement-details summary {
    cursor: pointer;
    list-style: none;
}
.mc-procurement-details summary::-webkit-details-marker {
    display: none;
}
.mc-procurement-details summary::after {
    content: "▾";
    float: right;
}
.mc-procurement-details[open] summary::after {
    content: "▴";
}
.mc-procurement-details[open] .mc-procurement-main {
    background: #24496c;
    color: #fff !important;
}
</style>
