<script>
(function () {
    "use strict";

    const path = location.pathname
        .replace(/\/+$/, "")
        .toLowerCase();

    const params = new URLSearchParams(location.search);

    // The sidebar's Production module opens the real production page.
    // No iframe is used.
    if (
        path === "/modulehub" &&
        params.get("section") === "uretim"
    ) {
        location.replace("/Production");
        return;
    }

    const productionRoutes = [
        "/production",
        "/productionpackaging"
    ];

    const isProduction = productionRoutes.some(function (route) {
        return path === route || path.startsWith(route + "/");
    });

    if (!isProduction) return;

    function createIcon() {
        const svg = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "svg"
        );

        svg.setAttribute("viewBox", "0 0 24 24");
        svg.setAttribute("aria-hidden", "true");

        svg.innerHTML =
            '<path d="M3 21V10l6 4V9l6 5V5h6v16z"/>' +
            '<path d="M7 18h1m5 0h1m5 0h1"/>';

        return svg;
    }

    function findContent() {
        const back = document.querySelector("a.page-return");

        if (back) {
            const section = back.closest(
                ".content, .main-content, main, .content-wrapper"
            );

            if (section) return section;
        }

        for (const selector of [
            "main",
            ".main-content",
            ".content-wrapper",
            ".content"
        ]) {
            const element = document.querySelector(selector);

            if (element) return element;
        }

        return null;
    }

    function addTabs() {
        if (document.querySelector(".mc-production-tabs-v2")) {
            return;
        }

        const content = findContent();

        if (!content) {
            console.warn("Production content container not found.");
            return;
        }

        document.body.classList.add("mc-production-responsive");

        const tabs = document.createElement("nav");
        tabs.className = "mc-production-tabs-v2";
        tabs.setAttribute(
            "aria-label",
            "\u00dcretim y\u00f6netimi b\u00f6l\u00fcmleri"
        );

        const definitions = [
            {
                text: "\u00dcretim \u0130\u015flemleri",
                href: "/Production",
                active: path.startsWith("/production") &&
                    !path.startsWith("/productionpackaging")
            },
            {
                text: "\u00dcretim / Paketleme Ba\u011flant\u0131s\u0131",
                href: "/ProductionPackaging",
                active: path.startsWith("/productionpackaging")
            }
        ];

        for (const definition of definitions) {
            const link = document.createElement("a");

            link.href = definition.href;
            link.className = "mc-production-tab-v2";

            if (definition.active) {
                link.classList.add("active");
                link.setAttribute("aria-current", "page");
            }

            link.appendChild(createIcon());

            const label = document.createElement("span");
            label.textContent = definition.text;

            link.appendChild(label);
            tabs.appendChild(link);
        }

        // Place tabs inside the actual page content,
        // not in a nested iframe or a duplicated layout.
        const returnButton = content.querySelector("a.page-return");

        if (returnButton) {
            const header = returnButton.parentElement;

            if (header && header.parentElement) {
                header.parentElement.insertBefore(tabs, header);
            } else {
                content.prepend(tabs);
            }
        } else {
            content.prepend(tabs);
        }


    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", addTabs);
    } else {
        addTabs();
    }
})();
</script>
