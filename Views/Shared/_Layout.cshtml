    function fixCariHub() {
        try {
            const qs = new URLSearchParams(window.location.search);

            if (
                !window.location.pathname.toLowerCase().includes("/modulehub") ||
                qs.get("section") !== "cari"
            ) {
                return false;
            }

            const hub = document.getElementById("mc-module-hub");

            if (!hub) {
                return false;
            }

            const cards = Array.from(
                hub.querySelectorAll("a.mc-hub-card")
            );

            if (cards.length < 5) {
                return false;
            }

            const wanted = [
                {
                    title: "Cari Hesaplar",
                    href: "/CariAccounts"
                },
                {
                    title: "Cari Hareketleri",
                    href: "/MCCariLedger"
                },
                {
                    title: "Satın Alma",
                    href: "/Purchasing"
                },
                {
                    title: "Alış İrsaliyeleri",
                    href: "/PurchaseDispatch"
                },
                {
                    title: "Mal Kabul",
                    href: "/PurchaseGoodsReceipt"
                }
            ];

            for (let i = 0; i < 5; i++) {
                const card = cards[i];
                const title = card.querySelector(".mc-hub-card-title");

                card.href = wanted[i].href;

                if (title) {
                    title.textContent = wanted[i].title;
                }
            }

            // Fazladan Cari karti varsa gizle
            for (let i = 5; i < cards.length; i++) {
                cards[i].style.display = "none";
            }

            hub.setAttribute("data-mc-cari-fixed", "1");

            return true;
        }
        catch {
            return false;
        }
    }

    function runFix() {
        fixCariHub();

        setTimeout(fixCariHub, 50);
        setTimeout(fixCariHub, 250);
        setTimeout(fixCariHub, 750);
        setTimeout(fixCariHub, 1500);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", runFix);
    }
    else {
        runFix();
    }

    const observer = new MutationObserver(function () {
        fixCariHub();
    });

    observer.observe(
        document.documentElement,
        {
            childList: true,
            subtree: true
        }
    );
})();
</script>
