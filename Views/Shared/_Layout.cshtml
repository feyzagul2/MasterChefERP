@using MasterChefTakip.Models
@using MasterChefTakip.Services
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Genel Bakış";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var signedIn = User.Identity?.IsAuthenticated == true;
    var homeActive = controller == "Home" && action == "Index";
    var managementActive = controller is "Users" or "Roles";

    var canViewUsers = signedIn &&
        (await AuthorizationService.AuthorizeAsync(
            User, null, AppPermissions.UsersView)).Succeeded;

    var canManageRoles = signedIn &&
        (await AuthorizationService.AuthorizeAsync(
            User, null, AppPermissions.RolesManage)).Succeeded;

    var canViewProducts = signedIn &&
        (await AuthorizationService.AuthorizeAsync(
            User, null, AppPermissions.ProductsView)).Succeeded;

    // Paketleme controller'ının mevcut yetkisi korunur.
    var canUsePackaging = signedIn &&
        (await AuthorizationService.AuthorizeAsync(
            User, null, AppPermissions.PackagingManage)).Succeeded;

    var canUseShipments = OperationAuthorization.Can(
        User, AppPermissions.ShipmentsView);

    var canViewReturns = OperationAuthorization.Can(
        User, AppPermissions.ReturnsView);

    var isAdmin = signedIn && User.IsInRole(AppRoles.Admin);
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#202e4a" />

    <title>@pageTitle — MASTER CHEF Takip</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="@(signedIn ? "mc-app" : "mc-guest")">
    <a class="skip-link" href="#main-content">İçeriğe geç</a>

    <svg class="icon-sprite"
         xmlns="http://www.w3.org/2000/svg"
         aria-hidden="true">

        <symbol id="mc-grid" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="3" y="14" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
        </symbol>

        <symbol id="mc-users" viewBox="0 0 24 24">
            <circle cx="9" cy="8" r="3" />
            <path d="M3 21v-3a6 6 0 0 1 12 0v3M17 5a3 3 0 0 1 0 6M17 15a5 5 0 0 1 4 5" />
        </symbol>

        <symbol id="mc-user-plus" viewBox="0 0 24 24">
            <circle cx="9" cy="8" r="3" />
            <path d="M3 21v-3a6 6 0 0 1 12 0v3M19 7v6M16 10h6" />
        </symbol>

        <symbol id="mc-shield" viewBox="0 0 24 24">
            <path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z" />
            <path d="m8.5 12 2.5 2.5 4.5-5" />
        </symbol>

        <symbol id="mc-box" viewBox="0 0 24 24">
            <path d="m12 3 9 5-9 5-9-5 9-5ZM3 8v9l9 5 9-5V8M12 13v9M7.5 5.5l9 5" />
        </symbol>

        <symbol id="mc-package" viewBox="0 0 24 24">
            <path d="M4 8h16v13H4zM3 3h18v5H3zM10 12h4" />
        </symbol>

        <symbol id="mc-barcode" viewBox="0 0 24 24">
            <path d="M3 6V3h4M17 3h4v3M21 18v3h-4M7 21H3v-3M6 8v8M9 8v8M12 8v8M15 8v8M18 8v8" />
        </symbol>

        <symbol id="mc-download" viewBox="0 0 24 24">
            <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />
        </symbol>

        <symbol id="mc-truck" viewBox="0 0 24 24">
            <path d="M3 5h11v12H3zM14 9h4l3 4v4h-7" />
            <circle cx="7" cy="18" r="2" />
            <circle cx="17" cy="18" r="2" />
        </symbol>

        <symbol id="mc-return" viewBox="0 0 24 24">
            <path d="m7 5-4 4 4 4M3 9h11a6 6 0 0 1 0 12h-4" />
        </symbol>

        <symbol id="mc-clock" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
        </symbol>

        <symbol id="mc-chart" viewBox="0 0 24 24">
            <path d="M4 3v17h17M8 16v-4M13 16V8M18 16V5" />
        </symbol>

        <symbol id="mc-settings" viewBox="0 0 24 24">
            <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" />
            <circle cx="12" cy="12" r="5" />
            <circle cx="12" cy="12" r="2" />
        </symbol>

        <symbol id="mc-plus" viewBox="0 0 24 24">
            <path d="M12 5v14M5 12h14" />
        </symbol>

        <symbol id="mc-check" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="m8 12 3 3 5-6" />
        </symbol>

        <symbol id="mc-chevron" viewBox="0 0 24 24">
            <path d="m9 5 7 7-7 7" />
        </symbol>

        <symbol id="mc-menu" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
        </symbol>

        <symbol id="mc-close" viewBox="0 0 24 24">
            <path d="m6 6 12 12M18 6 6 18" />
        </symbol>

        <symbol id="mc-logout" viewBox="0 0 24 24">
            <path d="M9 4H4v16h5M9 12h12m-4-4 4 4-4 4" />
        </symbol>
    </svg>

    @if (signedIn)
    {
        <aside class="sidebar" id="sidebar" aria-label="Ana menü">
            <button class="menu-close"
                    id="menuClose"
                    type="button"
                    aria-label="Ana menüyü kapat">
                <svg class="ui-icon" aria-hidden="true">
                    <use href="#mc-close" />
                </svg>
            </button>

            <a class="brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                <span class="brand-mark" aria-hidden="true">MC</span>

                <span class="brand-text">
                    <strong>MASTER CHEF</strong>
                    <span>TAKİP</span>
                </span>
            </a>

            <nav class="side-nav" aria-label="Sayfalar">
                <div class="sidebar-heading">ÇALIŞMA ALANI</div>

                <a class="menu-item @(homeActive ? "is-active" : "")"
                   aria-current="@(homeActive ? "page" : null)"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="menu-icon">
                        <svg class="ui-icon" aria-hidden="true">
                            <use href="#mc-grid" />
                        </svg>
                    </span>
                    <span>Genel Bakış</span>
                </a>

                <div class="sidebar-heading">ÜRETİM VE DEPO</div>

                @if (canViewProducts)
                {
                    <a class="menu-item @(controller == "Products" ? "is-active" : "")"
                       aria-current="@(controller == "Products" ? "page" : null)"
                       asp-area=""
                       asp-controller="Products"
                       asp-action="Index">
                        <span class="menu-icon">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-box" />
                            </svg>
                        </span>
                        <span>Ürünler</span>
                    </a>
                }

                @if (canUsePackaging)
                {
                    <a class="menu-item @(controller == "Packaging" ? "is-active" : "")"
                       aria-current="@(controller == "Packaging" ? "page" : null)"
                       asp-area=""
                       asp-controller="Packaging"
                       asp-action="Index">
                        <span class="menu-icon">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-package" />
                            </svg>
                        </span>
                        <span>Paketleme</span>
                    </a>
                }

                @if (OperationAuthorization.Can(User, AppPermissions.PalletsView))
                {
                    <a class="menu-item @(controller == "Pallets" ? "is-active" : "")"
                       aria-current="@(controller == "Pallets" ? "page" : null)"
                       asp-area=""
                       asp-controller="Pallets"
                       asp-action="Index">
                        <span class="menu-icon">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-barcode" />
                            </svg>
                        </span>
                        <span>Paletler ve Barkodlar</span>
                    </a>
                }

                @if (canUseShipments)
                {
                    <a class="menu-item @(controller == "Shipments" ? "is-active" : "")"
                       aria-current="@(controller == "Shipments" ? "page" : null)"
                       asp-area=""
                       asp-controller="Shipments"
                       asp-action="Index">
                        <span class="menu-icon">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-truck" />
                            </svg>
                        </span>
                        <span>Sevkiyat</span>
                    </a>
                }

                @if (canViewReturns)
                {
                    <a class="menu-item @(controller == "Returns" ? "is-active" : "")"
                       aria-current="@(controller == "Returns" ? "page" : null)"
                       asp-area=""
                       asp-controller="Returns"
                       asp-action="Index">
                        <span class="menu-icon">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-return" />
                            </svg>
                        </span>
                        <span>İade ve Hasar</span>
                    </a>
                }

                @if (OperationAuthorization.Can(User, AppPermissions.HistoryView))
{
    <a class="menu-item @(controller == "History" ? "is-active" : "")"
       asp-area=""
       asp-controller="History"
       asp-action="Index">
        <span class="menu-icon">
            <svg class="ui-icon" aria-hidden="true">
                <use href="#mc-clock" />
            </svg>
        </span>
        <span>İşlem Geçmişi</span>
    </a>
}

                @if (OperationAuthorization.Can(User, AppPermissions.ReportsView))
                {
                    <a class="menu-item @(controller == "Reports" ? "is-active" : "")"
                       aria-current="@(controller == "Reports" ? "page" : null)"
                       asp-area=""
                       asp-controller="Reports"
                       asp-action="Index">
                        <span class="menu-icon">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-chart" />
                            </svg>
                        </span>
                        <span>Raporlar</span>
                    </a>
                }

                <div class="sidebar-heading">YÖNETİM VE SİSTEM</div>

                @if (canViewUsers || canManageRoles)
                {
                    <a class="menu-item @(managementActive ? "is-active" : "")"
                       aria-current="@(managementActive ? "page" : null)"
                       asp-area=""
                       asp-controller="Users"
                       asp-action="Index">
                        <span class="menu-icon">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-users" />
                            </svg>
                        </span>
                        <span>Kullanıcı Yönetimi</span>
                    </a>
                }

                <a class="menu-item @(controller == "Settings" ? "is-active" : "")"
                   aria-current="@(controller == "Settings" ? "page" : null)"
                   asp-area=""
                   asp-controller="Settings"
                   asp-action="Index">
                    <span class="menu-icon">
                        <svg class="ui-icon" aria-hidden="true">
                            <use href="#mc-settings" />
                        </svg>
                    </span>
                    <span>Ayarlar ve Yardım</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <svg class="ui-icon" aria-hidden="true">
                    <use href="#mc-shield" />
                </svg>
                <span>MASTER CHEF üretim ve depo</span>
            </div>
        </aside>

        <button class="menu-backdrop"
                id="menuBackdrop"
                type="button"
                aria-label="Menüyü kapat"
                hidden></button>
    }

    <div class="app-shell" id="appShell">
        <header class="topbar">
            <div class="topbar-start">
                @if (signedIn)
                {
                    <button class="menu-toggle"
                            id="menuToggle"
                            type="button"
                            aria-label="Ana menüyü aç"
                            aria-controls="sidebar"
                            aria-expanded="false">
                        <svg class="ui-icon" aria-hidden="true">
                            <use href="#mc-menu" />
                        </svg>
                    </button>
                }

                <div class="topbar-title">
                    <span>MASTER CHEF Takip</span>
                    <strong>@pageTitle</strong>
                </div>
            </div>

            <div class="account-area">
                @if (signedIn)
                {
                    <span class="account-name">@User.Identity?.Name</span>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          method="post">
                        <button class="account-button" type="submit">
                            <svg class="ui-icon" aria-hidden="true">
                                <use href="#mc-logout" />
                            </svg>
                            Çıkış
                        </button>
                    </form>
                }
                else
                {
                    <a class="account-button"
                       asp-area="Identity"
                       asp-page="/Account/Login">
                        Giriş yap
                    </a>
                }
            </div>
        </header>

        <main class="page-content" id="main-content" tabindex="-1">
            @if (signedIn)
            {
                var helpTopic = controller switch
                {
                    "Products" => "products",
                    "Pallets" => "pallets",
                    "Packaging" => "packaging",
                    "Shipments" => "shipments",
                    "Returns" => "returns",
                    "Reports" => "reports",
                    "Users" or "Roles" => "users",
                    _ => "general"
                };

                <style>
                    #common-page-actions {
                        display: grid;
                        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                        align-items: center;
                        gap: 8px;
                        width: 100%;
                        min-width: 0;
                        margin-bottom: 12px;
                    }

                    #common-page-actions .btn {
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        min-width: 0;
                        max-width: 100%;
                        min-height: 44px;
                        padding: 8px 10px;
                        font-size: 12px;
                        white-space: normal;
                        overflow-wrap: anywhere;
                        text-align: center;
                    }

                    #common-page-actions .page-return {
                        justify-self: start;
                    }

                    #common-page-actions .page-help {
                        justify-self: end;
                    }
                </style>

                <div id="common-page-actions">
                    @if (controller != "Home")
                    {
                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary page-return">
                            ← Genel Bakış'a dön
                        </a>
                    }
                    else
                    {
                        <span aria-hidden="true"></span>
                    }

                    @if (controller != "Settings")
                    {
                        <a asp-area=""
                           asp-controller="Settings"
                           asp-action="Index"
                           asp-route-topic="@helpTopic"
                           class="btn btn-outline-secondary page-help">
                            Bu sayfa nasıl kullanılır?
                        </a>
                    }
                </div>
            }

            @RenderBody()
        </main>

        <footer class="app-footer">
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/masterchef-ui.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>