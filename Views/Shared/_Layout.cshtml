<script>
(function () {
    "use strict";

    const modules = [];

    function normalize(value) {
        return (value || "")
            .toLocaleLowerCase("tr-TR")
            .replace(/\s+/g, " ")
            .trim();
    }

    function route(link) {
        try {
            return new URL(link.href, location.origin)
                .pathname.split("/")
                .filter(Boolean)[0]
                .toLowerCase();
        } catch {
            return "";
        }
    }

    function findSidebar() {
        for (const selector of [
            "aside.sidebar",
            ".sidebar",
            ".sidebar-nav",
            ".sidebar-menu",
            ".side-menu",
            "aside",
            "nav"
        ]) {
            for (const el of document.querySelectorAll(selector)) {
                if (el.querySelectorAll("a.menu-item[href]").length >= 4) {
                    return el;
                }
            }
        }
        return null;
    }

    function getScrollBox(el) {
        while (el && el !== document.body) {
            const style = getComputedStyle(el);
            if (/(auto|scroll)/.test(style.overflowY))
                return el;
            el = el.parentElement;
        }
        return document.scrollingElement;
    }

    function init() {
        const sidebar = findSidebar();
        if (!sidebar) return;

        const links = Array.from(
            sidebar.querySelectorAll("a.menu-item[href]")
        );

        const scrollBox = getScrollBox(sidebar);
        const scrollKey = "MC_MODULE_HUB_SCROLL";
        let oldScroll = 0;

        try {
            oldScroll = Number(
                sessionStorage.getItem(scrollKey) || 0
            );
        } catch {}

        const available = [];

        for (const module of modules) {
            const matches = links.filter(function (a) {
                return module.routes.includes(route(a)) ||
                    module.labels.some(
                        text => normalize(text) === normalize(a.textContent)
                    );
            });

            if (!matches.length) continue;

            const destinations = Array.from(
                new Map(
                    matches.map(function (a) {
                        return [
                            new URL(a.href, window.location.origin).pathname.toLowerCase(),
                            {
                                title: a.textContent.trim(),
                                url: a.href
                            }
                        ];
                    })
                ).values()
            );


            // MC_CARI_HUB_FIXED_V1
            if (module.key === "cari") {
                function mcFindLink(routeNames) {
                    return links.find(function (a) {
                        return routeNames.includes(route(a));
                    });
                }

                const mcCariAccounts =
                    mcFindLink(["cariaccounts"]) ||
                    mcFindLink(["currentaccounts"]);

                const mcCariLedger =
                    mcFindLink(["mccariledger"]);

                const mcPurchase =
                    mcFindLink(["purchases"]) ||
                    mcFindLink(["purchaseorders"]);

                const mcDispatch =
                    mcFindLink(["purchasedispatchnotes"]);

                const mcGoodsReceipt =
                    mcFindLink(["purchasegoodsreceipts"]) ||
                    mcFindLink(["goodsreceipts"]);

                const mcFixedDestinations = [];

                if (mcCariAccounts) {
                    mcFixedDestinations.push({
                        title: "Cari Hesaplar",
                        url: mcCariAccounts.href
                    });
                }

                if (mcCariLedger) {
                    mcFixedDestinations.push({
                        title: "Cari Hareketleri",
                        url: mcCariLedger.href
                    });
                }

                if (mcPurchase) {
                    mcFixedDestinations.push({
                        title: "Satın Alma",
                        url: mcPurchase.href
                    });
                }

                if (mcDispatch) {
                    mcFixedDestinations.push({
                        title: "Alış İrsaliyeleri",
                        url: mcDispatch.href
                    });
                }

                if (mcGoodsReceipt) {
                    mcFixedDestinations.push({
                        title: "Mal Kabul",
                        url: mcGoodsReceipt.href
                    });
                }

                destinations.splice(
                    0,
                    destinations.length,
                    ...mcFixedDestinations
                );
            }
            // MC_CARI_HUB_FIXED_V1_END

            const main = matches[0];

            main.href = "/ModuleHub?section=" + module.key;

            // Keep original icon and menu classes.
            const icon = main.querySelector("svg, i");
            const iconCopy = icon ? icon.cloneNode(true) : null;

            main.replaceChildren();


// MC_DIRECT_MODULE_ICONS_V1
const mcIconShapes = {
    cari: '<circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6M17 14a5 5 0 0 1 4 5"/>',
    hammadde: '<path d="M3 21V9l9-6 9 6v12M3 10h18M8 21v-8h8v8"/>',
    uretim: '<path d="M3 21V10l6 4V9l6 5V5h6v16zM7 18h1m5 0h1m5 0h1"/>',
    kalite: '<path d="m12 2 9 4v6c0 5-4 8-9 10-5-2-9-5-9-10V6zM8 12l3 3 5-6"/>'
};

const mcIconWrapper = document.createElement("span");
mcIconWrapper.className = "menu-icon";
mcIconWrapper.setAttribute("aria-hidden", "true");

const mcSvg = document.createElementNS(
    "http://www.w3.org/2000/svg",
    "svg"
);

mcSvg.setAttribute("viewBox", "0 0 24 24");
mcSvg.setAttribute("width", "18");
mcSvg.setAttribute("height", "18");
mcSvg.setAttribute("aria-hidden", "true");
mcSvg.setAttribute("class", "ui-icon");

mcSvg.style.setProperty("width", "18px", "important");
mcSvg.style.setProperty("height", "18px", "important");
mcSvg.style.setProperty("min-width", "18px", "important");
mcSvg.style.setProperty("max-width", "18px", "important");
mcSvg.style.setProperty("max-height", "18px", "important");
mcSvg.style.setProperty("fill", "none", "important");
mcSvg.style.setProperty("stroke", "currentColor", "important");
mcSvg.style.setProperty("stroke-width", "1.8", "important");
mcSvg.style.setProperty("stroke-linecap", "round", "important");
mcSvg.style.setProperty("stroke-linejoin", "round", "important");

mcSvg.innerHTML = mcIconShapes[module.key] || mcIconShapes.cari;

mcIconWrapper.style.setProperty("width", "20px", "important");
mcIconWrapper.style.setProperty("height", "20px", "important");
mcIconWrapper.style.setProperty("min-width", "20px", "important");
mcIconWrapper.style.setProperty("max-width", "20px", "important");
mcIconWrapper.style.setProperty("flex", "0 0 20px", "important");
mcIconWrapper.style.setProperty("display", "inline-flex", "important");
mcIconWrapper.style.setProperty("align-items", "center", "important");
mcIconWrapper.style.setProperty("justify-content", "center", "important");

mcIconWrapper.appendChild(mcSvg);
main.appendChild(mcIconWrapper);


            const title = document.createElement("span");
            title.textContent = module.title;
            main.appendChild(title);

            // Hide sub-pages from sidebar without deleting their routes.
            for (const a of matches.slice(1)) {
                a.style.display = "none";
            }

            available.push({
                module: module,
                destinations: destinations,
                main: main
            });
        }

        const hub = document.getElementById("mc-module-hub");

        if (hub) {
            const section = new URLSearchParams(
                location.search
            ).get("section");

            const selected = available.find(
                x => x.module.key === section
            );

            if (selected) {
                const heading = document.getElementById(
                    "mc-module-hub-title"
                );

                if (heading)
                    heading.textContent = selected.module.title;

                document.title =
                    selected.module.title + " - MASTER CHEF TAKIP";

                const grid = document.createElement("div");
                grid.className = "mc-hub-grid";

                // MC_CARI_FINAL_DESTINATIONS_V1                 const mcRenderDestinations =                     selected.module.key === "cari"                         ? [                             { title: "Cari Hesaplar", url: "/CariAccounts" },                             { title: "Cari Hareketleri", url: "/MCCariLedger" },                             { title: "Satın Alma", url: "/Purchasing" },                             { title: "Alış İrsaliyeleri", url: "/PurchaseDispatch" },                             { title: "Mal Kabul", url: "/PurchaseGoodsReceipt" }                           ]                         : selected.destinations;                  for (const destination of mcRenderDestinations) {
                    const card = document.createElement("a");
                    card.className = "mc-hub-card";
                    card.href = destination.url;

                    const icon = document.createElement("span");
                    icon.className = "mc-hub-card-icon";
                    icon.textContent = "\u25a3";

                    const title = document.createElement("span");
                    title.className = "mc-hub-card-title";
                    title.textContent = destination.title;

                    const arrow = document.createElement("span");
                    arrow.className = "mc-hub-card-arrow";
                    arrow.textContent = "\u203a";

                    card.append(icon, title, arrow);
                    grid.appendChild(card);
                }

                hub.replaceChildren(grid);
                selected.main.classList.add("active");
            } else {
                hub.textContent =
                    "Bu mod\u00fcl i\u00e7in eri\u015filebilir " +
                    "sayfa bulunamad\u0131.";
            }
        }

        sidebar.addEventListener("click", function (event) {
            if (!event.target.closest("a[href]")) return;

            try {
                sessionStorage.setItem(
                    scrollKey, String(scrollBox.scrollTop)
                );
            } catch {}
        }, true);

        requestAnimationFrame(function () {
            scrollBox.scrollTop = oldScroll;
            requestAnimationFrame(function () {
                scrollBox.scrollTop = oldScroll;
            });
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
})();
</script>
