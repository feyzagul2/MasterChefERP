<script>
(function () {
    "use strict";

    function setupBackLinks() {

        document.querySelectorAll("a").forEach(function (link) {

            if (link.dataset.mcBackReady === "1") return;

            const text = (link.textContent || "")
                .replace(/\s+/g, " ")
                .trim();

            const normalized = text.toLocaleLowerCase("tr-TR");

            const isBackLink =
                (
                    normalized.includes("genel bakış") &&
                    normalized.includes("dön")
                ) ||
                normalized.includes("önceki sayfaya dön") ||
                normalized.includes("geri dön") ||
                normalized.includes("geriye dön") ||
                (
                    normalized.startsWith("←") &&
                    normalized.includes("dön")
                );

            if (!isBackLink) return;

            link.dataset.mcBackReady = "1";

            link.textContent = "← Önceki Sayfaya Dön";

            link.addEventListener("click", function (event) {

                if (
                    event.ctrlKey ||
                    event.metaKey ||
                    event.shiftKey ||
                    event.altKey ||
                    event.button !== 0
                ) {
                    return;
                }

                let previousIsInternal = false;

                try {
                    if (document.referrer) {
                        const previous = new URL(document.referrer);

                        previousIsInternal =
                            previous.origin === window.location.origin &&
                            previous.href !== window.location.href;
                    }
                } catch (error) {
                    previousIsInternal = false;
                }

                if (previousIsInternal && window.history.length > 1) {
                    event.preventDefault();
                    window.history.back();
                }

                // Tarayici gecmisi yoksa mevcut baglanti
                // guvenli alternatif olarak korunur.
            });
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupBackLinks);
    } else {
        setupBackLinks();
    }

    const observer = new MutationObserver(function () {
        setupBackLinks();
    });

    observer.observe(document.documentElement, {
        childList: true,
        subtree: true
    });
})();
</script>


