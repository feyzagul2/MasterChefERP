<script>
(function () {
    "use strict";

    const locale = "tr-TR";

    document.documentElement.lang = "tr";

    function formatDate(value, withTime) {
        const date = new Date(value);

        if (Number.isNaN(date.getTime())) return null;

        return new Intl.DateTimeFormat(locale, {
            timeZone: "Europe/Istanbul",
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            ...(withTime ? {
                hour: "2-digit",
                minute: "2-digit",
                hourCycle: "h23"
            } : {})
        }).format(date);
    }

    function apply() {
        document.querySelectorAll(
            "[data-mc-date], [data-mc-datetime]"
        ).forEach(function (element) {
            const withTime = element.hasAttribute("data-mc-datetime");

            const raw = withTime
                ? element.getAttribute("data-mc-datetime")
                : element.getAttribute("data-mc-date");

            if (!raw) return;

            const result = formatDate(raw, withTime);

            if (result) element.textContent = result;
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", apply);
    } else {
        apply();
    }
})();
</script>


