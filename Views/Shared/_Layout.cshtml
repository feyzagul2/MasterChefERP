<script>
(function () {
    function arrange() {
        const heading = Array.from(document.querySelectorAll("h1,h2"))
            .find(x => x.textContent.trim() === "Genel Bakış");
        const help = Array.from(document.querySelectorAll("a,button"))
            .find(x => x.textContent.trim() === "Bu sayfa nasıl kullanılır?");
        if (!heading || !help) return;

        const date = Array.from(document.querySelectorAll("main *"))
            .find(x => x.children.length === 0 &&
                /^\d{2}\.\d{2}\.\d{4}$/.test(x.textContent.trim()));
        if (!date) return;

        help.style.transform = "none";
        help.style.position = "static";

        const row = document.createElement("div");
        row.className = "mc-dashboard-help-date";

        const dateParent = date.parentElement;
        dateParent.insertBefore(row,date);
        row.appendChild(date);
        row.appendChild(help);

        const main = heading.closest("main");
        if (main) {
            const top = main.querySelector("h1,h2");
            const container = top && top.parentElement;
            if (container) {
                container.style.marginTop = "0";
                container.style.paddingTop = "0";
            }
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded",arrange);
    } else {
        arrange();
    }
})();
</script>
