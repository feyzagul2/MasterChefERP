<script>
document.addEventListener("DOMContentLoaded", function () {

    const filterLabels = new Set([
        "Tüm Kayıtlar",
        "Yalnızca Sorunlular",
        "Tüm Faturalar",
        "Bekleyen İşlemler",
        "Kontrol Gerektiren",
        "Bağlantıları Tamamlananlar"
    ]);

    const backLabels = new Set([
        "Kontrol Merkezine Dön"
    ]);

    function cleanText(value) {
        return (value || "")
            .replace(/\s+/g, " ")
            .trim();
    }

    function normalizedUrl(value) {
        try {
            const u = new URL(value, window.location.origin);

            u.searchParams.delete("page");
            u.searchParams.delete("pageNumber");
            u.searchParams.delete("pageSize");

            const params = Array.from(u.searchParams.entries())
                .sort(function (a, b) {
                    return a[0].localeCompare(b[0]);
                });

            const query = params
                .map(function (x) {
                    return encodeURIComponent(x[0]) +
                        "=" +
                        encodeURIComponent(x[1]);
                })
                .join("&");

            return u.pathname.toLowerCase() +
                (query ? "?" + query : "");
        }
        catch {
            return "";
        }
    }

    const links = Array.from(document.querySelectorAll("a"));

    links.forEach(function (link) {

        const label = cleanText(link.textContent);

        if (filterLabels.has(label)) {
            link.classList.add("mc-filter-link");
        }

        if (backLabels.has(label)) {
            link.classList.add("mc-filter-back");
        }
    });

    const current = normalizedUrl(window.location.href);

    document.querySelectorAll("a.mc-filter-link").forEach(function (link) {

        link.classList.remove("is-active");

        if (normalizedUrl(link.href) === current) {
            link.classList.add("is-active");
        }
    });

    /* Query string yoksa "Tüm..." sekmesini aktif göster */
    const activeCount =
        document.querySelectorAll("a.mc-filter-link.is-active").length;

    if (activeCount === 0) {

        const currentUrl = new URL(window.location.href);

        if (!currentUrl.search) {

            const defaults = Array.from(
                document.querySelectorAll("a.mc-filter-link")
            );

            const defaultLink = defaults.find(function (link) {
                const t = cleanText(link.textContent);

                return t === "Tüm Kayıtlar" ||
                       t === "Tüm Faturalar";
            });

            if (defaultLink) {
                defaultLink.classList.add("is-active");
            }
        }
    }
});
</script>
<!-- MC_FILTER_RUNTIME_V2_END -->

<!-- MC_MAL_KABUL_UX_V1_START -->
<script>
document.addEventListener("DOMContentLoaded", function () {

    const heading = Array.from(
        document.querySelectorAll("h1,h2,h3")
    ).find(function(el) {
        return (el.textContent || "")
            .replace(/\s+/g, " ")
            .trim()
            .includes("Satın Alma Faturası - Mal Kabul Kontrolü");
    });

    if (!heading) return;

    function text(el) {
        return (el && el.textContent ? el.textContent : "")
            .replace(/\s+/g, " ")
            .trim();
    }

    function numberFromPage(label) {
        const bodyText = document.body.innerText || "";

        const escaped = label.replace(
            /[.*+?^${}()|[\]\\]/g,
            "\\$&"
        );

        const re = new RegExp(
            escaped + "\\s*:?\\s*(\\d+)",
            "i"
        );

        const m = bodyText.match(re);

        return m ? parseInt(m[1],10) : 0;
    }

    const checked  = numberFromPage("Kontrol Edilen Satır");
    const matched  = numberFromPage("Eşleşen");
    const shown    = numberFromPage("Görüntülenen");
    const problems = numberFromPage("Kontrol Gerektiren");

    /* ---------------------------------------------
       Eski daginik sayac blogunu bul ve gizle
       --------------------------------------------- */

    const candidates = Array.from(
        document.querySelectorAll("div,section,p")
    ).filter(function(el) {
        const t = text(el);

        return t.includes("Kontrol Edilen Satır") &&
               t.includes("Eşleşen") &&
               t.includes("Görüntülenen") &&
               t.includes("Kontrol Gerektiren");
    }).sort(function(a,b) {
        return text(a).length - text(b).length;
    });

    if (candidates.length) {
        candidates[0].style.display = "none";
    }

    /* ---------------------------------------------
       Alttaki uzun Bilgi yazisini gizle
       --------------------------------------------- */

    Array.from(
        document.querySelectorAll("p,div,span")
    ).forEach(function(el) {
        const t = text(el);

        if (
            t.startsWith(
                "Bilgi: Bu ekran yalnızca fatura satırlarına"
            )
        ) {
            el.style.display = "none";
        }
    });

    /* ---------------------------------------------
       Ozet kartlarini olustur
       --------------------------------------------- */

    const table = heading.parentElement
        ? heading.parentElement.querySelector("table")
        : null;

    const realTable = table || document.querySelector("table");

    if (realTable && !document.querySelector(".mc-audit-summary")) {

        const wrap = document.createElement("div");
        wrap.className = "mc-audit-summary";

        const data = [
            ["Kontrol Edilen", checked],
            ["Eşleşen", matched],
            ["Görüntülenen", shown],
            ["Kontrol Gerektiren", problems]
        ];

        data.forEach(function(item) {

            const card = document.createElement("div");
            card.className = "mc-audit-summary-card";

            const label = document.createElement("span");
            label.className = "mc-audit-summary-label";
            label.textContent = item[0];

            const value = document.createElement("span");
            value.className = "mc-audit-summary-value";
            value.textContent = item[1];

            card.appendChild(label);
            card.appendChild(value);
            wrap.appendChild(card);
        });

        realTable.parentNode.insertBefore(wrap,realTable);
    }

    /* ---------------------------------------------
       Bos kayit mesajini duzelt
       --------------------------------------------- */

    if (realTable) {
        Array.from(
            realTable.querySelectorAll("tbody td")
        ).forEach(function(td) {

            if (
                text(td).includes(
                    "Seçilen filtrede gösterilecek fatura satırı bulunmuyor"
                )
            ) {
                td.textContent =
                    "Bu filtrede gösterilecek kayıt bulunmuyor.";

                td.classList.add("mc-audit-empty");
            }
        });
    }

    /* ---------------------------------------------
       FILTRE LINKLERI
       --------------------------------------------- */

    const allLink = Array.from(
        document.querySelectorAll("a")
    ).find(function(a) {
        return text(a) === "Tüm Kayıtlar" ||
               text(a).startsWith("Tüm Kayıtlar (");
    });

    const problemLink = Array.from(
        document.querySelectorAll("a")
    ).find(function(a) {
        return text(a) === "Yalnızca Sorunlular" ||
               text(a).startsWith("Yalnızca Sorunlular (");
    });

    if (allLink) {
        allLink.textContent =
            "Tüm Kayıtlar (" + shown + ")";
        allLink.classList.add("mc-filter-link");
    }

    if (problemLink) {
        problemLink.textContent =
            "Yalnızca Sorunlular (" + problems + ")";
        problemLink.classList.add("mc-filter-link");
    }

    function normalizedHref(a) {
        if (!a) return "";

        try {
            const u = new URL(
                a.href,
                window.location.origin
            );

            return u.pathname.toLowerCase() +
                   u.search.toLowerCase();
        }
        catch {
            return "";
        }
    }

    /* ---------------------------------------------
       Backend linkleri farkliysa mevcut backend'i
       aynen kullan.
       --------------------------------------------- */

    const differentRoutes =
        allLink &&
        problemLink &&
        normalizedHref(allLink) !==
        normalizedHref(problemLink);

    if (differentRoutes) {

        const current =
            window.location.pathname.toLowerCase() +
            window.location.search.toLowerCase();

        if (normalizedHref(allLink) === current) {
            allLink.classList.add("mc-runtime-active");
        }

        if (normalizedHref(problemLink) === current) {
            problemLink.classList.add("mc-runtime-active");
        }
    }

    /* ---------------------------------------------
       Eger iki link ayni adrese gidiyorsa,
       mevcut tablodaki Durum sutununu kullanarak
       gercek client-side filtre yap.
       --------------------------------------------- */

    if (
        !differentRoutes &&
        realTable &&
        allLink &&
        problemLink
    ) {
        const headers = Array.from(
            realTable.querySelectorAll("thead th")
        );

        const statusIndex = headers.findIndex(
            function(th) {
                return text(th).toLowerCase() === "durum";
            }
        );

        const rows = Array.from(
            realTable.querySelectorAll("tbody tr")
        );

        function isEmptyRow(row) {
            return row.cells.length === 1 &&
                   row.cells[0].hasAttribute("colspan");
        }

        function isProblemRow(row) {

            if (statusIndex < 0) return false;

            const cell = row.cells[statusIndex];

            if (!cell) return false;

            const value = text(cell).toLocaleLowerCase("tr-TR");

            if (!value) return false;

            const good = [
                "eşleşti",
                "eslesti",
                "uygun",
                "tamam",
                "başarılı",
                "basarili",
                "sorun yok",
                "ok"
            ];

            return !good.some(function(x) {
                return value === x ||
                       value.includes(x);
            });
        }

        function setFilter(mode) {

            let visible = 0;

            rows.forEach(function(row) {

                if (isEmptyRow(row)) {
                    row.style.display = "none";
                    return;
                }

                const show =
                    mode === "all" ||
                    isProblemRow(row);

                row.style.display = show ? "" : "none";

                if (show) visible++;
            });

            allLink.classList.toggle(
                "mc-runtime-active",
                mode === "all"
            );

            problemLink.classList.toggle(
                "mc-runtime-active",
                mode === "problems"
            );

            sessionStorage.setItem(
                "mc-mal-kabul-filter",
                mode
            );

            let empty = realTable.querySelector(
                "tr.mc-runtime-empty"
            );

            if (visible === 0) {

                if (!empty) {
                    empty = document.createElement("tr");
                    empty.className = "mc-runtime-empty";

                    const td = document.createElement("td");
                    td.colSpan = Math.max(headers.length,1);
                    td.className = "mc-audit-empty";
                    td.textContent =
                        "Bu filtrede gösterilecek kayıt bulunmuyor.";

                    empty.appendChild(td);

                    realTable.querySelector("tbody")
                        .appendChild(empty);
                }

                empty.style.display = "";
            }
            else if (empty) {
                empty.style.display = "none";
            }
        }

        allLink.addEventListener(
            "click",
            function(e) {
                e.preventDefault();
                setFilter("all");
            }
        );

        problemLink.addEventListener(
            "click",
            function(e) {
                e.preventDefault();
                setFilter("problems");
            }
        );

        const saved =
            sessionStorage.getItem(
                "mc-mal-kabul-filter"
            ) || "all";

        setFilter(saved);
    }
});
</script>
