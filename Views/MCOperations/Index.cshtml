}

.mc-ops-card h3 {
    font-size: 19px;
    font-weight: 800;
    margin: 0 0 17px;
    color: #173e60;
}

.mc-ops-links {
    display: flex;
    flex-direction: column;
    gap: 9px;
}

.mc-ops-links a {
    display: block;
    text-decoration: none;
    padding: 11px 13px;
    border-radius: 8px;
    background: #edf4f9;
    color: #204969;
    font-weight: 700;
}

.mc-ops-links a:hover {
    background: #dbeaf5;
    color: #123f61;
}

.mc-ops-empty {
    font-size: 13px;
