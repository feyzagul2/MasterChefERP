<style>
.mc-ops {
    max-width: 1450px;
    margin: 0 auto;
    padding: 22px;
    color: #243247;
}

.mc-ops-header {
    background: linear-gradient(110deg, #163c58, #245d76);
    padding: 30px;
    border-radius: 16px;
    color: white;
    margin-bottom: 22px;
}

.mc-ops-header h1 {
    margin: 0 0 9px;
    font-weight: 800;
    font-size: 29px;
}

.mc-ops-header p {
    margin: 0;
    opacity: .92;
}

.mc-ops-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.mc-ops-card {
