<!-- MC_AUTO_BALANCE_START -->
<style>
.mc-ops-grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0,1fr)) !important;
    gap: 14px !important;
    align-items: start !important;
    column-count: auto !important;
}

.mc-ops-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
}

.mc-ops-column > .mc-ops-card {
    width: 100%;
    box-sizing: border-box;
    margin: 0 !important;
    height: auto !important;
    min-height: 0 !important;
}

@@media(max-width:1000px) {
    .mc-ops-grid {
        grid-template-columns: repeat(2,minmax(0,1fr)) !important;
    }
}

@@media(max-width:650px) {
    .mc-ops-grid {
        grid-template-columns: 1fr !important;
    }
}
</style>

<script>
(function () {
    function arrange() {
        const grid = document.querySelector(".mc-ops-grid");
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll(".mc-ops-card"));
        if (!cards.length) return;

        const count = window.innerWidth <= 650 ? 1 :
                      window.innerWidth <= 1000 ? 2 : 3;

        const columns = Array.from({length: count}, () => {
            const element = document.createElement("div");
            element.className = "mc-ops-column";
            return element;
        });

        grid.replaceChildren(...columns);

        const measure = document.createElement("div");
        measure.style.cssText =
            "position:absolute;visibility:hidden;pointer-events:none;" +
            "display:grid;grid-template-columns:repeat(" + count +
            ",minmax(0,1fr));gap:14px;width:" +
            grid.clientWidth + "px;";

        grid.appendChild(measure);

        const holders = columns.map(() => {
            const holder = document.createElement("div");
            holder.style.minWidth = "0";
            measure.appendChild(holder);
            return holder;
        });

        const heights = cards.map(card => {
            holders[0].appendChild(card);
            return card.getBoundingClientRect().height;
        });

        measure.remove();

        const order = cards.map((card, index) => ({
            card, height: heights[index], index
        })).sort((a,b) => b.height - a.height);

        const totals = Array(count).fill(0);

        order.forEach(item => {
            const smallest = totals.indexOf(Math.min(...totals));
            columns[smallest].appendChild(item.card);
            totals[smallest] += item.height + 14;
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", arrange);
    } else {
        arrange();
    }
})();
</script>
