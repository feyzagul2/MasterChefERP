            ← Operasyon Merkezine Dön
        </a>
    }

    <h1>Finans Kontrol Merkezi</h1>

    <p class="subtitle">
        Müşteriler, tedarikçiler, kasa ve banka hesapları tek yerde.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Warning))
    {
        <div class="warning">@Model.Warning</div>
    }

    <!-- MC_FINANCE_QUICK_START_V1 -->
@if (Model.SupplierCount == 0 ||
     Model.CustomerCount == 0 ||
     Model.BankAccountCount == 0)
{
    <section style="background:#f0f6fb;border:1px solid #d8e5f0;
                    border-radius:14px;padding:22px;margin-bottom:22px">

        <h2 style="margin:0 0 10px;font-size:21px">
            Finans Hesaplarını Hazırlayalım
        </h2>

        <p style="color:#52677a;line-height:1.6">
            Müşteri ve tedarikçi kartlarını, ardından kasa ve banka
            hesaplarını tanımlayın. Gerçek para hareketleri yalnızca
            ilgili işlem kaydedildiğinde oluşacaktır.
        </p>

        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:16px">

            @if (Model.SupplierCount == 0 || Model.CustomerCount == 0)
            {
                var createCari = Url.Action("Create", "CariAccounts");

                if (!string.IsNullOrWhiteSpace(createCari))
                {
                    <a href="@createCari"
                       style="background:#183b59;color:white;
                              text-decoration:none;padding:12px 18px;
                              border-radius:9px;font-weight:650">
                        + Yeni Müşteri / Tedarikçi
                    </a>
                }
            }

            @if (Model.BankAccountCount == 0)
            {
                var bankManagement = Url.Action("Index", "MCBankCash");

                if (!string.IsNullOrWhiteSpace(bankManagement))
                {
                    <a href="@bankManagement"
                       style="background:white;color:#183b59;
                              border:1px solid #9eb6ca;
                              text-decoration:none;padding:12px 18px;
                              border-radius:9px;font-weight:650">
                        + Kasa / Banka Hesabı Tanımla
                    </a>
                }
            }

        </div>

        <p style="font-size:13px;color:#617587;margin:16px 0 0">
            Henüz kayıt bulunmaması, borçların veya banka
            bakiyelerinin sıfır olduğu anlamına gelmez.
        </p>

    </section>
}
