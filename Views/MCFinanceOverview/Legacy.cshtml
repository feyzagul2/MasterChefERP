@{
    ViewData["Title"] = "Finans Kontrol Merkezi";

    var cariLink = Url.Action("Index", "CariAccounts");
    var bankLink = Url.Action("Index", "MCBankCash");
    var reportLink = Url.Action("Index", "MCBankCashReport");
    var operationsLink = Url.Action("Index", "MCOperations");
}

<style>
.mc-finance {
    max-width: 1400px;
    margin: 0 auto;
    padding: 22px;
    color: #193047;
}
.mc-finance * {
    box-sizing: border-box;
}
.mc-finance h1 {
    font-size: 28px;
    font-weight: 800;
    margin: 8px 0;
}
.mc-finance .subtitle {
    color: #66798a;
    margin-bottom: 24px;
}
.mc-finance .back {
    text-decoration: none;
    color: #245e90;
    font-weight: 600;
}
.mc-finance .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 16px;
}
.mc-finance .card {
    background: #fff;
    border: 1px solid #dee7ef;
    border-radius: 14px;
    padding: 22px;
    min-width: 0;
}
.mc-finance .card h2 {
    font-size: 19px;
    margin: 0 0 16px;
}
.mc-finance .number {
    font-size: 31px;
    font-weight: 800;
    color: #214c72;
}
.mc-finance .label {
    font-size: 13px;
    color: #647789;
}
.mc-finance .list {
    margin: 20px 0;
    padding: 0;
    list-style: none;
}
.mc-finance .list li {
    padding: 10px 0;
    border-bottom: 1px solid #edf1f5;
    overflow-wrap: anywhere;
}
.mc-finance .button {
    display: inline-block;
    background: #183b59;
    color: #fff;
    border-radius: 9px;
    padding: 11px 15px;
    text-decoration: none;
    font-weight: 650;
}
.mc-finance .info {
    background: #eef5fa;
    border: 1px solid #d8e7f3;
    border-radius: 12px;
    padding: 17px;
    margin-top: 20px;
    line-height: 1.6;
}
.mc-finance .warning {
    background: #fff4e4;
    padding: 13px;
    border-radius: 9px;
    margin-bottom: 18px;
}
@@media (max-width: 850px) {
    .mc-finance .grid {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="mc-finance">

