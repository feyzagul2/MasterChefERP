<!-- MC_FINANCE_PAGES_V3_START -->
<style>
.mc-fin-page-hide { display:none !important; }
.mc-fin-page-link {
    display:inline-flex;
    align-items:center;
    padding:11px 17px;
    background:#193d5b;
    color:white !important;
    border-radius:9px;
    text-decoration:none !important;
    font-weight:600;
    margin:5px;
}
.mc-fin-page-link:hover {
    background:#087c72;
}
#mc-fin-page-heading {
    padding:16px 0;
}
#mc-fin-page-heading h1 {
    margin:12px 0;
    font-size:28px;
    color:#193d5b;
}
#mc-fin-page-stage {
    width:100%;
    min-height:120px;
}
</style>

<script>
(function () {
    "use strict";

    const pages = [
        {
            slug:"AlacaklarBorclar",
            name:"Alacaklar ve Borçlar",
            ids:["mc-finans-alacak","mc-finans-borc"]
        },
        {
            slug:"VadeTakibi",
            name:"Vade Takibi",
            ids:["mc-finans-vade"]
        },
        {
            slug:"FinansDenetimi",
            name:"Finans Denetimi",
            ids:["mc-finans-denetim"]
        },
        {
            slug:"BankaKasa",
            name:"Banka ve Kasa",
            ids:["mc-finans-banka"]
        },
        {
            slug:"CariHareketler",
            name:"Cari Hareketler",
            ids:["mc-finans-cari"]
        },
        {
            slug:"VadeRaporlari",
            name:"Vade Raporları",
            ids:["mc-finans-rapor"]
        }
    ];

    function normalize(s) {
        return (s || "")
            .replace(/\s+/g," ")
            .trim()
            .toLocaleLowerCase("tr-TR");
    }

    function init() {
        const params = new URLSearchParams(location.search);
        const selected = params.get("financePage") || "";
        const pageIndex = pages.findIndex(p => p.slug === selected);

        const allLinks = Array.from(document.querySelectorAll("a"));

        const buttons = pages.map(function (page) {
            return allLinks.find(function (a) {
                return normalize(a.textContent) === normalize(page.name) &&
                    (a.getAttribute("href") || "").includes("mc-finans-");
            });
        });

        if (buttons.some(b => !b)) {
            console.warn("Finans sayfa butonlari bulunamadi.");
            return;
        }

        const toolbar = buttons[0].parentElement;

        if (!toolbar || !buttons.every(b => toolbar.contains(b))) {
            console.warn("Finans buton grubu belirlenemedi.");
            return;
        }

        const targets = pages.map(function (page, i) {
            const href = buttons[i].getAttribute("href") || "";
            const hash = href.includes("#")
                ? href.split("#").pop()
                : "";

            const candidates = [hash].concat(page.ids);

            for (const id of candidates) {
                if (!id) continue;
                const el = document.getElementById(id);
                if (el) return el;
            }

            return null;
        });

        const missing = targets
            .map((t,i) => t ? null : pages[i].name)
            .filter(Boolean);

        if (missing.length) {
            console.warn("Eksik finans bolumleri:", missing);
        }

        const root = document.querySelector("main");

        if (!root || !root.contains(toolbar)) {
            console.warn("Finans ana icerik alani bulunamadi.");
            return;
        }

        function childUnder(parent, element) {
            let node = element;
            while (node && node.parentElement !== parent) {
                node = node.parentElement;
            }
            return node;
        }

        const anchor = childUnder(root, toolbar);

        if (!anchor) return;

        const pageUrl = function (slug) {
            return "/MCFinanceOverview?financePage=" +
                encodeURIComponent(slug);
        };

        buttons.forEach(function (button,i) {
            button.href = pageUrl(pages[i].slug);
        });

        /*
          Onceki sayfa icerigi korunur.
          Mevcut HTML bolumleri yalnizca gorunumde ayrilir.
        */

        const heading = document.createElement("div");
        heading.id = "mc-fin-page-heading";

        const stage = document.createElement("div");
        stage.id = "mc-fin-page-stage";

        /*
          Ortak icerik kapsayicisini belirle.
          Her bolum icin kendi baslangic noktasini kullan.
        */

        let contentRoot = root;

        const available = targets.filter(Boolean);

        while (contentRoot !== document.body) {
            const direct = available.map(
                t => childUnder(contentRoot,t)
            );

            if (new Set(direct).size > 1) break;

            const next = direct[0];

            if (!next || next === contentRoot ||
                next === anchor || next.contains(toolbar)) {
                break;
            }

            contentRoot = next;
        }

        const directTargets = targets.map(function (target) {
            return target ? childUnder(contentRoot,target) : null;
        });

        const distinctTargets = directTargets.filter(Boolean);

        if (new Set(distinctTargets).size <
            new Set(distinctTargets.map(t => t && t.id)).size) {
            console.warn("Finans bolum sinirlari incelenmeli.");
        }

        /*
          Gizleme islemini sadece finans sayfasinin kendi
          icerik alaninda yap; sol menuye dokunma.
        */

        const contentChildren = Array.from(contentRoot.children);

        const toolbarBlock =
            contentRoot.contains(toolbar)
                ? childUnder(contentRoot,toolbar)
                : null;

        const markers = directTargets.map(function (target) {
            return target ? contentChildren.indexOf(target) : -1;
        });

        const validMarkers = markers
            .filter(n => n >= 0);

        if (!validMarkers.length) {
            console.warn("Finans bolum konumlari bulunamadi.");
            return;
        }

        /*
          Ana sayfada sadece butonlar kalir.
          Ayrinti sayfasinda secilen bolum araligi gosterilir.
          Son bolumun ardindaki vade degisiklik gecmisi de
          Vade Raporlari sayfasina dahildir.
        */

        function sectionForPosition(position) {
            let index = 0;

            for (let i=0;i<markers.length;i++) {
                if (markers[i] >= 0 && position >= markers[i]) {
                    index = i;
                }
            }

            return index;
        }

        const anchorIndex = toolbarBlock
            ? contentChildren.indexOf(toolbarBlock)
            : -1;

        contentChildren.forEach(function (node,index) {
            if (node === toolbarBlock ||
                node.contains(toolbar)) return;

            if (anchorIndex >= 0 && index <= anchorIndex) {
                node.classList.add("mc-fin-page-hide");
                return;
            }

            if (pageIndex < 0) {
                node.classList.add("mc-fin-page-hide");
                return;
            }

            const owner = sectionForPosition(index);

            node.classList.toggle(
                "mc-fin-page-hide",
                owner !== pageIndex
            );
        });

        /*
          Farkli ust kapsayicilardaki genel baslik ve kartlari
          ana sayfa gorunumunde gizle.
        */

        const rootChildren = Array.from(root.children);
        const toolbarRootChild = childUnder(root,toolbar);

        rootChildren.forEach(function (node) {
            if (node === toolbarRootChild) return;
            if (node.contains(contentRoot) || node === contentRoot) return;

            if (pageIndex < 0) {
                node.classList.add("mc-fin-page-hide");
            }
        });

        if (pageIndex >= 0) {
            heading.innerHTML =
                '<a href="/MCFinanceOverview">' +
                '← Finans Kontrol Merkezine Dön</a>' +
                '<h1></h1>';

            heading.querySelector("h1").textContent =
                pages[pageIndex].name;

            toolbar.insertAdjacentElement("afterend",heading);
        } else {
            const title = document.createElement("h2");
            title.textContent = "Finans Kontrol Merkezi";
            title.style.cssText =
                "margin:8px 0 16px;color:#193d5b";

            toolbar.insertAdjacentElement("beforebegin",title);
        }

        buttons.forEach(function (b,i) {
            b.classList.toggle(
                "mc-fin-page-link",
                true
            );

            if (pageIndex === i) {
                b.style.background = "#087c72";
            }
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded",init);
    } else {
        init();
    }
})();
</script>
<!-- MC_FINANCE_PAGES_V3_END -->