<div class="pallet-surface-heading">
    <h2>Paletin güncel içeriği</h2>
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        Bu palete henüz ürün eklenmedi.
    </div>
}
else
{
    <div class="stock-summary-list">
        @foreach (var group in Model.Items
            .GroupBy(item => item.ProductId)
            .OrderBy(group => group.First().Product.Name)
            .ThenBy(group => group.First().Product.Code))
        {
            var entries = group.OrderBy(item => item.Id).ToList();
            var product = entries[0].Product;

            var closedBoxes = entries.Sum(item => (long)item.BoxCount);
            var openUnits = entries.Sum(item => (long)item.OpenBoxUnitCount);
            var looseUnits = entries.Sum(item => (long)item.LooseUnitCount);

            var unknownBoxes = entries
                .Where(item => item.UnitsPerBox is null
                    || item.UnitsPerBox <= 0)
                .Sum(item => (long)item.BoxCount);

            var knownTotal = entries.Sum(item =>
                (item.UnitsPerBox is > 0
                    ? (long)item.BoxCount * item.UnitsPerBox.Value
                    : 0L)
                + item.OpenBoxUnitCount
                + item.LooseUnitCount);

            <div class="stock-summary-card">
                <div class="stock-summary-top">
                    <div>
                        <div class="stock-summary-name">
                            @product.Name
                        </div>
                        <span class="stock-summary-code">
                            @product.Code
                        </span>
                    </div>

                    <div class="stock-summary-total">
                        @if (unknownBoxes == 0)
                        {
                            <span>@knownTotal adet</span>
                        }
                        else
                        {
                            <span>Toplam belirsiz</span>
                        }
                    </div>
                </div>

                <div class="stock-summary-counts">
                    <span>
                        Kapalı koli: <strong>@closedBoxes</strong>
                    </span>
                    <span>
                        Açık kolide: <strong>@openUnits adet</strong>
                    </span>
                    <span>
                        Bağımsız tekli: <strong>@looseUnits adet</strong>
                    </span>

                    @if (unknownBoxes > 0)
                    {
                        <span>
                            @knownTotal bilinen adet;
                            @unknownBoxes kolinin iç adedi eksik.
                        </span>
                    }
                </div>

                <details class="stock-entry-details">
                    <summary>
                        Stok detayları (@entries.Count kayıt)
                    </summary>

                    <div class="stock-entry-list">
                        @foreach (var entry in entries)
                        {
                            var entryKnown = entry.BoxCount == 0
                                || entry.UnitsPerBox is > 0;

                            var entryTotal =
                                (entry.UnitsPerBox is > 0
                                    ? (long)entry.BoxCount
                                        * entry.UnitsPerBox.Value
                                    : 0L)
                                + entry.OpenBoxUnitCount
                                + entry.LooseUnitCount;

                            <div class="stock-entry-row">
                                <div>
                                    <strong>Stok kaydı #@entry.Id</strong>

                                    <div class="stock-entry-description">
                                        @entry.BoxCount kapalı koli
                                        · Koli içi:
                                        @(entry.UnitsPerBox?.ToString() ?? "Bilinmiyor")
                                        adet
                                        <br />
                                        Açık kolide @entry.OpenBoxUnitCount adet
                                        · Bağımsız tekli @entry.LooseUnitCount adet

                                        @if (entry.OpenBoxUnitCount > 0)
                                        {
                                            <span>
                                                · Açık koli kapasitesi:
                                                @(entry.OpenBoxCapacity?.ToString() ?? "Bilinmiyor")
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="stock-entry-total">
                                    @if (entryKnown)
                                    {
                                        <span>@entryTotal adet</span>
                                    }
                                    else
                                    {
                                        <span>Koli içi adet eksik</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </details>
            </div>
        }
    </div>
}

<p class="section-note">
    Toplam adet; kapalı kolilerdeki, açık kolideki ve bağımsız
    tekli ürünlerin toplamıdır.
</p>
        </section>
    }

