@model MasterChefTakip.ViewModels.PalletIndexViewModel
@using MasterChefTakip.Models
@using MasterChefTakip.Services

@{
    ViewData["Title"] = "Paletler ve Barkodlar";
}

<style>
    .pallet-page {
        min-width: 0;
        color: #17243b;
    }

    .pallet-page .pallet-heading,
    .pallet-page .pallet-surface-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .pallet-page .pallet-heading {
        margin-bottom: 20px;
    }

    .pallet-page h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
    }

    .pallet-page h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 650;
    }

    .pallet-page .pallet-heading p,
    .pallet-page .surface-description {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 12px;
    }

    .pallet-page .pallet-surface {
        margin-bottom: 20px;
        border: 1px solid #18365f;
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
    }

    .pallet-page .pallet-surface-heading {
        padding: 14px 18px;
        border-bottom: 1px solid #e5eaf1;
        background: #f7f9fc;
    }

    .pallet-page .record-count {
        padding: 5px 9px;
        border-radius: 6px;
        background: #eef2f7;
        color: #475569;
        font-size: 11px;
    }

    .pallet-page .btn {
        min-height: 38px;
        padding: 8px 12px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    .pallet-page .btn-dark {
        background: #111;
        border-color: #111;
        color: #fff;
    }

    .pallet-page details > summary {
        padding: 15px 18px;
        background: #f7f9fc;
        font-size: 13px;
        font-weight: 650;
        cursor: pointer;
    }

    .pallet-page details[open] > summary {
        border-bottom: 1px solid #e5eaf1;
    }

    .pallet-page .pallet-form {
        padding: 18px;
    }

    .pallet-page .form-label {
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .pallet-page .form-control,
    .pallet-page .form-select {
        box-sizing: border-box;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #d8e0eb;
        border-radius: 7px;
        background-color: #f8fafc;
        font-size: 13px;
        line-height: 22px;
    }

    .pallet-page .form-select {
        padding-right: 36px;
    }

    .pallet-page textarea.form-control {
        height: 44px;
        resize: vertical;
        overflow-y: auto;
    }

    .pallet-page .form-control:focus,
    .pallet-page .form-select:focus {
        border-color: #244c87;
        background-color: #fff;
        box-shadow: 0 0 0 3px rgba(36,76,135,.09);
    }

    .pallet-page .form-note {
        margin: 14px 0;
        color: #64748b;
        font-size: 11px;
        line-height: 1.7;
    }

    .pallet-page .text-danger {
        font-size: 12px;
    }

    .pallet-page .form-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
    }

    .pallet-page .pallet-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .pallet-page .pallet-table th {
        padding: 11px 14px;
        background: #edf1f7;
        color: #18365f;
        font-size: 11px;
        font-weight: 650;
        text-align: left;
    }

    .pallet-page .pallet-table td {
        padding: 12px 14px;
        border-top: 1px solid #e8edf4;
        color: #475569;
        font-size: 12px;
        vertical-align: middle;
        overflow-wrap: anywhere;
    }

    .pallet-page .pallet-list th:nth-child(1) { width: 34%; }
    .pallet-page .pallet-list th:nth-child(2) { width: 18%; }
    .pallet-page .pallet-list th:nth-child(3) { width: 24%; }
    .pallet-page .pallet-list th:nth-child(4) { width: 10%; }
    .pallet-page .pallet-list th:nth-child(5) { width: 14%; }

    .pallet-page .content-table th:first-child {
        width: 40%;
    }

    .pallet-page .barcode-text {
        color: #17243b;
        font-family: ui-monospace, monospace;
        font-size: 11px;
        overflow-wrap: anywhere;
    }

    .pallet-page .selected-row {
        background: #f1f5fa;
    }

    .pallet-page .product-name {
        display: block;
        color: #17243b;
        font-weight: 650;
    }

    .pallet-page .product-code {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-size: 11px;
    }

    .pallet-page .status {
        display: inline-block;
        padding: 5px 8px;
        border-radius: 6px;
        font-size: 11px;
    }

    .pallet-page .status-active {
        color: #23735b;
        background: #edf7f2;
    }

    .pallet-page .status-inactive {
        color: #64748b;
        background: #eef2f7;
    }

    .pallet-page .empty-state {
        padding: 24px 18px;
        color: #64748b;
        font-size: 13px;
        text-align: center;
    }

    .pallet-page .section-note {
        margin: 0;
        padding: 12px 18px;
        border-top: 1px solid #e5eaf1;
        background: #f7f9fc;
        color: #64748b;
        font-size: 11px;
        line-height: 1.7;
    }

    .pallet-page #pallet-content {
        scroll-margin-top: 20px;
    }

    @@media (max-width: 767px) {
        .pallet-page h1 {
            font-size: 24px;
        }

        .pallet-page .form-control,
        .pallet-page .form-select {
            font-size: 16px;
        }

        .pallet-page .btn {
            min-height: 44px;
        }

        .pallet-page .pallet-table,
        .pallet-page .pallet-table tbody,
        .pallet-page .pallet-table tr {
            display: block;
            width: 100%;
        }

        .pallet-page .pallet-table thead {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }

        .pallet-page .pallet-table tr {
            padding: 12px 18px;
        }

        .pallet-page .pallet-table tr + tr {
            border-top: 1px solid #e8edf4;
        }

        .pallet-page .pallet-table td {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            padding: 7px 0;
            border: 0;
        }

        .pallet-page .pallet-table td::before {
            content: attr(data-label);
            flex: 0 0 32%;
            color: #64748b;
        }
    }
    .pallet-page .pallet-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
}

.pallet-page .pallet-actions form {
    margin: 0;
}

.pallet-page .pallet-list th:nth-child(1) { width: 30%; }
.pallet-page .pallet-list th:nth-child(2) { width: 15%; }
.pallet-page .pallet-list th:nth-child(3) { width: 20%; }
.pallet-page .pallet-list th:nth-child(4) { width: 10%; }
.pallet-page .pallet-list th:nth-child(5) { width: 25%; }
.pallet-history > .pallet-history-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 16px;
    background: #f7f9fc;
    color: #18365f;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    font-weight: 700;
}

.pallet-history > .pallet-history-heading::-webkit-details-marker {
    display: none;
}

.pallet-history-heading > span:first-child::before {
    content: "▸";
    display: inline-block;
    margin-right: 8px;
}

.pallet-history[open] > .pallet-history-heading
    > span:first-child::before {
    content: "▾";
}

.pallet-history[open] > .pallet-history-heading {
    border-bottom: 1px solid #e5eaf1;
}

.pallet-history-body {
    min-width: 0;
}

@@media (max-width: 650px) {
    .pallet-history > .pallet-history-heading {
        padding: 12px;
        font-size: 13px;
    }

    .pallet-history .pallet-table,
    .pallet-history .pallet-table tbody,
    .pallet-history .pallet-table tr {
        display: block;
        width: 100%;
        min-width: 0 !important;
    }

    .pallet-history .pallet-table thead {
        display: none;
    }

    .pallet-history .pallet-table tr {
        padding: 8px 12px;
        border-bottom: 1px solid #dce4ef;
    }

    .pallet-history .pallet-table td {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        width: 100% !important;
        max-width: none !important;
        padding: 6px 0;
        border: 0;
        white-space: normal;
        overflow-wrap: anywhere;
        font-size: 12px;
    }

    .pallet-history .pallet-table td::before {
        content: attr(data-label);
        flex: 0 0 95px;
        color: #64748b;
        font-weight: 600;
    }

    .pallet-history .btn {
        min-height: 40px;
    }

    .stock-summary-top {
        gap: 10px;
    }

    .stock-summary-top > div:first-child {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .stock-summary-counts {
        gap: 8px 14px;
    }

    .stock-entry-details > summary {
        min-height: 44px;
    }
}
/* Palet listesi: kompakt satırlar ve düğmeler */
.pallet-table.pallet-list {
    width: 100%;
    table-layout: fixed;
}

.pallet-table.pallet-list th,
.pallet-table.pallet-list td {
    padding: 9px 10px;
    vertical-align: middle;
}

.pallet-table.pallet-list th:nth-child(1) {
    width: 29%;
}

.pallet-table.pallet-list th:nth-child(2) {
    width: 14%;
}

.pallet-table.pallet-list th:nth-child(3) {
    width: 13%;
}

.pallet-table.pallet-list th:nth-child(4) {
    width: 8%;
}

.pallet-table.pallet-list th:nth-child(5) {
    width: 36%;
}

.pallet-list .barcode-text {
    font-size: 11px;
    white-space: normal;
    overflow-wrap: anywhere;
}

.pallet-list .pallet-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
}

.pallet-list .pallet-actions form {
    margin: 0;
    padding: 0;
}

.pallet-list .pallet-actions .btn {
    min-height: 32px;
    padding: 5px 8px;
    font-size: 11px;
    line-height: 1.4;
    white-space: nowrap;
}

@@media (max-width: 767px) {
    .pallet-table.pallet-list,
    .pallet-table.pallet-list tbody {
        display: block;
        width: 100%;
        min-width: 0 !important;
    }

    .pallet-table.pallet-list thead {
        display: none;
    }

    .pallet-table.pallet-list tr {
        display: block;
        padding: 10px 12px;
        border-bottom: 1px solid #dce4ef;
    }

    .pallet-table.pallet-list td {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        width: 100% !important;
        padding: 6px 0;
        border: 0;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .pallet-table.pallet-list td::before {
        content: attr(data-label);
        flex: 0 0 65px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .pallet-table.pallet-list td:last-child {
        display: block;
        padding-top: 10px;
    }

    .pallet-table.pallet-list td:last-child::before {
        display: none;
    }

    .pallet-list .pallet-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .pallet-list .pallet-actions .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 44px;
        font-size: 12px;
        white-space: normal;
    }
}
</style>



<div class="pallet-page">
    <div class="pallet-heading">
        <div>
            <h1>Paletler ve Barkodlar</h1>
            <p>Palet kayıtları, konumları ve güncel ürün miktarları.</p>
        </div>

        @if (OperationAuthorization.Can(User, AppPermissions.PalletsManage))
        {
            <a class="btn btn-dark"
               asp-controller="Pallets"
               asp-action="Index"
               asp-route-form="new">
                + Yeni palet
            </a>
        }
    </div>

    @if (TempData["PalletSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["PalletError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
    @if (OperationAuthorization.Can(User, AppPermissions.PalletsManage))
    {
        <details class="pallet-surface" open="@Model.ShowForm">
            <summary>Yeni palet bilgileri</summary>

            <form class="pallet-form"
                  asp-controller="Pallets"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Form.Location"
                               class="form-label"></label>
                        <input asp-for="Form.Location"
                               class="form-control"
                               maxlength="100"
                               placeholder="Örneğin: Depo A / Raf 2" />
                        <span asp-validation-for="Form.Location"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Form.Notes"
                               class="form-label"></label>
                        <textarea asp-for="Form.Notes"
                                  class="form-control"
                                  rows="1"
                                  maxlength="500"></textarea>
                        <span asp-validation-for="Form.Notes"
                              class="text-danger"></span>
                    </div>
                </div>

                <p class="form-note">
                    Barkod kayıt sırasında otomatik oluşturulur.
                    Paletin içindeki ürünler değişse de barkodu aynı kalır.
                </p>

                <div class="form-actions">
                    <a class="btn btn-outline-secondary"
                       asp-action="Index">Vazgeç</a>
                    <button class="btn btn-dark" type="submit">
                        Paleti oluştur
                    </button>
                </div>
            </form>
        </details>
    }
        <section class="surface">
    <div class="surface-heading">
        <h2>Barkodla palet bul</h2>
    </div>

    <form id="palletBarcodeForm" style="padding: 16px 18px;">
        <label for="palletBarcodeInput" class="form-label">
            Palet barkodu
        </label>

        <div class="d-flex flex-wrap gap-2">
            <input id="palletBarcodeInput"
                   class="form-control"
                   type="text"
                   maxlength="50"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="Barkodu okutun veya yazın"
                   style="min-width: 0;" />

            <button id="palletBarcodeFind"
                    class="btn btn-dark"
                    type="submit"
                    style="white-space: nowrap;">
                Paleti aç
            </button>
            <button id="palletCameraOpen"
            class="btn btn-outline-secondary"
            type="button"
            style="white-space: nowrap;">
            Kamerayla okut
            </button>
        </div>

        <div style="margin-top: 8px; font-size: 12px; color: #64748b;">
            Barkod okuyucu kullanırken önce bu kutuya tıklayın.
        </div>

        <p id="palletBarcodeMessage"
           role="status"
           aria-live="polite"
           hidden
           style="margin: 10px 0 0; font-size: 13px; color: #18365f;">
        </p>
    </form>
</section>

         <details class="pallet-surface" open>
        <summary class="pallet-surface-heading"
                 style="cursor:pointer;">
            <strong id="pallet-list-heading">Palet listesi</strong>

            <span class="record-count">
                @Model.Pallets.Count kayıt
            </span>
        </summary>

        @if (Model.Pallets.Count == 0)
        {
            <div class="empty-state">Henüz palet kaydı bulunmuyor.</div>
        }
        else
        {
            <table class="pallet-table pallet-list">
                <caption class="visually-hidden">
                    Kayıtlı paletler ve içerik seçimi
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Palet</th>
                        <th scope="col">Konum</th>
                        <th scope="col">Not</th>
                        <th scope="col">Durum</th>
                        <th scope="col">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pallet in Model.Pallets)
                    {
                        <tr class="@(Model.SelectedPallet?.Id == pallet.Id ? "selected-row" : "")">
                            <td data-label="Palet">
    <div>
        <strong>Palet #@pallet.Id</strong>
        <details class="pallet-identity-details">
            <summary>Barkodu göster</summary>
            <code>@pallet.Barcode</code>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    data-pallet-copy="@pallet.Barcode">
                Kopyala
            </button>
        </details>
    </div>
</td>
                            <td data-label="Konum">
                                @(pallet.Location ?? "Belirtilmedi")
                            </td>
                            <td data-label="Not">
                                @(pallet.Notes ?? "—")
                            </td>
                            <td data-label="Durum">
                                <span class="status @(pallet.IsActive ? "status-active" : "status-inactive")">
                                    @(pallet.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td data-label="İşlem">
    <div class="pallet-actions">
        <a class="btn btn-outline-secondary"
           asp-action="Index"
           asp-route-palletId="@pallet.Id"
           asp-fragment="pallet-content">
            İçeriği aç
        </a>
        <button type="button"
        class="btn btn-outline-secondary"
        data-print-pallet="@pallet.Id">
    Etiketi yazdır
</button>

        @if (OperationAuthorization.Can(User, AppPermissions.PalletsManage))
{
<form asp-controller="Pallets"
                  asp-action="SetActive"
                  method="post">
                <input type="hidden" name="id" value="@pallet.Id" />
                <input type="hidden" name="isActive"
                       value="@(pallet.IsActive ? "false" : "true")" />

                <button class="btn btn-outline-secondary" type="submit">
                    @(pallet.IsActive ? "Pasife al" : "Aktifleştir")
                </button>
            </form>
}

@if (User.IsInRole(AppRoles.Admin))
{
<form asp-controller="Pallets"
                  asp-action="Delete"
                  method="post"
                  onsubmit="return confirm('Palet, içeriği ve tüm stok hareketleri kalıcı olarak silinecek. Devam edilsin mi?');">
                <input type="hidden" name="id" value="@pallet.Id" />

                <button class="btn btn-outline-danger" type="submit">
                    Sil
                </button>
            </form>
}
    </div>
</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        
    </section>

    @if (Model.SelectedPallet is { } selected)
    {
        <section class="pallet-surface" id="pallet-content"
                 aria-labelledby="content-heading">

            <div class="pallet-surface-heading">
                <div>
                    <h2 id="content-heading">
    Palet #@selected.Id —
    @(string.IsNullOrWhiteSpace(selected.Location)
        ? "Konum belirtilmedi"
        : selected.Location)
</h2>
                    <details class="pallet-identity-details">
    <summary>Paletin barkodu</summary>
    <code>@selected.Barcode</code>
    <button type="button"
            class="btn btn-outline-secondary btn-sm"
            data-pallet-copy="@selected.Barcode">
        Kopyala
    </button>
</details>
                </div>
                <span class="record-count">
                    @Model.Items.Select(item => item.ProductId).Distinct().Count() ürün çeşidi
                </span>
            </div>
            @if (selected.IsActive
                && !selected.IsCancelled
                && OperationAuthorization.Can(
                    User, AppPermissions.PalletsTransfer))
            {
                <div style="padding:12px 14px">
                    <partial name="_PalletTransferInline" model="Model" />
                </div>
            }

            @if (OperationAuthorization.Can(User, AppPermissions.PalletsLocation))
{
    <details open="@(ViewData.ModelState.Keys.Any(
                         key => key.StartsWith("EditForm"))
                     && !ViewData.ModelState.IsValid)">
        <summary>Konum ve not düzenle</summary>

        <form class="pallet-form"
              asp-controller="Pallets"
              asp-action="Edit"
              method="post">

            <input asp-for="EditForm.Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger" role="alert"></div>

            <span asp-validation-for="EditForm.Id"
                  class="text-danger"></span>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="EditForm.Location"
                           class="form-label"></label>

                    <input asp-for="EditForm.Location"
                           class="form-control"
                           maxlength="100" />

                    <span asp-validation-for="EditForm.Location"
                          class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="EditForm.Notes"
                           class="form-label"></label>

                    <textarea asp-for="EditForm.Notes"
                              class="form-control"
                              rows="1"
                              maxlength="500"></textarea>

                    <span asp-validation-for="EditForm.Notes"
                          class="text-danger"></span>
                </div>
            </div>

            <p class="form-note">
                Konum ve not güncellenir. Paletin barkodu aynı kalır.
            </p>

            <div class="form-actions">
                <button class="btn btn-dark" type="submit">
                    Değişiklikleri kaydet
                </button>
            </div>
        </form>
    </details>
}
            @if (OperationAuthorization.Can(User, AppPermissions.StockManage) && selected.IsActive)
            {
                <form class="pallet-form"
                      asp-controller="Pallets"
                      asp-action="AddProduct"
                      method="post">

                    <input asp-for="ProductForm.PalletId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger" role="alert"></div>
                    <span asp-validation-for="ProductForm.PalletId"
                          class="text-danger"></span>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ProductForm.ProductId"
                                   class="form-label"></label>
                            <select asp-for="ProductForm.ProductId"
