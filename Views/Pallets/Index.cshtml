@section Scripts {
    
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/JsBarcode.all.min.js"
            asp-append-version="true"></script>

    <script>
        (() => {
            const type =
                document.getElementById('ProductForm_QuantityType');
            const boxField =
                document.getElementById('box-size-field');
            const boxInput =
                document.getElementById('ProductForm_UnitsPerBox');

            if (type && boxField && boxInput) {
                function updateQuantityFields() {
                    const isBox = type.value === 'Box';
                    boxField.hidden = !isBox;
                    boxInput.disabled = !isBox;
                }

                type.addEventListener('change', updateQuantityFields);
                updateQuantityFields();
            }

            const labelUrl = '@Url.Action("LabelData", "Pallets")';
            let printing = false;

            document.querySelectorAll('[data-print-pallet]')
                .forEach(button => {
                    button.addEventListener('click', async () => {
                        if (printing) return;

                        if (typeof window.JsBarcode !== 'function') {
                            alert('Barkod dosyası yüklenemedi.');
                            return;
                        }

                        printing = true;
                        button.disabled = true;

                        let frame = null;

                        function cleanup() {
                            frame?.remove();
                            frame = null;
                            button.disabled = false;
                            printing = false;
                        }

                        try {
                            const url = new URL(
                                labelUrl,
                                window.location.origin
                            );

                            url.searchParams.set(
                                'id',
                                button.dataset.printPallet
                            );

                            const response = await fetch(url, {
                                credentials: 'same-origin',
                                cache: 'no-store',
                                headers: { 'Accept': 'application/json' }
                            });

                            if (!response.ok ||
                                !response.headers.get('content-type')
                                    ?.includes('application/json')) {
                                throw new Error(
                                    'Palet bilgileri alınamadı. '
                                    + 'Sayfayı yenileyip tekrar deneyin.'
                                );
                            }

                            const data = await response.json();

                            frame = document.createElement('iframe');
                            frame.title = 'Palet içeriği yazdırma';
                            frame.style.cssText =
                                'position:fixed;width:0;height:0;border:0;';

                            document.body.appendChild(frame);

                            const doc = frame.contentDocument;

                            doc.open();
                            doc.write(`
                                <!DOCTYPE html>
                                <html lang="tr">
                                <head>
                                    <meta charset="utf-8">
                                    <title>MASTER CHEF Palet Etiketi</title>
                                    <style>
                                        @@page {
                                            size: A4 landscape;
                                            margin: 10mm;
                                        }

                                        body {
                                            margin: 0;
                                            color: #000;
                                            background: #fff;
                                            font-family: Arial, sans-serif;
                                        }

                                        .label {
                                            width: 260mm;
                                            max-width: 100%;
                                            padding: 7mm;
                                            border: 1px solid #000;
                                            box-sizing: border-box;
                                        }

                                        .heading {
                                            display: flex;
                                            align-items: center;
                                            justify-content: space-between;
                                            gap: 20px;
                                            border-bottom: 1px solid #bbb;
                                            padding-bottom: 4mm;
                                        }

                                        h1 {
                                            margin: 0;
                                            font-size: 23px;
                                            letter-spacing: 1px;
                                        }

                                        .subtitle {
                                            margin-top: 5px;
                                            font-size: 12px;
                                        }

                                        .meta {
                                            text-align: right;
                                            font-size: 11px;
                                            line-height: 1.7;
                                        }

                                        svg {
                                            display: block;
                                            width: 100%;
                                            height: auto;
                                            margin: 4mm auto 0;
                                        }

                                        .number {
                                            text-align: center;
                                            font-family: monospace;
                                            font-size: 12px;
                                            overflow-wrap: anywhere;
                                        }

                                        h2 {
                                            margin: 6mm 0 3mm;
                                            font-size: 15px;
                                        }

                                        table {
                                            width: 100%;
                                            border-collapse: collapse;
                                            table-layout: fixed;
                                        }

                                        th, td {
                                            padding: 9px 8px;
                                            border: 1px solid #bbb;
                                            font-size: 12px;
                                            text-align: left;
                                            overflow-wrap: anywhere;
                                        }

                                        th {
                                            background: #eee;
                                        }

                                        th:first-child {
                                            width: 44%;
                                        }

                                        .code {
                                            margin-top: 4px;
                                            font-family: monospace;
                                            font-size: 10px;
                                        }

                                        tr {
                                            break-inside: avoid;
                                        }

                                        thead {
                                            display: table-header-group;
                                        }

                                        .note {
                                            margin-top: 4mm;
                                            font-size: 11px;
                                            line-height: 1.6;
                                            white-space: pre-wrap;
                                            overflow-wrap: anywhere;
                                        }

                                        .footer {
                                            margin-top: 4mm;
                                            padding-top: 3mm;
                                            border-top: 1px solid #bbb;
                                            font-size: 10px;
                                            line-height: 1.6;
                                        }
                                    </style>
                                </head>
                                <body>
                                    <div class="label">
                                        <div class="heading">
                                            <div>
                                                <h1>MASTER CHEF</h1>
                                                <div class="subtitle">
                                                    PALET VE İÇERİK ETİKETİ
                                                </div>
                                            </div>
                                            <div class="meta">
                                                <div id="labelLocation"></div>
                                                <div id="labelStatus"></div>
                                                <div id="labelDate"></div>
                                            </div>
                                        </div>

                                        <svg id="labelBarcode"></svg>
                                        <div class="number"
                                             id="labelNumber"></div>

                                        <h2>Paletin güncel içeriği</h2>

                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Ürün / kod</th>
                                                    <th>Koli sayısı</th>
                                                    <th>Koli dışı adet</th>
                                                    <th>Koli içi adet</th>
                                                </tr>
                                            </thead>
                                            <tbody id="labelItems"></tbody>
                                        </table>

                                        <div class="note"
                                             id="labelNotes" hidden></div>

                                        <div class="footer">
                                            Koli dışı adet, kolilerin içindeki
                                            ürünleri kapsamaz.
                                            Bu çıktı belirtilen tarih ve saatteki
                                            kayıtlı miktarları gösterir.
                                            İçerik değiştiğinde yeniden yazdırın.
                                        </div>
                                    </div>
                                </body>
                                </html>
                            `);
                            doc.close();

                            function setText(id, value) {
                                doc.getElementById(id).textContent = value;
                            }

                            setText('labelNumber', data.barcode);
                            setText(
                                'labelLocation',
                                'Konum: ' + (data.location || 'Belirtilmedi')
                            );
                            setText(
                                'labelStatus',
                                'Durum: ' + (data.isActive ? 'Aktif' : 'Pasif')
                            );

                            const date = new Intl.DateTimeFormat('tr-TR', {
                                timeZone: 'Europe/Istanbul',
                                dateStyle: 'short',
                                timeStyle: 'medium'
                            }).format(new Date(data.capturedAtUtc));

                            setText('labelDate', 'Kayıt zamanı: ' + date);

                            if (data.notes) {
                                setText('labelNotes', 'Not: ' + data.notes);
                                doc.getElementById('labelNotes').hidden = false;
                            }

                            const tbody =
                                doc.getElementById('labelItems');

                            function addCell(row, value) {
                                const cell = doc.createElement('td');
                                cell.textContent = String(value);
                                row.appendChild(cell);
                                return cell;
                            }

                            if (data.items.length === 0) {
                                const row = doc.createElement('tr');
                                const cell = addCell(
                                    row,
                                    'Palette kayıtlı ürün miktarı bulunmuyor.'
                                );
                                cell.colSpan = 4;
                                tbody.appendChild(row);
                            }

                            for (const item of data.items) {
                                const row = doc.createElement('tr');
                                const productCell = doc.createElement('td');

                                const name = doc.createElement('strong');
                                name.textContent = item.name;

                                const code = doc.createElement('div');
                                code.className = 'code';
                                code.textContent = item.code;

                                productCell.append(name, code);
                                row.appendChild(productCell);

                                addCell(row, item.boxCount);
                                addCell(row, item.looseUnitCount);
                                addCell(
                                    row,
                                    item.unitsPerBox ?? 'Bilinmiyor'
                                );

                                tbody.appendChild(row);
                            }

                            JsBarcode(
                                doc.getElementById('labelBarcode'),
                                data.barcode,
                                {
                                    format: 'CODE128',
                                    width: 2,
                                    height: 85,
                                    displayValue: false,
                                    margin: 24,
                                    background: '#ffffff',
                                    lineColor: '#000000'
                                }
                            );

                            frame.contentWindow.addEventListener(
                                'afterprint',
                                cleanup,
                                { once: true }
                            );

                            setTimeout(() => {
                                try {
                                    frame.contentWindow.focus();
                                    frame.contentWindow.print();
                                } catch {
                                    cleanup();
                                    alert('Yazdırma penceresi açılamadı.');
                                }
                            }, 250);
                        } catch (error) {
                            cleanup();
                            alert(
                                error.message || 'Etiket oluşturulamadı.'
                            );
                        }
                    });
                });
        })();
    </script>
    <script>
    (() => {
        const modal =
            document.getElementById('receiptCorrectionModal');

        const product =
            document.getElementById('correctionProductId');

        const unitsPerBox =
            document.getElementById('correctionUnitsPerBox');

        const boxes =
            document.getElementById('correctionBoxes');

        if (!modal || !product || !unitsPerBox || !boxes) {
            return;
        }

        let originalProductId = '';
        let originalUnitsPerBox = '';

        function updateBoxField() {
            const hasBoxes = Number(boxes.value) > 0;

            unitsPerBox.disabled = !hasBoxes;
        }

        modal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;

            if (!button) {
                return;
            }

            originalProductId = button.dataset.productId;
            originalUnitsPerBox =
                button.dataset.unitsPerBox || '';

            document.getElementById('correctionMovementId').value =
                button.dataset.movementId;

            boxes.value = button.dataset.boxCount;

            document.getElementById('correctionUnits').value =
                button.dataset.unitCount;

            document.getElementById('correctionStamp').value =
                button.dataset.stamp;

            document.getElementById('correctionProductName').textContent =
                'Mevcut giriş: ' + button.dataset.productName;

            document.getElementById('correctionReason').value = '';

            product.value = originalProductId;
            unitsPerBox.value = originalUnitsPerBox;

            updateBoxField();
        });

        product.addEventListener('change', () => {
            const selected = product.selectedOptions[0];

            unitsPerBox.value =
                product.value === originalProductId
                    ? originalUnitsPerBox
                    : selected?.dataset.defaultUnits || '';
        });

        boxes.addEventListener('input', updateBoxField);
    })();
</script>
    <script src="~/js/zxing-browser.min.js"
        asp-append-version="true"></script>

<script>
    (() => {
        const openButton = document.getElementById('palletCameraOpen');
        const modalElement = document.getElementById('palletCameraModal');
        const video = document.getElementById('palletCameraVideo');
        const message = document.getElementById('palletCameraMessage');
        const input = document.getElementById('palletBarcodeInput');
        const form = document.getElementById('palletBarcodeForm');

        if (!openButton || !modalElement || !video ||
            !message || !input || !form) {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);

        let controls = null;
        let generation = 0;
        let scanned = false;

        function stopCamera() {
            generation++;

            if (controls) {
                controls.stop();
                controls = null;
            }

            const stream = video.srcObject;

            if (stream && typeof stream.getTracks === 'function') {
                stream.getTracks().forEach(track => track.stop());
            }

            video.srcObject = null;
        }

        openButton.addEventListener('click', () => {
            if (!window.ZXingBrowser) {
                alert('Barkod okuma dosyası yüklenemedi.');
                return;
            }

            if (!navigator.mediaDevices?.getUserMedia) {
                alert('Kamera kullanımı için HTTPS bağlantısı ve desteklenen bir tarayıcı gerekiyor.');
                return;
            }

            modal.show();
        });

        modalElement.addEventListener('shown.bs.modal', async () => {
            stopCamera();

            const currentGeneration = generation;
            scanned = false;
            message.textContent = 'Kamera açılıyor...';

            try {
                const reader =
                    new ZXingBrowser.BrowserMultiFormatReader();

                const startedControls =
                    await reader.decodeFromConstraints(
                        {
                            audio: false,
                            video: {
                                facingMode: { ideal: 'environment' }
                            }
                        },
                        video,
                        (result, error, scanControls) => {
                            if (currentGeneration !== generation) {
                                scanControls.stop();
                                return;
                            }

                            if (!result || scanned) {
                                return;
                            }

                            scanned = true;
                            input.value = result.getText();

                            scanControls.stop();
                            modal.hide();

                            // Mevcut barkod arama formunu çalıştırır.
                            form.requestSubmit();
                        }
                    );

                if (currentGeneration !== generation || scanned) {
                    startedControls.stop();
                    return;
                }

                controls = startedControls;
                message.textContent =
                    'Barkodu kameranın karşısına getirin. ' +
                    'Barkodun tamamı net görünsün.';
            }
            catch (error) {
                if (currentGeneration !== generation) {
                    return;
                }

                stopCamera();

                message.textContent =
                    error?.name === 'NotAllowedError'
                        ? 'Kamera izni verilmedi. Tarayıcı ayarlarından izin verin.'
                        : error?.name === 'NotFoundError'
                            ? 'Bu cihazda kamera bulunamadı.'
                            : 'Kamera açılamadı. Kamera izinlerini kontrol edip tekrar deneyin.';
            }
        });

        modalElement.addEventListener('hide.bs.modal', stopCamera);

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                stopCamera();
                modal.hide();
            }
        });

        window.addEventListener('pagehide', stopCamera);
    })();
</script>
