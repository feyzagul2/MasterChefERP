<!-- MC_EMBED_FRAME_ACTIVATION_2026 -->
@if (string.Equals(
    Context.Request.Query["section"].ToString(),
    "hammadde",
    StringComparison.OrdinalIgnoreCase))
{
    <script>
    (function () {
        "use strict";

        function init() {
            const frame = document.getElementById(
                "mc-hammadde-content-frame"
            );

            const nav = document.querySelector(".mc-final-nav");

            if (!frame || !nav) return;

            function embeddedUrl(url) {
                const parsed = new URL(url, window.location.origin);
                parsed.searchParams.set("mcEmbed", "1");
                return parsed.pathname + parsed.search;
            }

            nav.querySelectorAll("a[href]").forEach(function (link) {
                const original = link.getAttribute("href");

                if (!original) return;

                const url = new URL(original, window.location.origin);

                if (url.origin !== window.location.origin) return;

                link.setAttribute(
                    "href",
                    embeddedUrl(original)
                );

                link.addEventListener("click", function (event) {
                    event.preventDefault();

                    nav.querySelectorAll("a").forEach(function (a) {
                        a.classList.remove("active");
                    });

                    link.classList.add("active");

                    frame.src = embeddedUrl(original);
                });
            });

            const current = new URL(
                frame.getAttribute("src") || "/MaterialCatalog",
                window.location.origin
            );

            if (!current.searchParams.has("mcEmbed")) {
                frame.src = embeddedUrl(current.pathname + current.search);
            }
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
    </script>
}


<!-- MC_RAW_STABLE_TRANSITIONS_2026 -->
@if (string.Equals(
    Context.Request.Query["section"].ToString(),
    "hammadde",
    StringComparison.OrdinalIgnoreCase))
{
    <style>
        #mc-hammadde-content {
            position: relative;
            width: 100%;
            min-width: 0;
            overflow: hidden;
        }

        #mc-hammadde-content-frame {
            display: block;
            width: 100%;
            border: 0;
            min-height: 500px;
            transition: opacity .12s ease;
        }

        #mc-hammadde-content-frame.mc-loading {
            opacity: 0;
            pointer-events: none;
        }

        .mc-raw-loading {
            display: none;
            padding: 28px;
            text-align: center;
            color: #64748b;
            font-size: 14px;
        }

        #mc-hammadde-content.mc-is-loading .mc-raw-loading {
            display: block;
        }

        @@media (max-width: 700px) {
            #mc-hammadde-content-frame {
                min-height: 420px;
            }
        }
    </style>

    <script>
    (function () {
        "use strict";

        function initialize() {
            const frame = document.getElementById(
                "mc-hammadde-content-frame"
            );

            const holder = document.getElementById(
                "mc-hammadde-content"
            );

            const nav = document.querySelector(".mc-final-nav");

            if (!frame || !holder || !nav) return;

            if (window.mcRawStableTransitions) return;
            window.mcRawStableTransitions = true;

            const loading = document.createElement("div");

            loading.className = "mc-raw-loading";
            loading.textContent = "Bölüm yükleniyor...";

            holder.prepend(loading);

            let sequence = 0;

            function beginLoad() {
                sequence++;

                holder.classList.add("mc-is-loading");
                frame.classList.add("mc-loading");

                frame.style.height = "500px";
            }

            function endLoad() {
                const current = sequence;

                window.requestAnimationFrame(function () {
                    if (current !== sequence) return;

                    try {
                        const doc = frame.contentDocument;

                        if (doc && doc.body) {
                            const height = Math.max(
                                doc.body.scrollHeight,
                                doc.documentElement.scrollHeight,
                                500
                            );

                            frame.style.height = (height + 20) + "px";
                        }
                    } catch (error) {
                        frame.style.height = "800px";
                    }

                    holder.classList.remove("mc-is-loading");
                    frame.classList.remove("mc-loading");
                });
            }

            // Bu dinleyici hem ilk a?ölçüta hem de
            // sekmeler aras?nda geçişte çalışır.
            frame.addEventListener("load", endLoad);

            // Önceki kodlar?n tıklama olaylar?yla çakışmamak i?in
            // navigasyona tek bir yeni olay dinleyicisi ekliyoruz.
            nav.addEventListener("click", function (event) {
                const link = event.target.closest("a[href]");

                if (!link || !nav.contains(link)) return;

                beginLoad();
            }, true);

            // İlk a?ölçüta içerik y?klenmesini bekle.
            if (frame.contentDocument?.readyState === "complete") {
                endLoad();
            } else {
                beginLoad();
            }
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded", initialize
            );
        } else {
            initialize();
        }
    })();
    </script>
}


