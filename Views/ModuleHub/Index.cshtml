        }

        #mc-hammadde-content {
            margin: 12px auto 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            overflow: hidden !important;
            background: transparent !important;
            border: 0 !important;
            border-radius: 0 !important;
        }

        #mc-hammadde-content-frame {
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            height: 900px;
            margin: 0 !important;
            padding: 0 !important;
            border: 0 !important;
            overflow: hidden !important;
            background: transparent;
        }

        @@media (max-width: 768px) {
            .mc-final-nav {
                display: grid;
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
                gap: 7px;
                padding: 7px;
            }

            .mc-final-nav a {
                width: 100%;
                min-width: 0;
                padding: 11px 8px;
                font-size: 12px;
                line-height: 1.4;
            }
        }

        @@media (max-width: 420px) {
            .mc-final-nav {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>

    <script>
    (function () {
        "use strict";

        function initialize() {
            const frame = document.getElementById(
                "mc-hammadde-content-frame"
            );

            const nav = document.querySelector(".mc-final-nav");

            if (!frame || !nav) return;

            // Eski tekrarlanan kartlar gÜrünmesin.
            const hub = document.getElementById("mc-module-hub");
            if (hub) hub.style.display = "none";

            // ?nceden oluşturulmuş sekme dinleyicileriyle
            // çakışmamak i?in yeni olaylar eklemiyoruz.

            function arrangeFrame() {
                try {
                    const doc = frame.contentDocument;

                    if (!doc || !doc.body) return;

                    if (!doc.getElementById("mc-inner-fix")) {
                        const style = doc.createElement("style");
                        style.id = "mc-inner-fix";

                        style.textContent = `
                            html {
                                overflow-x: hidden !important;
                                width: 100% !important;
                            }

                            body {
                                margin: 0 !important;
                                padding: 0 !important;
                                width: 100% !important;
                                min-width: 0 !important;
                                overflow-x: hidden !important;
                                background: transparent !important;
                            }

                            aside,
                            header,
                            .sidebar,
                            .app-sidebar,
                            .topbar,
                            .app-header,
                            .navbar-sidebar {
                                display: none !important;
                            }

                            main,
                            .main-content,
                            .content-wrapper,
                            .app-main,
                            .page-content,
                            .container,
                            .container-fluid {
                                box-sizing: border-box !important;
                                margin-left: auto !important;
                                margin-right: auto !important;
                                width: 100% !important;
                                max-width: 100% !important;
                                min-width: 0 !important;
                            }

                            main,
                            .main-content,
                            .content-wrapper {
                                padding: 12px !important;
                            }

                            input,
                            select,
                            textarea {
                                max-width: 100%;
                                box-sizing: border-box;
                            }

                            table {
                                max-width: 100%;
                            }

                            .table-responsive {
                                overflow-x: auto;
                            }

                            @@media (max-width: 768px) {
                                main,
                                .main-content,
                                .content-wrapper {
                                    padding: 8px !important;
                                }

                                input,
                                select,
                                textarea {
                                    font-size: 16px !important;
                                }
                            }
                        `.replaceAll("@@media", "@@media");

                        doc.head.appendChild(style);
                    }

                    // ?? sayfanın kendi üst geri dönüş alan?n? gizle.
                    const links = doc.querySelectorAll("a");

                    links.forEach(function (link) {
                        const label = (link.textContent || "")
                            .trim()
                            .toLocaleLowerCase("tr-TR");

                        if (label.includes("Önceki sayfaya d?n")) {
                            const wrapper = link.closest("div");
                            if (wrapper) wrapper.style.display = "none";
                        }
                    });

                    function resize() {
                        const height = Math.max(
                            doc.body.scrollHeight,
                            doc.documentElement.scrollHeight,
                            500
                        );

                        frame.style.height = height + 16 + "px";
                    }

                    resize();

                    if (frame._mcResizeObserver) {
                        frame._mcResizeObserver.disconnect();
                    }

                    if (typeof ResizeObserver !== "undefined") {
                        const observer = new ResizeObserver(resize);

                        observer.observe(doc.body);

                        frame._mcResizeObserver = observer;
                    }

                    setTimeout(resize, 350);
                    setTimeout(resize, 1200);

                } catch (error) {
                    console.warn("Icerik duzeni:", error);
                }
            }

            frame.addEventListener("load", arrangeFrame);
            arrangeFrame();
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded", initialize
            );
        } else {
            initialize();
        }
    })();
    </script>
}

