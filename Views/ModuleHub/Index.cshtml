<!-- MC_HAMMADDE_DEFAULT_CATALOG_2026 -->
<div id="mc-hammadde-content"
     style="margin-top:16px;background:#fff;
            border:1px solid #dbe3ec;
            border-radius:12px;overflow:hidden">

    <iframe id="mc-hammadde-content-frame"
            src="/MaterialCatalog"
            title="Hammadde Yönetimi - Malzeme Kataloğu"
            style="width:100%;height:900px;
                   border:0;display:block">
    </iframe>
</div>

<script>
(function () {
    function init() {
        const nav = document.querySelector(".mc-final-nav");
        const frame = document.getElementById(
            "mc-hammadde-content-frame"
        );

        if (!nav || !frame) return;

        nav.querySelectorAll("a[href]").forEach(function (link) {
            link.addEventListener("click", function (event) {
                event.preventDefault();

                nav.querySelectorAll("a").forEach(function (item) {
                    item.classList.remove("active");
                });

                link.classList.add("active");

                frame.src = link.getAttribute("href");
            });
        });

        frame.addEventListener("load", function () {
            try {
                const doc = frame.contentDocument;
                if (!doc) return;

                if (doc.getElementById("mc-embedded-style")) return;

                const style = doc.createElement("style");
                style.id = "mc-embedded-style";

                style.textContent = `
                    aside,
                    header,
                    .sidebar,
                    .topbar,
                    .app-sidebar,
                    .app-header {
                        display: none !important;
                    }

                    main,
                    .main-content,
                    .content-wrapper {
                        margin-left: 0 !important;
                        width: 100% !important;
                        max-width: 100% !important;
                    }
                `;

                doc.head.appendChild(style);
            } catch (e) {
                console.warn("Icerik gorunumu:", e);
            }
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
})();
</script>


    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const hub = document.getElementById("mc-module-hub");

        if (hub) hub.style.display = "none";

        const nav = document.querySelector(".mc-final-nav");

        if (!nav) return;

        const main = nav.closest("main") || nav.parentElement;

        if (!main) return;

        // Eski özel kartlar? yalnızca bu sayfada gizle.
        main.querySelectorAll("a[href]").forEach(function (a) {
            if (nav.contains(a)) return;

            const href = a.getAttribute("href") || "";

            if ([
                "/MaterialCatalog",
                "/MaterialStockMapping",
                "/RawMaterials",
                "/MCRawWarehouses",
                "/PurchaseGoodsReceipt",
                "/Purchasing"
            ].some(x => href.startsWith(x))) {
                const parent = a.closest("div");
                if (parent && !parent.contains(nav)) {
                    parent.style.display = "none";
                }
            }
        });
    });
    </script>
}


