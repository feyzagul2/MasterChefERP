@using MasterChefTakip.Services
@model MasterChefTakip.Models.Shipment
@using MasterChefTakip.Models

<div style="padding:12px 16px;border-top:1px solid #e5eaf1;">
    @if (OperationAuthorization.Can(User, AppPermissions.ShipmentsLabels) && Model.Status is (ShipmentStatus.Confirmed or ShipmentStatus.Shipped or ShipmentStatus.Delivered))
    {
        <a asp-controller="Shipments"
           asp-action="Label"
           asp-route-id="@Model.Id"
           target="_blank"
           rel="noopener"
           class="btn btn-outline-secondary">
            Etiket yazdır / PDF
        </a>
    }

    @if (OperationAuthorization.Can(User, AppPermissions.ShipmentsCancel) && Model.Status is (ShipmentStatus.Draft or ShipmentStatus.Confirmed))
    {
        <details style="margin-top:10px;">
            <summary style="cursor:pointer;font-size:12px;color:#9f3030;">
                Sevkiyatı iptal et
            </summary>

            <form asp-controller="Shipments"
                  asp-action="Cancel"
                  method="post"
                  style="margin-top:10px;"
                  onsubmit="return confirm('Sevkiyat iptal edilsin mi? Onay sırasında düşülen stok geri eklenecek.');">

                <input type="hidden" name="id" value="@Model.Id" />

                <input type="hidden"
                       name="concurrencyStamp"
                       value="@Model.ConcurrencyStamp" />

                <label for="shipmentCancellationReason-@Model.Id"
                       class="form-label">
                    İptal gerekçesi
                </label>

                <textarea id="shipmentCancellationReason-@Model.Id"
                          name="reason"
                          class="form-control"
                          rows="2"
                          required
                          maxlength="500"></textarea>

                <button type="submit"
                        class="btn btn-outline-danger"
                        style="margin-top:8px;">
                    İptal et
                </button>
            </form>
        </details>
    }
    else if (Model.Status == ShipmentStatus.Cancelled)
    {
        <strong style="font-size:12px;color:#9f3030;">
            Sevkiyat iptal edildi
        </strong>

        <div style="margin-top:5px;font-size:12px;">
            @Model.CancellationReason
        </div>

        @if (Model.CancelledAtUtc is DateTime cancelledAt)
        {
            <div style="margin-top:4px;font-size:11px;color:#64748b;">
                @cancelledAt.AddHours(3).ToString("dd.MM.yyyy HH:mm")
            </div>
        }
    }
    else if (Model.Status is ShipmentStatus.Shipped
        or ShipmentStatus.Delivered)
    {
        <p class="description" style="margin-top:10px;">
            Gönderilmiş ürünlerin geri dönüşünü İade ve Hasar
            bölümünden kaydedin.
        </p>
    }
</div>