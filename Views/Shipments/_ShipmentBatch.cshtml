@inject MasterChefTakip.Data.ApplicationDbContext SalesDb
@using MasterChefTakip.Models
@using MasterChefTakip.Services
@using MasterChefTakip.ViewModels
@model ShipmentIndexViewModel

@{
    var shipment = Model.SelectedShipment!;

    // SHIPMENT_SALES_SELECTOR_V1
    var saleStockIds = Model.StockOptions
        .Select(option => option.Id)
        .ToHashSet();

    var saleStockProducts = SalesDb.PalletItems
        .AsEnumerable()
        .Where(item => saleStockIds.Contains(item.Id))
        .ToDictionary(item => item.Id, item => item.ProductId);

    var saleOptions = SalesDb.ProductSalesOptions
        .Where(option => option.IsActive)
        .Select(option => new
        {
            option.ProductId,
            option.SalesCode,
            option.SalesName,
            option.UnitsPerSale
        })
        .ToList();

    var saleOptionsByStock = saleStockProducts.ToDictionary(
        item => item.Key.ToString(),
        item => saleOptions
            .Where(option => option.ProductId == item.Value)
            .OrderBy(option => option.UnitsPerSale)
            .ThenBy(option => option.SalesCode)
            .Select(option => new
            {
                code = option.SalesCode,
                name = option.SalesName,
                units = option.UnitsPerSale
            })
            .ToList()
    );

    var saleOptionsJson =
        System.Text.Json.JsonSerializer.Serialize(saleOptionsByStock);
    var submitted = ViewData["BatchForm"] as BatchShipmentViewModel;
    var rows = submitted?.Rows?.ToList()
        ?? new List<BatchShipmentRowViewModel>();

    var canPrepare =
        shipment.Status == ShipmentStatus.Draft
        && OperationAuthorization.Can(
            User, AppPermissions.ShipmentsManage);

    var legacyUnknown = false;

    if (submitted is null)
    {
        if (shipment.Packages.Count > 0)
        {
            foreach (var package in shipment.Packages.OrderBy(p => p.Number))
            {
                foreach (var item in package.Items.OrderBy(i => i.Id))
                {
                    rows.Add(new BatchShipmentRowViewModel
                    {
                        PackageNumber = package.Number,
                        PalletItemId = item.ShipmentItem.PalletItemId,
                        QuantityType = item.QuantityType,
                        Quantity = item.Quantity,
                        SalesCode = item.SalesCode
                    });
                }
            }
        }
        else
        {
            foreach (var item in shipment.Items.OrderBy(i => i.Id))
            {
                var known = item.BoxCount == 0
                    || item.UnitsPerBox is > 0;

                var amount = (long)item.BoxCount
                    * (item.UnitsPerBox ?? 0)
                    + item.LooseUnitCount;

                if (!known || amount > int.MaxValue)
                    legacyUnknown = true;

                rows.Add(new BatchShipmentRowViewModel
                {
                    PackageNumber = 1,
                    PalletItemId = item.PalletItemId,
                    QuantityType = 1,
                    Quantity = known && amount <= int.MaxValue
                        ? (int)amount
                        : 0
                });
            }
        }
    }

    if (rows.Count == 0)
    {
        rows.Add(new BatchShipmentRowViewModel
        {
            PackageNumber = 1,
            QuantityType = 1,
            Quantity = 0
        });
    }

    string FieldValue(string key, object? fallback)
    {
        if (ViewData.ModelState.TryGetValue(key, out var entry))
            return entry.AttemptedValue ?? "";

        return fallback?.ToString() ?? "";
    }

    string StatusText(ShipmentStatus status) => status switch
    {
        ShipmentStatus.Draft => "Taslak · Stok değişmedi",
        ShipmentStatus.Confirmed => "Gönderime hazır",
        ShipmentStatus.Shipped => "Gönderildi",
        ShipmentStatus.Delivered => "Teslim edildi",
        ShipmentStatus.Cancelled => "İptal edildi",
        _ => "Bilinmeyen durum"
    };

    var totalKnown = shipment.Items.All(
        i => i.BoxCount == 0 || i.UnitsPerBox is > 0);

    var total = shipment.Items.Sum(
        i => (long)i.BoxCount * (i.UnitsPerBox ?? 0)
            + i.LooseUnitCount);
}

